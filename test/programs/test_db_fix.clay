"Starting test..." println
db = Db open("test_fix.db")
db exec("CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY, name TEXT, price REAL)")

escaped = db escape("O'Brien")
("Escaped: " + escaped) println

db exec("INSERT INTO items (name, price) VALUES ('Gadget', 24.50)")
db exec("INSERT INTO items (name, price) VALUES ('Widget', 9.99)")

rows = db query("SELECT * FROM items")
rows each { |row|
  name = row get("name")
  price = row get("price")
  (name + ": " + price toString()) println
}

db close()

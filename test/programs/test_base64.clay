// stdlib/base64: encoding, decoding, binary data and bad input
import("stdlib/test")
import("stdlib/base64")

Test describe("encode") {
    Test it("encodes text") {
        Test assertEqual(Base64 encode("Hello, World!"), "SGVsbG8sIFdvcmxkIQ==")
        Test assertEqual(Base64 encode(""), "")
    }
    Test it("pads short groups") {
        Test assertEqual(Base64 encode("A"), "QQ==")
        Test assertEqual(Base64 encode("AB"), "QUI=")
        Test assertEqual(Base64 encode("ABC"), "QUJD")
    }
    Test it("encodes bytes above 127") {
        Test assertEqual(Base64 encode(String fromBytes([0, 200, 255])), "AMj/")
        Test assertEqual(Base64 encode("héllo"), "aMOpbGxv")
        Test assertEqual(Base64 encode(String fromBytes([251, 255])), "+/8=")
    }
    Test it("raises on a non-string") {
        Test assertRaises({ Base64 encode(42) })
    }
}

Test describe("decode") {
    Test it("decodes text") {
        Test assertEqual(Base64 decode("SGVsbG8sIFdvcmxkIQ=="), "Hello, World!")
        Test assertEqual(Base64 decode(""), "")
        Test assertEqual(Base64 decode("QQ=="), "A")
        Test assertEqual(Base64 decode("QUI="), "AB")
    }
    Test it("decodes bytes above 127") {
        Test assertEqual(Base64 decode("AMj/") bytes, [0, 200, 255])
        Test assertEqual(Base64 decode("+/8=") bytes, [251, 255])
    }
    Test it("accepts missing padding and line breaks") {
        Test assertEqual(Base64 decode("QQ"), "A")
        Test assertEqual(Base64 decode("QUI"), "AB")
        Test assertEqual(Base64 decode("SGVs\r\nbG8=\n"), "Hello")
    }
    Test it("raises on bad input") {
        e = Test assertRaises({ Base64 decode("SGV$sbG8=") })
        Test assertTrue(e message contains("invalid character $"))
        Test assertRaises({ Base64 decode("Q") })
        Test assertRaises({ Base64 decode("QQ=A") })
        Test assertRaises({ Base64 decode("QQ=") })
        Test assertRaises({ Base64 decode("QQ===") })
    }
}

Test describe("round trip") {
    Test it("keeps every byte value") {
        all = []
        i = 0
        { i < 256 } whileTrue { all push(i); i = i + 1 }
        data = String fromBytes(all)
        Test assertEqual(Base64 decode(Base64 encode(data)), data)
    }
    Test it("keeps every length mod 3") {
        ["", "a", "ab", "abc", "abcd", "Clay is awesome"] each { |s|
            Test assertEqual(Base64 decode(Base64 encode(s)), s)
        }
    }
}

Test run

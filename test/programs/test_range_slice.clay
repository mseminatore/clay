// Test Range-based slicing

// String slicing
// failures are counted, and the program exits 1 if there were any
TestFails = Object clone {
    count = 0
    fail(msg) {
        msg println
        self count = self count + 1
    }
}

s = "hello world"
r1 = s at(0..5)
(r1 == "hello") ifTrue { "PASS: string slice 0..5" println } ifFalse { TestFails fail(("FAIL: string slice got " + r1)) }

r2 = s at(6..11)
(r2 == "world") ifTrue { "PASS: string slice 6..11" println } ifFalse { TestFails fail(("FAIL: string slice got " + r2)) }

// Empty range
r3 = s at(3..3)
(r3 == "") ifTrue { "PASS: empty range" println } ifFalse { TestFails fail(("FAIL: empty range got " + r3)) }

// Array slicing
arr = [10, 20, 30, 40, 50]
sub = arr at(1..4)
(sub length == 3) ifTrue { "PASS: array slice length" println } ifFalse { TestFails fail(("FAIL: array slice length " + sub length toString)) }
(sub at(0) == 20) ifTrue { "PASS: array slice first" println } ifFalse { TestFails fail("FAIL: array slice first") }
(sub at(2) == 40) ifTrue { "PASS: array slice last" println } ifFalse { TestFails fail("FAIL: array slice last") }

// Single element still works
(s at(0) == "h") ifTrue { "PASS: string single at" println } ifFalse { TestFails fail(("FAIL: string single at got " + s at(0))) }
(arr at(0) == 10) ifTrue { "PASS: array single at" println } ifFalse { TestFails fail("FAIL: array single at") }

"All range slice tests completed" println

(TestFails count > 0) ifTrue {
    ((TestFails count) toString + " failed") println
    System exit(1)
}

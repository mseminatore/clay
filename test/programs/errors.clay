// Test error handling: try/catch/raise

// Test 1: Catch a raised string error
result = try {
  raise("something went wrong")
  "should not reach here"
} catch { |e|
  e message()
}
result println()

// Test 2: Catch division by zero
result2 = try {
  10 / 0
} catch { |e|
  "caught: " + e message()
}
result2 println()

// Test 3: Try block succeeds (no error)
result3 = try {
  42
} catch { |e|
  0
}
result3 println()

// Test 4: Nested try/catch
result4 = try {
  try {
    raise("inner error")
  } catch { |e|
    "inner caught"
  }
} catch { |e|
  "outer caught"
}
result4 println()

// Test 5: Custom doesNotUnderstand
Proxy = Object clone {
  doesNotUnderstand(name, args) {
    "forwarded: " + name
  }
}

p = Proxy clone()
p banana() println()

// Test 6: Catch method-not-found
result6 = try {
  42 banana()
} catch { |e|
  "caught: " + e type()
}
result6 println()

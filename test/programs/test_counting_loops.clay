// Inlined counting loops (`n times { |i| ... }`, `(a..b) each { |i| ... }`): the
// VM counts in the parameter itself unless the body assigns it or a block made in
// the body captures it; both ways must behave as the messages do.
fails = 0
check = { |name, ok| ok ifFalse { ("FAIL " + name) println; fails = fails + 1 } }
run = {
    // captured: each block keeps its own i
    bs = []
    3 times { |i| bs push({ i }) }
    check value("captured", (bs map { |b| b value }) == [0, 1, 2])
    // assigned in the body: the loop still runs 0..3, the body sees its change
    seen = []
    4 times { |i| i = i * 10; seen push(i) }
    check value("assigned", seen == [0, 10, 20, 30])
    // assigned in a nested block
    seen2 = []
    3 times { |i| [1] each { |x| i = i + x }; seen2 push(i) }
    check value("assigned in a block", seen2 == [1, 2, 3])
    // plain: reads only
    s = 0
    5 times { |i| s = s + i }
    check value("plain", s == 10)
    // nested with the same name
    pairs = []
    2 times { |i| 2 times { |i| pairs push(i) }; pairs push(i * 10) }
    check value("nested same name", pairs == [0, 1, 0, 0, 1, 10])
    // continue and break
    c = []
    6 times { |i| (i % 2 == 0) ifTrue { continue }; (i > 4) ifTrue { break }; c push(i) }
    check value("continue and break", c == [1, 3])
    // values
    v = 3 times { |i| i * 2 }
    check value("times value", v == 4)
    r = (2..4) each { |i| i }
    check value("each value", (r toArray) == [2, 3, 4])
    // range
    t = []
    (3..6) each { |i| t push(i) }
    check value("range", t == [3, 4, 5, 6])
    // empty
    z = 0
    0 times { |i| z = 1 }
    (5..4) each { |i| z = 2 }
    check value("empty", z == 0)
    // the parameter isn't visible after the loop
    i = 99
    3 times { |i| nil }
    check value("outer i untouched", i == 99)
    // captured by a block run inside (ifTrue is inline, not a capture)
    hits = []
    4 times { |i| (i > 1) ifTrue { hits push(i) } }
    check value("inline ifTrue", hits == [2, 3])
    // a later closure over the counter in a deeper inline loop
    deep = []
    2 times { |i| { |x| x } value(0); 2 times { |j| deep push({ i + j }) } }
    check value("deep capture", (deep map { |b| b value }) == [0, 1, 1, 2])
}
Thing = Object clone {
    i = 7
    sum() {
        s = 0
        3 times { |i| s = s + i }
        s + i
    }
}
run value
check value("method with a slot named like the parameter", Thing sum == 10)
(fails == 0) ifTrue { "all ok" println } ifFalse { System exit(1) }

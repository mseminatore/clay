// Test operator overloading in clone body
Vec = Object clone {
  x = 0
  y = 0
  init(vx, vy) {
    self x = vx
    self y = vy
  }
  +(other) {
    Vec new(x + other x, y + other y)
  }
  -(other) {
    Vec new(x - other x, y - other y)
  }
  *(scalar) {
    Vec new(x * scalar, y * scalar)
  }
  ==(other) {
    x == other x && y == other y
  }
  !=(other) {
    (self == other) not
  }
  toString() {
    "Vec(" + x toString + ", " + y toString + ")"
  }
}

v1 = Vec new(1, 2)
v2 = Vec new(3, 4)

v3 = v1 + v2
(v3 x == 4) ifTrue { "PASS: + x" println } ifFalse { "FAIL: + x got " + v3 x toString println }
(v3 y == 6) ifTrue { "PASS: + y" println } ifFalse { "FAIL: + y got " + v3 y toString println }

v4 = v2 - v1
(v4 x == 2) ifTrue { "PASS: - x" println } ifFalse { "FAIL: - x" println }
(v4 y == 2) ifTrue { "PASS: - y" println } ifFalse { "FAIL: - y" println }

v5 = v1 * 3
(v5 x == 3) ifTrue { "PASS: * x" println } ifFalse { "FAIL: * x" println }
(v5 y == 6) ifTrue { "PASS: * y" println } ifFalse { "FAIL: * y" println }

(v1 == Vec new(1, 2)) ifTrue { "PASS: ==" println } ifFalse { "FAIL: ==" println }
(v1 != v2) ifTrue { "PASS: !=" println } ifFalse { "FAIL: !=" println }

v3 toString println

// Test setMethod for external operator definition
Money = Object clone {
  amount = 0
  init(a) { self amount = a }
  toString() { "$" + amount toString }
}

Money setMethod("+", { |other| Money new(self amount + other amount) })
Money setMethod("==", { |other| self amount == other amount })

m1 = Money new(10)
m2 = Money new(20)
m3 = m1 + m2
(m3 amount == 30) ifTrue { "PASS: setMethod +" println } ifFalse { "FAIL: setMethod +" println }
(Money new(5) == Money new(5)) ifTrue { "PASS: setMethod ==" println } ifFalse { "FAIL: setMethod ==" println }

// Test comparison operators
Temp = Object clone {
  deg = 0
  init(d) { self deg = d }
  <(other) { deg < other deg }
  >(other) { deg > other deg }
  <=(other) { deg <= other deg }
  >=(other) { deg >= other deg }
}

t1 = Temp new(20)
t2 = Temp new(30)
(t1 < t2) ifTrue { "PASS: <" println } ifFalse { "FAIL: <" println }
(t2 > t1) ifTrue { "PASS: >" println } ifFalse { "FAIL: >" println }
(t1 <= t2) ifTrue { "PASS: <=" println } ifFalse { "FAIL: <=" println }
(t2 >= t1) ifTrue { "PASS: >=" println } ifFalse { "FAIL: >=" println }


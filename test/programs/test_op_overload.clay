// Test operator overloading in clone body
// failures are counted, and the program exits 1 if there were any
TestFails = Object clone {
    count = 0
    fail(msg) {
        msg println
        self count = self count + 1
    }
}

Vec = Object clone {
  x = 0
  y = 0
  init(vx, vy) {
    self x = vx
    self y = vy
  }
  +(other) {
    Vec new(x + other x, y + other y)
  }
  -(other) {
    Vec new(x - other x, y - other y)
  }
  *(scalar) {
    Vec new(x * scalar, y * scalar)
  }
  ==(other) {
    x == other x && y == other y
  }
  !=(other) {
    (self == other) not
  }
  toString() {
    "Vec(" + x toString + ", " + y toString + ")"
  }
}

v1 = Vec new(1, 2)
v2 = Vec new(3, 4)

v3 = v1 + v2
(v3 x == 4) ifTrue { "PASS: + x" println } ifFalse { TestFails fail("FAIL: + x got " + v3 x toString) }
(v3 y == 6) ifTrue { "PASS: + y" println } ifFalse { TestFails fail("FAIL: + y got " + v3 y toString) }

v4 = v2 - v1
(v4 x == 2) ifTrue { "PASS: - x" println } ifFalse { TestFails fail("FAIL: - x") }
(v4 y == 2) ifTrue { "PASS: - y" println } ifFalse { TestFails fail("FAIL: - y") }

v5 = v1 * 3
(v5 x == 3) ifTrue { "PASS: * x" println } ifFalse { TestFails fail("FAIL: * x") }
(v5 y == 6) ifTrue { "PASS: * y" println } ifFalse { TestFails fail("FAIL: * y") }

(v1 == Vec new(1, 2)) ifTrue { "PASS: ==" println } ifFalse { TestFails fail("FAIL: ==") }
(v1 != v2) ifTrue { "PASS: !=" println } ifFalse { TestFails fail("FAIL: !=") }

v3 toString println

// Test setMethod for external operator definition
Money = Object clone {
  amount = 0
  init(a) { self amount = a }
  toString() { "$" + amount toString }
}

Money setMethod("+", { |other| Money new(self amount + other amount) })
Money setMethod("==", { |other| self amount == other amount })

m1 = Money new(10)
m2 = Money new(20)
m3 = m1 + m2
(m3 amount == 30) ifTrue { "PASS: setMethod +" println } ifFalse { TestFails fail("FAIL: setMethod +") }
(Money new(5) == Money new(5)) ifTrue { "PASS: setMethod ==" println } ifFalse { TestFails fail("FAIL: setMethod ==") }

// Test comparison operators
Temp = Object clone {
  deg = 0
  init(d) { self deg = d }
  <(other) { deg < other deg }
  >(other) { deg > other deg }
  <=(other) { deg <= other deg }
  >=(other) { deg >= other deg }
}

t1 = Temp new(20)
t2 = Temp new(30)
(t1 < t2) ifTrue { "PASS: <" println } ifFalse { TestFails fail("FAIL: <") }
(t2 > t1) ifTrue { "PASS: >" println } ifFalse { TestFails fail("FAIL: >") }
(t1 <= t2) ifTrue { "PASS: <=" println } ifFalse { TestFails fail("FAIL: <=") }
(t2 >= t1) ifTrue { "PASS: >=" println } ifFalse { TestFails fail("FAIL: >=") }

// Unary minus sends negated (numbers do it directly)
Amt = Object clone {
    n = 0
    init(v) { n = v }
    negated() { Amt new(0 - n) }
    +(o) { Amt new(n + o n) }
    *(k) { Amt new(n * k) }
    ==(o) { (o hasSlot("n")) && n == o n }
}
NegIn = Object clone { neg(v) { -v } }
check = { |ok, what| ok ifTrue { ("PASS: " + what) println } ifFalse { TestFails fail("FAIL: " + what) } }
check value(((-Amt new(5)) n) == -5, "-x sends negated")
check value(((NegIn neg(Amt new(2))) n) == -2, "-x sends negated in a method")
check value(((-(Amt new(1) + Amt new(2))) n) == -3, "-(expr) sends negated")
k = 7
f = 2.5
check value((-k == 0 - 7) && (-f == 0 - 2.5) && (NegIn neg(k) == -7), "-x on numbers")
minInt = -2305843009213693951 - 1
check value((try { -minInt; false } catch { |e| e type == "OverflowError" }), "-x overflow raises")
check value((try { NegIn neg(minInt); false } catch { |e| e type == "OverflowError" }), "-x overflow raises in a method")
check value((try { -"s"; false } catch { |e| e type == "MethodNotFound" }), "-x without negated")

// Unary operators bind looser than messages (but a minus before a number
// literal is part of it)
Yes = Object clone { t() { true } }
check value((-5 abs) == 5, "-5 abs is (-5) abs")
check value((-k abs) == -7, "-k abs is -(k abs)")
check value((!Yes t) == false, "!x m is !(x m)")
check value(((-Amt new(5)) n) == -5 && (-Amt new(5) n) == -5, "-X new(5) negates the new one")
check value((- -k) == 7 && (3 - -k) == 10, "nested and after binary minus")

// Compound assignment uses the operator method
a = Amt new(3)
a += Amt new(4)
a *= 2
check value(a n == 14, "+= and *= use + and *")

// != follows a user-defined == (and x != nil stays identity)
check value((Amt new(1) != Amt new(1)) == false, "!= is the opposite of ==")
check value(Amt new(1) != Amt new(2), "!= true when == is false")
check value(Amt new(1) != nil, "!= nil")
Plain = Object clone
pl = Plain clone
check value((pl != pl) == false && (pl != Plain clone), "!= without == is identity")

(TestFails count > 0) ifTrue {
    ((TestFails count) toString + " failed") println
    System exit(1)
}

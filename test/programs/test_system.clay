// test_system.clay — Test System OS methods
passed = 0
failed = 0

assert = { |cond, msg|
    cond ifTrue {
        passed = passed + 1
    }
    (cond == false) ifTrue {
        ("FAIL: " + msg) println()
        failed = failed + 1
    }
}

// Test 1: platform returns a known string
p = System platform()
valid = (p == "windows") ifTrue { true } ifFalse {
    (p == "macos") ifTrue { true } ifFalse {
        (p == "linux") ifTrue { true } ifFalse { false }
    }
}
assert value(valid, "platform should be windows, macos, or linux")

// Test 2: env returns nil for non-existent var
assert value(System env("__CLAY_NONEXISTENT_VAR__") == nil, "env returns nil for missing var")

// Test 3: env returns string for existing var (PATH always exists)
path = System env("PATH")
assert value(path != nil, "env(PATH) should not be nil")

// Test 4: clock returns a number
t = System clock()
assert value(t >= 0, "clock should be >= 0")

// Test 5: clock advances
t1 = System clock()
// Do some work
x = 0
i = 0
{ (i < 10000) } whileTrue {
    x = x + i
    i = i + 1
}
t2 = System clock()
assert value(t2 >= t1, "clock should not go backwards")

// Test 5b: clock measures elapsed time, not CPU time: it advances while waiting
(System platform != "windows") ifTrue {
    t1 = System clock()
    System run("sleep 0.2")
    waited = System clock() - t1
    assert value(waited >= 150, "clock should advance while the program waits")
    assert value(waited < 5000, "clock should be in milliseconds")
}

// Test 6: args returns an array of the arguments after the script name
// (none here)
a = System args()
assert value(a type == "Array", "args is an array")
assert value(a size() == 0, "args excludes the script itself")

// Test 8: allocCount and deallocCount still work
assert value(System allocCount() > 0, "allocCount > 0")
assert value(System deallocCount() >= 0, "deallocCount >= 0")

// liveObjects / memory / version
l0 = System liveObjects
held = [[1], [2], [3]]
assert value(System liveObjects >= l0 + 4, "liveObjects counts new objects")
held = nil
assert value(System liveObjects <= l0, "liveObjects drops when they are freed")
assert value(System liveObjects == System allocCount - System deallocCount, "liveObjects = alloc - dealloc")
mem = System memory
assert value(mem == nil || mem > 1000000, "memory is the resident size in bytes")
assert value(System version startsWith("0."), "version")

(passed toString() + " passed, " + failed toString() + " failed") println()
(failed > 0) ifTrue { System exit(1) }

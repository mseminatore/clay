/* Test super keyword for prototype chain method dispatch */

Test = Object clone({
    _p = 0
    _f = 0
    eq(a, b) {
        (a == b) ifTrue({ self _p = self _p + 1 })
        (!(a == b)) ifTrue({ self _f = self _f + 1; ("FAIL: " + a toString() + " != " + b toString()) println() })
        self
    }
    done() {
        total = self _p + self _f
        (total toString() + " tests, " + self _p toString() + " passed, " + self _f toString() + " failed") println()
        (self _f > 0) ifTrue({ raise("test failures") })
        self
    }
})

/* Basic super call */
Animal = Object clone({
    speak() { "animal" }
})

Dog = Animal clone({
    speak() { super speak() + "-dog" }
})

Test eq(Dog speak(), "animal-dog")

/* Super with arguments */
Base = Object clone({
    add(a, b) { a + b }
})

Child = Base clone({
    add(a, b) { super add(a, b) * 2 }
})

Test eq(Child add(3, 4), 14)

/* Multi-level super chain */
A = Object clone({
    greet() { "A" }
})

B = A clone({
    greet() { super greet() + "B" }
})

C = B clone({
    greet() { super greet() + "C" }
})

Test eq(C greet(), "ABC")

/* Super on cloned instance */
Proto = Object clone({
    value() { 10 }
})

Sub = Proto clone({
    value() { super value() + 5 }
})

inst = Sub clone()
Test eq(inst value(), 15)

/* Super unary (no args) */
Base2 = Object clone({
    name() { "base" }
})

Derived = Base2 clone({
    name() { super name() }
})

Test eq(Derived name(), "base")

Test done()

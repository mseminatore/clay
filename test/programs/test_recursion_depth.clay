// The program runs on a big stack (CLAY_STACK_MB, default 256), so recursion
// well beyond what the system's default stack allows works: methods, blocks
// and the sends between them.

failures = 0
check = { |name, ok|
    ok ifFalse {
        Console print("FAIL: " + name + "\n")
        failures = failures + 1
    }
}

Rec = Object clone {
    down(n) {
        (n == 0) ifTrue { return 0 }
        self down(n - 1)
    }
    sum(n) {
        (n == 0) ifTrue { return 0 }
        n + (self sum(n - 1))
    }
}

check value("a method 5000 deep", (Rec down(5000)) == 0)
check value("a sum 5000 deep", (Rec sum(5000)) == 12502500)

f = nil
f = { |n| (n == 0) ifTrue { 0 } ifFalse { 1 + (f value(n - 1)) } }
check value("a block 1500 deep", (f value(1500)) == 1500)

(failures > 0) ifTrue {
    Console print(failures toString + " checks failed\n")
    System exit(1)
}
Console print("recursion depth tests passed\n")

// test_control.clay — Control flow and boolean logic

Test = Object clone {
    _p = 0
    _f = 0
    eq(a, b) {
        (a == b) ifTrue { self _p = self _p + 1 }
        (!(a == b)) ifTrue { self _f = self _f + 1; ("FAIL: " + a toString() + " != " + b toString()) println() }
        self
    }
    ok(v) {
        (v == true) ifTrue { self _p = self _p + 1 }
        (!(v == true)) ifTrue { self _f = self _f + 1; "FAIL: expected true" println() }
        self
    }
    no(v) {
        (v == false) ifTrue { self _p = self _p + 1 }
        (!(v == false)) ifTrue { self _f = self _f + 1; "FAIL: expected false" println() }
        self
    }
    done() {
        total = self _p + self _f
        (total toString() + " tests, " + self _p toString() + " passed, " + self _f toString() + " failed") println()
        (self _f > 0) ifTrue { raise("test failures") }
        self
    }
}

// Boolean logic
Test ok(true && true)
Test no(true && false)
Test no(false && true)
Test ok(true || false)
Test ok(false || true)
Test no(false || false)
Test no(!true)
Test ok(!false)

// ifTrue / ifFalse
r1 = 0; true ifTrue { r1 = 42 }; Test eq(r1, 42)
r2 = 0; false ifTrue { r2 = 42 }; Test eq(r2, 0)
r3 = 0; false ifFalse { r3 = 99 }; Test eq(r3, 99)
r4 = 0; true ifFalse { r4 = 99 }; Test eq(r4, 0)

// Chained: the second block runs only when the first didn't, and the chain's
// value is the block that ran
Test eq((1 < 2) ifTrue { "a" } ifFalse { "b" }, "a")
Test eq((1 > 2) ifTrue { "a" } ifFalse { "b" }, "b")
Test eq((1 > 2) ifFalse { "a" } ifTrue { "b" }, "a")
Test eq((1 < 2) ifFalse { "a" } ifTrue { "b" }, "b")
Test eq((1 < 2) ifTrue { nil } ifFalse { "b" }, nil)
ran = 0
(1 < 2) ifTrue { 1 } ifFalse { ran = 1 }
Test eq(ran, 0)
// a condition result keeps the block's value, and so does a clone of it
held = (1 < 2) ifTrue { "x" + "y" }
Test eq(held ifFalse { "no" }, "xy")
Test eq(held clone ifFalse { "no" }, "xy")
Test eq((1 > 2) ifTrue { "x" } clone ifFalse { "no" }, "no")

// Inside methods and blocks a block literal's ifTrue/ifFalse runs in place;
// it must behave exactly like the message
Inl = Object clone {
    tag = "slot"
    chain(x) { (x > 1) ifTrue { "big" } ifFalse { "small" } }
    chainVar(b) { b ifFalse { "f" } ifTrue { "t" } }
    lone(x) { (x > 1) ifTrue { "big" } }
    loneVar(c) { c ifTrue { "ran" } }
    early(x) { (x > 1) ifTrue { return "early" }; "late" }
    earlyEach(xs) { xs each { |v| (v == 2) ifTrue { return v * 10 } }; 0 }
    // a variable first assigned in the block is the block's own, nil each time
    fresh() {
        (true) ifTrue { a = 1 }
        (true) ifTrue { r = b; b = 2; r } ifFalse { "skipped" }
    }
    // blocks made inside capture that run's variable
    closures(xs) {
        fs = []
        xs each { |v| (v > 0) ifTrue { w = v * 2; fs push({ w }) } }
        fs map { |f| f value }
    }
    // an existing slot is still assigned in place (implicit-slot fallback)
    setTag(v) { (v != nil) ifTrue { tag = v }; tag }
    nested(x) {
        (x > 0) ifTrue {
            (x > 10) ifTrue { "huge" } ifFalse { (x > 5) ifTrue { "big" } ifFalse { "small" } }
        } ifFalse { "neg" }
    }
    empty(x) { (x > 0) ifTrue { } ifFalse { 1 } }
    countBig(xs) { n = 0; xs each { |v| (v > 2) ifTrue { continue }; n = n + 1 }; n }
    notBool(x) { x ifTrue { 1 } }
    // return from inside an expression, and from nested blocks' own variables
    deep(x) { r = "a" + ((x > 0) ifTrue { return "out" } ifFalse { "b" }); r }
    deepEach(xs) {
        xs each { |v| (v > 0) ifTrue { a = v; (a > 1) ifTrue { b = [a * 2]; return b at(0) } } }
        0
    }
}
Test eq(Inl chain(5), "big")
Test eq(Inl chain(0), "small")
Test eq(Inl chainVar(true), "t")
Test eq(Inl chainVar(false), "f")
Test eq(Inl lone(5) ifFalse { "no" }, "big")
Test eq(Inl lone(0) ifFalse { "no" }, "no")
Test eq(Inl loneVar(true) ifFalse { "no" }, "ran")
Test eq(Inl loneVar((1 < 2) ifTrue { "held" }), "held")
Test eq(Inl loneVar((1 > 2) ifTrue { "held" }), "ran")
Test eq(Inl early(5), "early")
Test eq(Inl early(0), "late")
Test eq(Inl earlyEach([1, 2, 3]), 20)
Test eq(Inl fresh, nil)
Test eq(Inl closures([1, 0, 3]) toString, "[2, 6]")
ti = Inl clone
Test eq(ti setTag("new"), "new")
Test eq(ti setTag(nil), "new")
Test eq(Inl nested(20), "huge")
Test eq(Inl nested(7), "big")
Test eq(Inl nested(1), "small")
Test eq(Inl nested(-1), "neg")
Test eq(Inl empty(1), nil)
Test eq(Inl countBig([1, 5, 2, 9]), 2)
Test eq(Inl deep(1), "out")
Test eq(Inl deep(0), "ab")
Test eq(Inl deepEach([0, 1, 3]), 6)
Test eq(Inl deepEach([0, 1]), 0)
msg = try { Inl notBool(5); "none" } catch { |e| e message }
Test ok(msg startsWith("integer does not understand 'ifTrue'"))
msg = try { Inl notBool(nil); "none" } catch { |e| e message }
Test ok(msg startsWith("message 'ifTrue' sent to nil"))

// outside methods `return` ends just the ifTrue/ifFalse block it is in
rf = { |x| (x > 1) ifTrue { return "big" }; "small" }
Test eq(rf value(5), "small")
rg = { |x| (x > 1) ifTrue { return "big"; "no" } ifFalse { "x" } }
Test eq(rg value(5), "big")
rh = { |x| ((x > 1) ifTrue { (x > 3) ifTrue { return "inner" }; "outer" }) ifFalse { "z" } }
Test eq(rh value(5), "outer")
ri = { |x| r = "<" + ((x > 1) ifTrue { a = [x]; return a at(0) } ifFalse { "s" }) + ">"; r }
Test eq(ri value(5), "<5>")
Test eq(ri value(0), "<s>")

// whileTrue
i = 0; s = 0
{ i < 5 } whileTrue { s = s + i; i = i + 1 }
Test eq(s, 10)
Test eq(i, 5)

// Inside methods and blocks a loop of block literals runs in place too;
// it must behave exactly like the message
Wl = Object clone {
    sum(n) { i = 0; s = 0; { i < n } whileTrue { s = s + i; i = i + 1 }; s }
    // the loop's value is its body's last value
    last(n) { i = 0; { i < n } whileTrue { i = i + 1; i * 10 } }
    brk(xs) { i = 0; { true } whileTrue { (xs at(i) == 0) ifTrue { break }; i = i + 1 }; i }
    cont(n) {
        i = 0; c = 0
        { i < n } whileTrue { i = i + 1; (i % 2 == 0) ifTrue { continue }; c = c + 1 }
        c
    }
    ret(n) { i = 0; { true } whileTrue { i = i + 1; (i == n) ifTrue { return i * 100 } } }
    wf(n) { i = 0; { i >= n } whileFalse { i = i + 1 }; i }
    tailBrk(n) { i = 0; { true } whileTrue { i = i + 1; (i == n) ifTrue { break } ifFalse { i } } }
    lastBrk(n) { i = 0; r = { true } whileTrue { i = i + 1; (i > n) ifTrue { break }; i * 2 }; r }
    loneTail(n) { i = 0; { true } whileTrue { i = i + 1; (i > n) ifTrue { break } } }
    // the body's variables are its own, nil each time it runs
    fresh() { i = 0; out = []; { i < 3 } whileTrue { r = v; v = i; out push(r); i = i + 1 }; out }
    closures() { i = 0; fs = []; { i < 3 } whileTrue { j = i; fs push({ j }); i = i + 1 }; fs map { |f| f value } }
    nested() {
        i = 0; t = 0
        { i < 3 } whileTrue {
            j = 0
            { j < 3 } whileTrue { (j == 1) ifTrue { j = j + 1; continue }; t = t + 1; j = j + 1 }
            i = i + 1
        }
        t
    }
    // a break in a try block or another loop's block is raised as before
    tryBrk() { i = 0; { true } whileTrue { i = i + 1; try { (i == 3) ifTrue { break } } catch { |e| nil } }; i }
    eachBrk() { i = 0; { i < 2 } whileTrue { [1, 2, 3] each { |x| (x == 2) ifTrue { break } }; i = i + 1 }; i }
    // a break in the condition stops the loop around it
    condBrk() {
        n = 0
        [1, 2, 3] each { |x| { (x == 2) ifTrue { break }; false } whileTrue { }; n = n + 1 }
        n
    }
    bareReturn() { 5; return }
}
Test eq(Wl sum(5), 10)
Test eq(Wl last(3), 30)
Test eq(Wl brk([1, 2, 0, 4]), 2)
Test eq(Wl cont(10), 5)
Test eq(Wl ret(4), 400)
Test eq(Wl wf(3), 3)
Test eq(Wl tailBrk(3), 2)
Test eq(Wl lastBrk(2), 4)
Test eq(Wl loneTail(2) ifFalse { "skipped" }, "skipped")
Test eq(Wl fresh toString, "[nil, nil, nil]")
Test eq(Wl closures toString, "[0, 1, 2]")
Test eq(Wl nested, 6)
Test eq(Wl tryBrk, 3)
Test eq(Wl eachBrk, 2)
Test eq(Wl condBrk, 1)
Test eq(Wl bareReturn, nil)
// outside methods `return` ends just the loop's body block (the loop goes on)
rl = { |n| i = 0; { i < n } whileTrue { i = i + 1; (i == 2) ifTrue { return 99 } }; i }
Test eq(rl value(5), 5)

// A break ends the call its block literal was passed to (nil), and a continue
// ends that run of the block (nil), whatever the method does with the block
Bk = Object clone {
    saved = nil
    run(b) { b value; "after" }
    over(xs, b) { xs each { |x| b value(x) }; "done" }
    // a recursive walk: a break stops all of it
    walk(t, b) { t each { |c| (c type == "Array") ifTrue { self walk(c, b) } ifFalse { b value(c) } }; "walked" }
    mapBrk(xs) { xs map { |x| (x > 2) ifTrue { break }; x * 10 } }
    mapCont(xs) { xs map { |x| (x == 2) ifTrue { continue }; x * 10 } }
    selfCall() { run({ break }) }
    tryCont(xs) { xs map { |x| try { (x == 2) ifTrue { continue } } catch { |e| nil }; x } }
    tryBrk(xs) { r = xs map { |x| try { (x == 2) ifTrue { break } } catch { |e| nil }; x }; [r] }
    valueCont(xs) { xs map { |x| { (x == 2) ifTrue { continue } } value; x } }
    nested() { n = 0; [1, 2, 3] each { |x| [10, 20] map { |y| (y == 20) ifTrue { break }; n = n + y }; n = n + 1 }; n }
    // a loop around a block's break is inlined (the break is the block's)
    loopEach(xs) { t = 0; i = 0; { i < 3 } whileTrue { i = i + 1; xs each { |x| (x == 2) ifTrue { break }; t = t + x } }; t }
    eachValue() { [1, 2] each { |x| break } }
    keep(b) { saved = b; "kept" }
    late() { saved value }
}
BkSub = Bk clone { run(b) { super run(b) } }
Test eq(Bk mapBrk([1, 2, 3, 4]), nil)
Test eq(Bk mapCont([1, 2, 3]) toString, "[10, nil, 30]")
Test eq(Bk run({ break }), nil)
Test eq(Bk run({ 1 }), "after")
Test eq(Bk selfCall, nil)
Test eq(BkSub run({ break }), nil)
seen = []
Test eq(Bk over([1, 2, 3, 4], { |x| (x == 2) ifTrue { continue }; (x == 4) ifTrue { break }; seen push(x) }), nil)
Test eq(seen toString, "[1, 3]")
seen = []
Test eq(Bk walk([1, [2, [3, 4]], 5], { |x| (x == 3) ifTrue { break }; seen push(x) }), nil)
Test eq(seen toString, "[1, 2]")
Test eq(Bk tryCont([1, 2, 3]) toString, "[1, nil, 3]")
Test eq(Bk tryBrk([1, 2, 3]) toString, "[nil]")
Test eq(Bk valueCont([1, 2, 3]) toString, "[1, nil, 3]")
Test eq(Bk nested, 33)
Test eq(Bk loopEach([1, 2, 3]), 3)
Test eq(Bk eachValue, nil)
Test eq([1, 2, 3] filter { |x| (x == 2) ifTrue { continue }; true } toString, "[1, 3]")
Test eq(Bk keep({ break }), "kept")
msg = try { Bk late; "none" } catch { |e| e message }
Test eq(msg, "'break' in a block whose call has already returned")
// at the top level too
tl = [1, 2, 3, 4] map { |x| (x > 2) ifTrue { break }; x }
Test eq(tl, nil)

// Inside methods and blocks `n times { |i| ... }` and `(a..b) each { |i| ... }`
// run in place; they must behave exactly like the messages (top level below)
Cl = Object clone {
    i = "slot"
    tv(n) { n times { |i| i * 2 } }
    tvCont(n) { n times { |i| (i == n - 1) ifTrue { continue }; i } }
    tvBrk(n) { n times { |i| (i == 2) ifTrue { break }; i } }
    rv(a, b) { ((a..b) each { |i| i }) toString }
    rvBrk(a, b) { (a..b) each { |i| (i == 2) ifTrue { break } } }
    sum(n) { t = 0; n times { |i| t = t + i }; t }
    sumR(a, b) { t = 0; (a..b) each { |i| (i % 2 == 0) ifTrue { continue }; t = t + i }; t }
    // the parameter and the body's variables are the run's own
    caps() { fs = []; 3 times { |i| fs push({ i }) }; (fs map { |f| f value }) toString }
    capsR() { fs = []; (1..3) each { |i| w = i * 10; fs push({ w + i }) }; (fs map { |f| f value }) toString }
    fresh() { out = []; 3 times { |i| out push(v); v = i }; out toString }
    // the parameter hides a variable or slot of the same name
    shadow() { k = 100; out = []; 3 times { |k| out push(k) }; out push(k); out toString }
    slotShadow() { out = []; 2 times { |i| out push(i) }; out push(i); out toString }
    assignParam() { out = []; 3 times { |i| i = i * 10; out push(i) }; out toString }
    nestedName() { out = []; 2 times { |i| 2 times { |i| out push(i) }; out push(i) }; out toString }
    ret(n) { n times { |i| (i == 3) ifTrue { return "ret" + i toString } }; "none" }
    nested() { c = 0; 4 times { |i| (0..i) each { |j| c = c + j } }; c }
    noParam() { c = 0; 5 times { c = c + 1 }; c }
    fl() { c = 0; 3.7 times { c = c + 1 }; c }
    zero() { c = 0; 0 times { c = c + 1 }; (-3) times { c = c + 1 }; (5..1) each { |i| c = c + 1 }; c }
    edge() { c = 0; (2305843009213693948..2305843009213693951) each { |i| c = c + 1 }; c }
    brkInner() { c = 0; 3 times { |i| [1, 2, 3] each { |x| (x == 2) ifTrue { break }; c = c + 1 } }; c }
    bad(x) { x times { 1 } }
    badR(x) { (1..x) each { |i| i } }
}
Test eq(Cl tv(4), 6)
Test eq(Cl tv(0), nil)
Test eq(Cl tvCont(3), nil)
Test eq(Cl tvBrk(5), nil)
Test eq(Cl rv(1, 3), "1..3")
Test eq(Cl rvBrk(1, 5), nil)
Test eq(Cl sum(100), 4950)
Test eq(Cl sumR(1, 10), 25)
Test eq(Cl caps, "[0, 1, 2]")
Test eq(Cl capsR, "[11, 22, 33]")
Test eq(Cl fresh, "[nil, nil, nil]")
Test eq(Cl shadow, "[0, 1, 2, 100]")
Test eq(Cl clone slotShadow, "[0, 1, slot]")
Test eq(Cl assignParam, "[0, 10, 20]")
Test eq(Cl nestedName, "[0, 1, 0, 0, 1, 1]")
Test eq(Cl ret(10), "ret3")
Test eq(Cl ret(2), "none")
Test eq(Cl nested, 10)
Test eq(Cl noParam, 5)
Test eq(Cl fl, 3)
Test eq(Cl zero, 0)
Test eq(Cl edge, 4)
Test eq(Cl brkInner, 3)
Test eq(try { Cl bad("x") } catch { |e| e message }, "String does not understand 'times'")
Test eq(try { Cl bad(nil) } catch { |e| e message }, "message 'times' sent to nil")
Test eq(try { Cl badR(2.5) } catch { |e| e message }, "a range needs integer bounds, not Float")
Test eq(4 times { |i| i * 2 }, 6)
Test eq(3 times { |i| (i == 2) ifTrue { continue }; i }, nil)
Test eq(5 times { |i| (i == 2) ifTrue { break }; i }, nil)
Test eq(((1..3) each { |i| i }) toString, "1..3")
Test eq((1..5) each { |i| (i == 2) ifTrue { break } }, nil)
Test eq(try { (1..2.5) each { |i| i } } catch { |e| e message }, "a range needs integer bounds, not Float")

// Nested conditionals
x = 10
r5 = 0
(x > 5) ifTrue {
    (x > 15) ifTrue { r5 = 1 }
    (x > 15) ifFalse { r5 = 2 }
}
Test eq(r5, 2)

// Short-circuit && — right side not evaluated when left is false
sc1 = 0
flag = { sc1 = 1 }
false && flag value()
Test eq(sc1, 0)

// Short-circuit || — right side not evaluated when left is true
sc2 = 0
flag2 = { sc2 = 1 }
true || flag2 value()
Test eq(sc2, 0)

// Nested whileTrue
total = 0
i = 0
{ i < 3 } whileTrue {
    j = 0
    { j < 3 } whileTrue {
        total = total + 1
        j = j + 1
    }
    i = i + 1
}
Test eq(total, 9)

// Complex boolean
Test ok((3 > 1) && (5 < 10))
Test no((3 > 1) && (5 > 10))
Test ok((3 > 5) || (5 < 10))
Test no((3 > 5) || (5 > 10))

// Chained logical
Test ok(true && true && true)
Test no(true && true && false)
Test ok(false || false || true)
Test no(false || false || false)

// Comparison operators
Test ok(1 < 2)
Test no(2 < 1)
Test ok(2 > 1)
Test no(1 > 2)
Test ok(1 <= 1)
Test ok(1 <= 2)
Test ok(2 >= 2)
Test ok(3 >= 2)
Test ok(1 == 1)
Test no(1 == 2)
Test ok(1 != 2)
Test no(1 != 1)

Test done()

// Test: early return from methods

Animal = Object clone {
    sound = "..."

    speak(n) {
        return self sound + " x" + n toString
    }

    compute(x) {
        return x * 2 + 1
    }
}

// Test basic return
result = Animal speak(3)
(result != "... x3") ifTrue {
    raise("FAIL: expected '... x3', got '" + result + "'")
}

// Test return with computation
r2 = Animal compute(5)
(r2 != 11) ifTrue {
    raise("FAIL: expected 11, got " + r2 toString)
}

// Test return with no expression
Counter = Object clone {
    count = 0
    bump() {
        self count = self count + 1
        return
    }
}

c = Counter clone
c bump
// return with no value should complete without error

// Test return from multi-statement method (early exit)
Finder = Object clone {
    check(x) {
        (x > 10) ifTrue {
            return "big"
        }
        return "small"
    }
}

r3 = Finder check(5)
(r3 != "small") ifTrue {
    raise("FAIL: expected 'small', got '" + r3 + "'")
}

// --- Non-local return: `return` in a block returns from the method ---

check = { |label, got, want|
    (got != want) ifTrue {
        raise("FAIL: " + label + " - expected " + want toString + ", got " + got toString)
    }
}

check value("return in ifTrue", Finder check(50), "big")

Search = Object clone {
    hits = 0
    find(arr, target) {
        arr each { |x|
            hits = hits + 1
            (x == target) ifTrue { return "found " + x toString }
        }
        "missing"
    }
    pair(arr) {
        arr each { |x| arr each { |y| ((x + y) == 7) ifTrue { return [x, y] } } }
        nil
    }
    inTry(arr) {
        try { arr each { |x| (x > 2) ifTrue { return x * 10 } } } catch { |e| return "caught" }
        0
    }
    withFinally(log) {
        try { [1, 2, 3] each { |x| return x } } finally { log push("finally") }
        99
    }
    sumTo(n) {
        (n == 0) ifTrue { return 0 }
        [n] each { |x| return self sumTo(n - 1) + x }
        -1
    }
    abs(n) {
        (n < 0) ifTrue { return 0 - n }
        n
    }
    early() {
        5 times { |i| (i == 2) ifTrue { return } }
        "not reached"
    }
    escaping() { { |x| return x } }
}

s = Search clone
check value("find", s find([1, 2, 3, 4], 2), "found 2")
check value("find stops the loop", s hits, 2)
check value("find missing", s find([1, 2], 9), "missing")
check value("nested blocks", s pair([1, 3, 4, 6]), [1, 6])
check value("through try", s inTry([1, 2, 3, 4]), 30)
log = []
check value("through finally", s withFinally(log), 1)
check value("finally ran", log, ["finally"])
check value("recursive", s sumTo(4), 10)
check value("abs negative", s abs(0 - 5), 5)
check value("abs positive", s abs(5), 5)
check value("bare return", s early, nil)
// The callers' state is intact after a non-local return
total = 0
(1..3) each { |i| total = total + (s abs(0 - i)) }
check value("caller loop", total, 6)

// A block whose method has already returned can't return from it
blk = s escaping
r = try { blk value(5) } catch { |e| e type }
check value("orphaned return", r, "RuntimeError")

"PASS: early return" println

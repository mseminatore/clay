// Test array destructuring assignment

// Basic destructuring
// failures are counted, and the program exits 1 if there were any
TestFails = Object clone {
    count = 0
    fail(msg) {
        msg println
        self count = self count + 1
    }
}

arr = [10, 20, 30]
[a, b, c] = arr
(a == 10) ifTrue { "PASS: first element" println } ifFalse { TestFails fail("FAIL: a=" + a toString) }
(b == 20) ifTrue { "PASS: second element" println } ifFalse { TestFails fail("FAIL: b=" + b toString) }
(c == 30) ifTrue { "PASS: third element" println } ifFalse { TestFails fail("FAIL: c=" + c toString) }

// Destructuring with expression RHS
[x, y] = [100, 200]
(x == 100) ifTrue { "PASS: inline array" println } ifFalse { TestFails fail("FAIL: x=" + x toString) }
(y == 200) ifTrue { "PASS: inline array 2" println } ifFalse { TestFails fail("FAIL: y=" + y toString) }

// Destructuring with mixed types
[name, age] = ["Alice", 30]
(name == "Alice") ifTrue { "PASS: string element" println } ifFalse { TestFails fail("FAIL: name=" + name toString) }
(age == 30) ifTrue { "PASS: int element" println } ifFalse { TestFails fail("FAIL: age=" + age toString) }

// Fewer targets than elements (extra elements ignored)
[first, second] = [1, 2, 3, 4, 5]
(first == 1) ifTrue { "PASS: fewer targets" println } ifFalse { TestFails fail("FAIL: first=" + first toString) }
(second == 2) ifTrue { "PASS: fewer targets 2" println } ifFalse { TestFails fail("FAIL: second=" + second toString) }

// Destructuring return value from method
Point = Object clone {
  px = 0
  py = 0
  new(ax, ay) { p = Point clone; p px = ax; p py = ay; p }
  toArray() { [px, py] }
}

pt = Point new(42, 99)
[mx, my] = pt toArray
(mx == 42) ifTrue { "PASS: method return" println } ifFalse { TestFails fail("FAIL: mx=" + mx toString) }
(my == 99) ifTrue { "PASS: method return 2" println } ifFalse { TestFails fail("FAIL: my=" + my toString) }

// Destructuring inside a block
swap = { |pair| [sa, sb] = pair; [sb, sa] }
result = swap value([3, 7])
(result at(0) == 7) ifTrue { "PASS: block destructure" println } ifFalse { TestFails fail("FAIL: swap[0]=" + result at(0) toString) }
(result at(1) == 3) ifTrue { "PASS: block destructure 2" println } ifFalse { TestFails fail("FAIL: swap[1]=" + result at(1) toString) }

(TestFails count > 0) ifTrue {
    ((TestFails count) toString + " failed") println
    System exit(1)
}

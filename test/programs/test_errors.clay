// test_errors.clay — Error handling: try/catch/raise

Test = Object clone {
    _p = 0
    _f = 0
    eq(a, b) {
        (a == b) ifTrue { self _p = self _p + 1 }
        (!(a == b)) ifTrue { self _f = self _f + 1; ("FAIL: " + a toString() + " != " + b toString()) println() }
        self
    }
    ok(v) {
        (v == true) ifTrue { self _p = self _p + 1 }
        (!(v == true)) ifTrue { self _f = self _f + 1; "FAIL: expected true" println() }
        self
    }
    done() {
        total = self _p + self _f
        (total toString() + " tests, " + self _p toString() + " passed, " + self _f toString() + " failed") println()
        (self _f > 0) ifTrue { raise("test failures") }
        self
    }
}

// Catch a raised string
r1 = try { raise("oops") } catch { |e| e message() }
Test eq(r1, "oops")

// Error type is RuntimeError
r2 = try { raise("boom") } catch { |e| e type() }
Test eq(r2, "RuntimeError")

// Try succeeds — catch not reached
r3 = try { 42 } catch { |e| 0 }
Test eq(r3, 42)

// Try succeeds with string
r4 = try { "hello" } catch { |e| "error" }
Test eq(r4, "hello")

// Catch division by zero
r5 = try { 10 / 0 } catch { |e| "div0" }
Test eq(r5, "div0")

// Nested try/catch — inner catches
r6 = try {
    try { raise("inner") } catch { |e| "inner caught" }
} catch { |e| "outer caught" }
Test eq(r6, "inner caught")

// Nested try/catch — inner rethrows (outer catches)
r7 = try {
    try { raise("inner") } catch { |e| raise("rethrown") }
} catch { |e| e message() }
Test eq(r7, "rethrown")

// Try with no catch — should still work
r8 = try { 99 } catch { |e| 0 }
Test eq(r8, 99)

// Catch method-not-found
r9 = try { 42 banana() } catch { |e| "caught" }
Test eq(r9, "caught")

// Code after try/catch continues
x = 0
try { x = 1 } catch { |e| x = 2 }
Test eq(x, 1)

try { raise("err"); x = 99 } catch { |e| x = 3 }
Test eq(x, 3)

// Finally runs on success
f = 0
try { 42 } catch { |e| 0 } finally { f = 1 }
Test eq(f, 1)

// Finally runs on error
f = 0
try { raise("err") } catch { |e| 0 } finally { f = 2 }
Test eq(f, 2)

// Finally runs with try only (no catch)
f = 0
try { 99 } finally { f = 3 }
Test eq(f, 3)


// Modulo by zero raises DivisionByZero (literal and variable divisor)
m1 = try { 5 % 0 } catch { |e| e type() }
Test eq(m1, "DivisionByZero")
zero = 0
m2 = try { 7 % zero } catch { |e| e type() }
Test eq(m2, "DivisionByZero")
Test eq(7 % 3, 1)


// Bad arguments raise instead of silently coercing
Test eq(try { Math sqrt("x") } catch { |e| e type() }, "TypeError")
Test eq(try { Math max(1, "z") } catch { |e| e type() }, "TypeError")
Test eq(try { "abc" split(5) } catch { |e| e type() }, "TypeError")
Test eq(try { [1, 2] at("x") } catch { |e| e type() }, "TypeError")
Test eq(try { Regex test("abc", 5) } catch { |e| e type() }, "TypeError")
Test eq(try { (1..10) step(0) } catch { |e| e type() }, "ArgumentError")
Test eq(try { Date new("2026-01-01") } catch { |e| e type() }, "ArgumentError")
Test eq(try { 42 println(1) } catch { |e| e type() }, "ArgumentError")

// Methods written in Clay reject extra arguments; blocks accept them
Arity = Object clone {
    two(a, b) { a + b }
    opt(a, b = 5) { a + b }
}
Test eq(Arity two(1, 2), 3)
Test eq(Arity opt(1), 6)
Test eq(try { Arity two(1, 2, 3) } catch { |e| e type() }, "ArgumentError")
Test eq(try { Arity two(1, 2, 3) } catch { |e| e message() }, "two takes 2 arguments, but 3 were given")
Test eq({ |a| a } value(7, 8, 9), 7)


// Slot assignment on nil / a number raises (was a segfault)
nothing = nil
Test eq(try { nothing x = 1 } catch { |e| e type() }, "NilError")
Test eq(try { 5 x = 1 } catch { |e| e type() }, "TypeError")

// finally always runs, and an error it didn't handle keeps going
log = []
r = try { try { raise("boom") } finally { log push("f1") } } catch { |e| e message() }
Test eq(r, "boom")                         // try + finally re-raises
Test eq(log, ["f1"])
log = []
r = try { try { raise("a") } catch { |e| raise("b") } finally { log push("f2") } } catch { |e| e message() }
Test eq(r, "b")                            // an error in catch still runs finally
Test eq(log, ["f2"])
r = try { try { File read("/no/such/file") } finally { 0 } } catch { |e| e type() }
Test eq(r, "FileError")                    // the error keeps its type
r = try { try { raise("inner") } finally { raise("outer") } } catch { |e| e message() }
Test eq(r, "outer")                        // an error in finally replaces it
log = []
Test eq(try { 7 } finally { log push("f3") }, 7)
Test eq(log, ["f3"])


// a precedence slip gets a hint: ifTrue binds to the 5, not the comparison
n = 5
msg = try { n == 5 ifTrue { 1 } } catch { |e| e message() }
Test eq(msg contains("binds tighter than an operator"), true)
msg = try { n < 3 whileTrue { 1 } } catch { |e| e message() }
Test eq(msg contains("whileTrue is sent to a block"), true)
Test eq((try { n foo } catch { |e| e message() }), "integer does not understand 'foo'")

// "does not understand" says what the receiver was
Test eq((try { [1, 2] byteAt(0) } catch { |e| e message() }), "Array does not understand 'byteAt'")
Test eq((try { "text" foo } catch { |e| e message() }), "String does not understand 'foo'")
Test eq((try { #{"a": 1} bar } catch { |e| e message() }), "Dict does not understand 'bar'")
Test eq((try { { 1 } baz } catch { |e| e message() }), "Block does not understand 'baz'")
Test eq((try { true nope } catch { |e| e message() }), "Boolean does not understand 'nope'")
Test eq((try { (1..3) quux } catch { |e| e message() }), "Range does not understand 'quux'")
Test eq((try { Object clone zap } catch { |e| e message() }), "Object does not understand 'zap'")
// a user prototype with a _name is called by it, and so are its clones
Named = Object clone { _name = "Named" }
Test eq((try { Named wag } catch { |e| e message() }), "Named does not understand 'wag'")
Test eq((try { Named clone wag } catch { |e| e message() }), "Named does not understand 'wag'")
Test eq((try { Named wag } catch { |e| e type() }), "MethodNotFound")
// ...and the precedence hint still follows the message
Test eq((try { "x" ifTrue { 1 } } catch { |e| e message() } contains("String does not understand 'ifTrue'")), true)

Test done()

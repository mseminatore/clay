// test_errors.clay — Error handling: try/catch/raise

Test = Object clone {
    _p = 0
    _f = 0
    eq(a, b) {
        (a == b) ifTrue { self _p = self _p + 1 }
        (!(a == b)) ifTrue { self _f = self _f + 1; ("FAIL: " + a toString() + " != " + b toString()) println() }
        self
    }
    ok(v) {
        (v == true) ifTrue { self _p = self _p + 1 }
        (!(v == true)) ifTrue { self _f = self _f + 1; "FAIL: expected true" println() }
        self
    }
    done() {
        total = self _p + self _f
        (total toString() + " tests, " + self _p toString() + " passed, " + self _f toString() + " failed") println()
        (self _f > 0) ifTrue { raise("test failures") }
        self
    }
}

// Catch a raised string
r1 = try { raise("oops") } catch { |e| e message() }
Test eq(r1, "oops")

// Error type is RuntimeError
r2 = try { raise("boom") } catch { |e| e type() }
Test eq(r2, "RuntimeError")

// Try succeeds — catch not reached
r3 = try { 42 } catch { |e| 0 }
Test eq(r3, 42)

// Try succeeds with string
r4 = try { "hello" } catch { |e| "error" }
Test eq(r4, "hello")

// Catch division by zero
r5 = try { 10 / 0 } catch { |e| "div0" }
Test eq(r5, "div0")

// Nested try/catch — inner catches
r6 = try {
    try { raise("inner") } catch { |e| "inner caught" }
} catch { |e| "outer caught" }
Test eq(r6, "inner caught")

// Nested try/catch — inner rethrows (outer catches)
r7 = try {
    try { raise("inner") } catch { |e| raise("rethrown") }
} catch { |e| e message() }
Test eq(r7, "rethrown")

// Try with no catch — should still work
r8 = try { 99 } catch { |e| 0 }
Test eq(r8, 99)

// Catch method-not-found
r9 = try { 42 banana() } catch { |e| "caught" }
Test eq(r9, "caught")

// Code after try/catch continues
x = 0
try { x = 1 } catch { |e| x = 2 }
Test eq(x, 1)

try { raise("err"); x = 99 } catch { |e| x = 3 }
Test eq(x, 3)

// Finally runs on success
f = 0
try { 42 } catch { |e| 0 } finally { f = 1 }
Test eq(f, 1)

// Finally runs on error
f = 0
try { raise("err") } catch { |e| 0 } finally { f = 2 }
Test eq(f, 2)

// Finally runs with try only (no catch)
f = 0
try { 99 } finally { f = 3 }
Test eq(f, 3)


// Modulo by zero raises DivisionByZero (literal and variable divisor)
m1 = try { 5 % 0 } catch { |e| e type() }
Test eq(m1, "DivisionByZero")
zero = 0
m2 = try { 7 % zero } catch { |e| e type() }
Test eq(m2, "DivisionByZero")
Test eq(7 % 3, 1)


// Bad arguments raise instead of silently coercing
Test eq(try { Math sqrt("x") } catch { |e| e type() }, "TypeError")
Test eq(try { Math max(1, "z") } catch { |e| e type() }, "TypeError")
Test eq(try { "abc" split(5) } catch { |e| e type() }, "TypeError")
Test eq(try { [1, 2] at("x") } catch { |e| e type() }, "TypeError")
Test eq(try { Regex test("abc", 5) } catch { |e| e type() }, "TypeError")
Test eq(try { (1..10) step(0) } catch { |e| e type() }, "ArgumentError")
Test eq(try { Date new("2026-01-01") } catch { |e| e type() }, "ArgumentError")
Test eq(try { 42 println(1) } catch { |e| e type() }, "ArgumentError")

// Methods written in Clay reject extra arguments; blocks accept them
Arity = Object clone {
    two(a, b) { a + b }
    opt(a, b = 5) { a + b }
}
Test eq(Arity two(1, 2), 3)
Test eq(Arity opt(1), 6)
Test eq(try { Arity two(1, 2, 3) } catch { |e| e type() }, "ArgumentError")
Test eq(try { Arity two(1, 2, 3) } catch { |e| e message() }, "two takes 2 arguments, but 3 were given")
Test eq({ |a| a } value(7, 8, 9), 7)


// Slot assignment on nil / a number raises (was a segfault)
nothing = nil
Test eq(try { nothing x = 1 } catch { |e| e type() }, "NilError")
Test eq(try { 5 x = 1 } catch { |e| e type() }, "TypeError")

Test done()

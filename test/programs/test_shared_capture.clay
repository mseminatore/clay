// Test shared capture semantics (true upvalue behavior)

// Two blocks sharing a captured variable
// failures are counted, and the program exits 1 if there were any
TestFails = Object clone {
    count = 0
    fail(msg) {
        msg println
        self count = self count + 1
    }
}

makeCounters = {
  n = 0
  inc = { n = n + 1; n }
  dec = { n = n - 1; n }
  [inc, dec]
}

pair = makeCounters value
inc = pair at(0)
dec = pair at(1)

r1 = inc value
(r1 == 1) ifTrue { "PASS: shared inc 1" println } ifFalse { TestFails fail(("FAIL: shared inc 1 got " + r1 toString)) }

r2 = inc value
(r2 == 2) ifTrue { "PASS: shared inc 2" println } ifFalse { TestFails fail(("FAIL: shared inc 2 got " + r2 toString)) }

r3 = dec value
(r3 == 1) ifTrue { "PASS: shared dec" println } ifFalse { TestFails fail(("FAIL: shared dec got " + r3 toString)) }

r4 = inc value
(r4 == 2) ifTrue { "PASS: shared inc after dec" println } ifFalse { TestFails fail(("FAIL: shared inc after dec got " + r4 toString)) }

// 3-level nested capture
outer = {
  x = 0
  middle = {
    inner = { x = x + 1; x }
    inner
  }
  [middle, { x }]
}

result = outer value
getInc = result at(0)
getX = result at(1)

innerInc = getInc value
r5 = innerInc value
(r5 == 1) ifTrue { "PASS: 3-level inc" println } ifFalse { TestFails fail(("FAIL: 3-level inc got " + r5 toString)) }

r6 = innerInc value
(r6 == 2) ifTrue { "PASS: 3-level inc 2" println } ifFalse { TestFails fail(("FAIL: 3-level inc 2 got " + r6 toString)) }

r7 = getX value
(r7 == 2) ifTrue { "PASS: outer sees nested write" println } ifFalse { TestFails fail(("FAIL: outer sees nested got " + r7 toString)) }

"All shared capture tests completed" println

(TestFails count > 0) ifTrue {
    ((TestFails count) toString + " failed") println
    System exit(1)
}

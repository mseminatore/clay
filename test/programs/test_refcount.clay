// test_refcount.clay - refcount regression tests: repeating an operation must
// not grow the number of live objects (System liveObjects = allocated - freed)

failures = 0

// live objects gained over 100 more runs of `block`, after one warm-up run
// (the warm-up creates anything made once, e.g. a native program's literals)
growth = { |block|
  block value
  b = System liveObjects
  n = 0
  { n < 100 } whileTrue { block value; n = n + 1 }
  System liveObjects - b
}

check = { |what, block|
  g = growth value(block)
  (g > 0) ifTrue {
    ("FAIL: " + what + " leaks " + g toString + " objects per 100 runs") println
    failures = failures + 1
  } ifFalse { ("ok: " + what) println }
}

// --- Dict each does not leak key strings ---
d = #{ "a": 1, "b": 2, "c": 3 }
count = 0
check value("dict each", { d each({ |k, v| count = count + v }) })

// --- Slot write releases the old value ---
Point = Object clone {
  _x = 0
  setX(v) { _x = v }
}
p = Point clone
check value("slot write", { p setX("hello"); p setX("world" + 1 toString) })

// --- Array toString does not leak ---
arr = [1, 2, 3, "four", "five"]
s = nil
check value("array toString", { s = arr toString })

// --- Closures, exceptions and string building release their temporaries ---
check value("closure call", { f = { |x| x + count }; f value(1) })
check value("try/catch", { try { raise("x") } catch { |e| e message } })
check value("string concat", { t = "a" + count toString + "b" })

// --- and the measurement does see a real leak ---
kept = []
(growth value({ kept push("x" + kept size toString) }) == 100) ifFalse {
  "FAIL: growth didn't detect objects that are kept alive" println
  failures = failures + 1
}

(failures > 0) ifTrue { System exit(1) }
"PASS" println

// test_refcount.clay - refcount regression tests: repeating an operation must
// not grow the number of live objects (System liveObjects = allocated - freed)

failures = 0

// live objects gained over 100 more runs of `block`, after one warm-up run
// (the warm-up creates anything made once, e.g. a native program's literals)
growth = { |block|
  block value
  b = System liveObjects
  n = 0
  { n < 100 } whileTrue { block value; n = n + 1 }
  System liveObjects - b
}

check = { |what, block|
  g = growth value(block)
  (g > 0) ifTrue {
    ("FAIL: " + what + " leaks " + g toString + " objects per 100 runs") println
    failures = failures + 1
  } ifFalse { ("ok: " + what) println }
}

// --- Dict each does not leak key strings ---
d = #{ "a": 1, "b": 2, "c": 3 }
count = 0
check value("dict each", { d each({ |k, v| count = count + v }) })

// --- Slot write releases the old value ---
Point = Object clone {
  _x = 0
  setX(v) { _x = v }
}
p = Point clone
check value("slot write", { p setX("hello"); p setX("world" + 1 toString) })

// --- Array toString does not leak ---
arr = [1, 2, 3, "four", "five"]
s = nil
check value("array toString", { s = arr toString })

// --- Closures, exceptions and string building release their temporaries ---
check value("closure call", { f = { |x| x + count }; f value(1) })
check value("try/catch", { try { raise("x") } catch { |e| e message } })
check value("string concat", { t = "a" + count toString + "b" })

// --- String methods that give back the receiver (no match, nothing to pad)
// return it borrowed, and a new string doesn't outlive them ---
check value("replace with no match", { ("ab" + count toString) replace("x", "y") })
check value("padLeft too short to pad", { ("ab" + count toString) padLeft(1) })
check value("padRight too short to pad", { ("ab" + count toString) padRight(1) })
check value("toString of a new string", { ("ab" + count toString) toString })
check value("strings inside an Array toString", { [("ab" + count toString), 1] toString })
check value("strings inside a Dict toString", { #{a: ("ab" + count toString)} toString })
check value("Console print of a new string", { Console print("") })

// --- Leaving blocks early releases what the frames skipped held: a `return`
// from a block (its method's temporaries, variables, parameters and cells, and
// the blocks in between), break, continue, and a caught error ---
Early = Object clone {
  fromIf(x) { (x > 0) ifTrue { return "a" + x toString }; "b" }
  fromEach(xs) { xs each { |v| (v == 2) ifTrue { return v } }; 0 }
  fromNested(xs) {
    tag = "t" + xs size toString
    xs each { |v| [1, 2] each { |w| (v == 2 && w == 2) ifTrue { return tag } } }
    nil
  }
  breakOut(xs) { n = 0; xs each { |v| (v == 2) ifTrue { break }; n = n + v }; n }
  skip(xs) { n = 0; xs each { |v| (v == 2) ifTrue { continue }; n = n + v }; n }
  caught(x) { try { s = "s" + x toString; raise(s) } catch { |e| e message } }
}
check value("return from ifTrue in a method", { Early fromIf(count + 1) })
check value("return from each in a method", { Early fromEach([1, 2, 3]) })
check value("return from nested each, captured local", { Early fromNested([1, 2, 3]) })
check value("break out of each", { Early breakOut([1, 2, 3]) })
check value("continue in each", { Early skip([1, 2, 3]) })
check value("raise and catch a new string", { Early caught(count) })
check value("ifTrue/ifFalse chain", { ((count > 0) ifTrue { "a" + "b" } ifFalse { "c" }) toString })
check value("lone ifTrue keeping its result", { ((count == 0) ifTrue { "a" + "b" }) clone })

// --- Runtime methods that call blocks release what they are building (a
// map's array, a reduce's accumulator, a Dict each's key) when a block leaves
// early, and so do doesNotUnderstand and catch/finally blocks that raise ---
caughtIn = { |block| try { block value } catch { |e| e } }
Through = Object clone {
  m(xs) { xs map { |v| (v == 3) ifTrue { return "r" }; "s" + v toString } }
  r(xs) { xs reduce("a") { |a, v| (v == 3) ifTrue { return a }; a + "b" } }
  t() { 3 times { |i| (i == 2) ifTrue { return 1 }; "s" + i toString } }
  k() { #{a: 1} each { |k, v| return k } }
}
check value("raise from map", { caughtIn value({ [1, 2, 3] map { |v| (v == 3) ifTrue { raise("x") }; "s" + v toString } }) })
check value("raise from filter", { caughtIn value({ [1, 2, 3] filter { |v| (v == 3) ifTrue { raise("x") }; true } }) })
check value("raise from Range map", { caughtIn value({ (1..3) map { |v| (v == 3) ifTrue { raise("x") }; "s" + v toString } }) })
check value("raise from whileTrue", { caughtIn value({ i = 0; { i < 3 } whileTrue { i = i + 1; (i == 2) ifTrue { raise("x") }; "s" + i toString } }) })
check value("return from map", { Through m([1, 2, 3]) })
check value("return from reduce", { Through r([1, 2, 3]) })
check value("return from times", { Through t })
check value("return from Dict each", { Through k })
check value("doesNotUnderstand caught", { caughtIn value({ [1] frob("a" + "b") }) })
check value("catch block raises", { caughtIn value({ try { raise("a" + "b") } catch { |e| raise("c" + "d") } }) })
check value("finally block raises", { caughtIn value({ try { "x" + "y" } finally { raise("c" + "d") } }) })
check value("catch and finally raise", { caughtIn value({ try { raise("a") } catch { |e| raise("b") } finally { raise("c" + "d") } }) })

// --- Reference cycles are freed by the cycle collector (System collect runs
// it now; it also runs by itself) ---
cycleGrowth = { |block|
  block value
  System collect
  b = System liveObjects
  n = 0
  { n < 100 } whileTrue { block value; n = n + 1 }
  System collect
  System liveObjects - b
}
checkCycle = { |what, block|
  g = cycleGrowth value(block)
  (g > 0) ifTrue {
    ("FAIL: " + what + " leaks " + g toString + " objects per 100 runs") println
    failures = failures + 1
  } ifFalse { ("ok: " + what) println }
}
Node = Object clone {
  parent = nil
  kids = nil
  init() { kids = []; self }
  add(c) { c parent = self; kids push(c); c }
}
Button = Object clone {
  clicks = 0
  onClick = nil
  wire() { onClick = { clicks = clicks + 1 }; self }
}
Maths = Object clone {
  fact(k) { f = nil; f = { |m| (m <= 1) ifTrue { 1 } ifFalse { m * (f value(m - 1)) } }; f value(k) }
}
checkCycle value("tree with parent pointers", { r = Node clone init; r add(Node clone init); r add(Node clone init) })
checkCycle value("block in a slot that uses self", { Button clone wire })
checkCycle value("recursive local block", { Maths fact(5) })
checkCycle value("array holding itself", { a = []; a push(a) })
checkCycle value("dict holding itself", { d = #{}; d set("me", d) })
checkCycle value("cycle through a prototype", { p = Object clone; c = p clone; p kid = c })
checkCycle value("cycle through a condition result", { a = []; a push((1 < 2) ifTrue { a }) })

// what is still in use is kept: a cycle reachable from a variable survives
// collection whole
keep = Node clone init
keep add(Node clone init) add(Node clone init)
System collect
((keep kids at(0)) kids size == 1 && (keep kids at(0)) parent == keep) ifFalse {
  "FAIL: a cycle in use was collected" println
  failures = failures + 1
}

// System collect says how many objects it freed
lost = { a = Node clone init; a add(Node clone init) }
lost value
System collect
lost value
((System collect) > 0) ifFalse {
  "FAIL: System collect freed nothing" println
  failures = failures + 1
}

// it runs by itself: making many cycles doesn't grow memory without bound
before = System liveObjects
30000 times { |i| r = Node clone init; r add(Node clone init) }
((System liveObjects - before) < 30000) ifFalse {
  ("FAIL: cycles weren't collected automatically (" + (System liveObjects - before) toString + " live)") println
  failures = failures + 1
}

// --- and the measurement does see a real leak ---
kept = []
(growth value({ kept push("x" + kept size toString) }) == 100) ifFalse {
  "FAIL: growth didn't detect objects that are kept alive" println
  failures = failures + 1
}

(failures > 0) ifTrue { System exit(1) }
"PASS" println

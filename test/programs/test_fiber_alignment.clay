// Code that runs on a fiber's own stack, and the code that resumes it, must
// keep the stack 16-byte aligned: formatting numbers and strings (libc's
// snprintf stores SSE registers with aligned moves) faults on real x86-64
// hardware when it is off by 8. Emulators don't check, so this runs
// everything formatting-heavy on both sides of every switch.

failures = 0
check = { |name, ok|
    ok ifFalse {
        Console print("FAIL: " + name + "\n")
        failures = failures + 1
    }
}

worker = Fiber new({
    a = "pi is ${3.14159} and e is ${2.71828}"
    Fiber yield(a)
    b = (1.5 * 4.25) toString + " " + (12345678 toString) + " " + ([1, 2.5, "x"] toString)
    Fiber yield(b)
    c = "${1 / 3.0} ${100 * 1.1} ${(1048576 * 1048576) toString}"
    Fiber yield(c)
    d = ["a", "b", "c"] join(", ") + " " + (Dict new toString)
    d
})

r1 = worker resume
check value("float interpolation in a fiber", r1 == "pi is 3.14159 and e is 2.71828")
x = "${2.5} after one resume: " + (r1 length toString)
check value("formatting after a resume", x == "2.5 after one resume: 30")

r2 = worker resume
check value("number and array formatting", r2 == "6.375 12345678 [1, 2.5, x]")
y = (0.1 + 0.2) toString + " " + ((7 / 2.0) toString)
check value("floats after another resume", y startsWith("0.3"))

r3 = worker resume
check value("more formatting in a fiber", r3 startsWith("0.33333334 "))
r4 = worker resume
check value("the fiber finishes", r4 startsWith("a, b, c"))
check value("it is done", worker isDone)

// a generator that formats as it goes
gen = Fiber new({
    i = 0
    { i < 20 } whileTrue {
        Fiber yield("item ${i}: ${i * 1.5}")
        i = i + 1
    }
})
last = nil
20 times { last = gen resume }
check value("a generator formatting floats", last == "item 19: 28.5")

(failures > 0) ifTrue {
    Console print(failures toString + " checks failed\n")
    System exit(1)
}
Console print("fiber alignment tests passed\n")

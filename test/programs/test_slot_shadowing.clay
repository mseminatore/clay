// Lookup rule: walking the prototype chain from the receiver, the nearest
// definition wins -- a slot hides a method inherited from further up; on the
// same object a method wins over a slot.

check = { |label, got, want|
    (got != want) ifTrue {
        raise("FAIL: " + label + " - expected " + want toString + ", got " + got toString)
    }
}

// Slots named like Object's methods (type, parent, slots) are readable
P = Object clone { type = "slot type"; parent = "slot parent"; slots = 3 }
check value("type slot", P type, "slot type")
check value("parent slot", P parent, "slot parent")
check value("slots slot", P slots, 3)

// Objects without the slot still get the method
Q = Object clone { }
check value("type method", Q type, "Q")
x = Object clone
check value("parent method", x parent == Object, true)

// A tree of nodes with a `parent` slot
Node = Object clone {
    kind = nil
    parent = nil
    init(k, p) { kind = k; parent = p }
    depth() {
        (parent == nil) ifTrue { return 0 }
        1 + parent depth
    }
}
root = Node new("root", nil)
leaf = Node new("leaf", Node new("child", root))
check value("depth via parent slots", leaf depth, 2)
check value("parent slot chain", leaf parent kind, "child")
check value("parent from a method", root parent, nil)

// On the same object, the method wins
R = Object clone {
    name = "slot"
    name() { "method" }
}
check value("method beats slot on same object", R name, "method")

// A slot on a prototype hides the method for its clones
S = Object clone { type = "S type" }
s = S clone
check value("inherited slot hides method", s type, "S type")

// A method added later to an ancestor is still hidden by an existing slot
T = Object clone { label = "slot label" }
Object setMethod("label", { "method label" })
check value("slot hides later method", T label, "slot label")
check value("later method elsewhere", Object clone label, "method label")

// Repeated sends through the caches stay correct
n = 0
10 times { |i| (s type == "S type") ifTrue { n = n + 1 } }
check value("cached sends", n, 10)

// A call site that cached an inherited method sees an override added later
// to a nearer prototype (one that already had methods)
G = Object clone { hi() { "G" } }
P = G clone { other() { 0 } }
C = P clone
greet = { |o| o hi }
before = greet value(C)
P setMethod("hi", { "P" })
check value("cached call before an override", before, "G")
check value("cached call after an override", greet value(C), "P")

// A slot read sent as a message, cached, then the same name becomes a method
Q = Object clone { v = 5 }
readV = { |o| o v }
first = readV value(Q)
Q setMethod("v", { 7 })
check value("cached slot read before a method", first, 5)
check value("cached slot read after a method", readV value(Q), 7)

// A name that becomes shadowed after its sends were cached
U = Object clone { tag() { "method" } }
u = U clone
readTag = { |o| o tag }
check value("cached method before a shadowing slot", readTag value(u), "method")
W = U clone { tag = "slot" }
check value("shadowing slot after caching", readTag value(W), "slot")
check value("other clones keep the method", readTag value(u), "method")

// A parameter or local named like a declared slot: assigning it in a block
// sets the variable, not the slot (native code used to set the slot)
Pth = Object clone {
    path = "slot"
    inl(path) { (true) ifTrue { path = "param" }; [path, self path] }
    blk(path) { [1] each { |x| path = "param" }; [path, self path] }
    deep(path) { [1] each { |x| [2] each { |y| path = path + "!" } }; [path, self path] }
    stored(path) { b = { path = "param" }; b value; [path, self path] }
    bparam() { [1] each { |path| path = "bp" }; self path }
    noLocal() { [1] each { |x| path = "fromblock" }; self path }
}
check value("param set in an inlined ifTrue", Pth clone inl("arg"), ["param", "slot"])
check value("param set in a block", Pth clone blk("arg"), ["param", "slot"])
check value("param set in a nested block", Pth clone deep("arg"), ["arg!", "slot"])
check value("param set in a stored block", Pth clone stored("arg"), ["param", "slot"])
check value("block param named like a slot", Pth clone bparam, "slot")
check value("no local: the block sets the slot", Pth clone noLocal, "fromblock")

"PASS: slot shadowing" println

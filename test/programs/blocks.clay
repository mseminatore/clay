// blocks.clay - Test blocks and closures

// Fibonacci using blocks
fib = { |n|
  (n < 2) ifTrue({
    n
  })
}

// Simple block test
doubler = { |x| x * 2 }

"doubler(5) = " print()
doubler value(5) println()

// Array iteration with block
arr = [10, 20, 30]
"Array elements:" println()
arr each({ |item| item println() })

// Boolean control flow with blocks
"Testing booleans:" println()
(1 == 1) ifTrue({ "1 == 1 is true" println() })
(1 == 2) ifTrue({ "1 == 2 is true (BUG!)" println() })
(1 == 2) ifFalse({ "1 == 2 is false" println() })

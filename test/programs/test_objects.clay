// test_objects.clay — Object/prototype operations

Test = Object clone({
    _p = 0
    _f = 0
    eq(a, b) {
        (a == b) ifTrue({ self _p = self _p + 1 })
        (!(a == b)) ifTrue({ self _f = self _f + 1; "FAIL" println() })
        self
    }
    done() {
        total = self _p + self _f
        (total toString() + " tests, " + self _p toString() + " passed, " + self _f toString() + " failed") println()
        (self _f > 0) ifTrue({ raise("test failures") })
        self
    }
})

// Clone with slots
P = Object clone({ x = 0; y = 0 })
Test eq(P x, 0)
Test eq(P y, 0)

// Set slots
o = Object clone({ v = 0 })
o v = 42
Test eq(o v, 42)

// Methods
M = Object clone({ add(a, b) { a + b } })
Test eq(M add(3, 4), 7)

// Prototype chain
B = Object clone({ val() { 1 } })
C = B clone({})
Test eq(C val(), 1)

// Constructor
P2 = Object clone({
    x = 0; y = 0
    init(a, b) { self x = a; self y = b }
})
p = P2 new(3, 4)
Test eq(p x, 3)
Test eq(p y, 4)

// Self
Ctr = Object clone({
    n = 0
    inc() { self n = self n + 1; self }
})
c = Ctr clone({})
c inc(); c inc()
Test eq(c n, 2)

Test done()

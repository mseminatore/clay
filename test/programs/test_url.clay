// Test clay-url brick
import("stdlib/url")

// Test parse
// failures are counted, and the program exits 1 if there were any
TestFails = Object clone {
    count = 0
    fail(msg) {
        msg println
        self count = self count + 1
    }
}

parts = Url parse("https://example.com:8080/path/to/resource?key=val&x=1#section")
(parts get("protocol") == "https") ifTrue { "PASS: protocol" println } ifFalse { TestFails fail(("FAIL: protocol = " + parts get("protocol"))) }
(parts get("host") == "example.com") ifTrue { "PASS: host" println } ifFalse { TestFails fail(("FAIL: host = " + parts get("host"))) }
(parts get("port") == "8080") ifTrue { "PASS: port" println } ifFalse { TestFails fail(("FAIL: port = " + parts get("port"))) }
(parts get("path") == "/path/to/resource") ifTrue { "PASS: path" println } ifFalse { TestFails fail(("FAIL: path = " + parts get("path"))) }
(parts get("query") == "key=val&x=1") ifTrue { "PASS: query" println } ifFalse { TestFails fail(("FAIL: query = " + parts get("query"))) }
(parts get("fragment") == "section") ifTrue { "PASS: fragment" println } ifFalse { TestFails fail(("FAIL: fragment = " + parts get("fragment"))) }

// Test build
rebuilt = Url build(parts)
(rebuilt == "https://example.com:8080/path/to/resource?key=val&x=1#section") ifTrue { "PASS: build" println } ifFalse { TestFails fail(("FAIL: build = " + rebuilt)) }

// Test simple URL (no port, query, fragment)
simple = Url parse("http://example.com/index.html")
(simple get("protocol") == "http") ifTrue { "PASS: simple protocol" println } ifFalse { TestFails fail("FAIL: simple protocol") }
(simple get("host") == "example.com") ifTrue { "PASS: simple host" println } ifFalse { TestFails fail("FAIL: simple host") }
(simple get("path") == "/index.html") ifTrue { "PASS: simple path" println } ifFalse { TestFails fail("FAIL: simple path") }

// Test encodeComponent
encoded = Url encodeComponent("hello world&foo=bar")
(encoded == "hello%20world%26foo%3Dbar") ifTrue { "PASS: encodeComponent" println } ifFalse { TestFails fail(("FAIL: encodeComponent = " + encoded)) }

// Test decodeComponent
(Url decodeComponent("hello%20world") == "hello world") ifTrue { "PASS: decodeComponent" println } ifFalse { TestFails fail("FAIL: decodeComponent") }

// Test parseQuery
params = Url parseQuery("name=Clay&version=1&lang=en")
(params get("name") == "Clay") ifTrue { "PASS: parseQuery name" println } ifFalse { TestFails fail("FAIL: parseQuery name") }
(params get("version") == "1") ifTrue { "PASS: parseQuery version" println } ifFalse { TestFails fail("FAIL: parseQuery version") }
(params get("lang") == "en") ifTrue { "PASS: parseQuery lang" println } ifFalse { TestFails fail("FAIL: parseQuery lang") }

(TestFails count > 0) ifTrue {
    ((TestFails count) toString + " failed") println
    System exit(1)
}

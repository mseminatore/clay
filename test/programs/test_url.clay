// Test clay-url brick
import("clay-stdlib/clay-url")

// Test parse
parts = Url parse("https://example.com:8080/path/to/resource?key=val&x=1#section")
(parts get("protocol") == "https") ifTrue { "PASS: protocol" println } ifFalse { ("FAIL: protocol = " + parts get("protocol")) println }
(parts get("host") == "example.com") ifTrue { "PASS: host" println } ifFalse { ("FAIL: host = " + parts get("host")) println }
(parts get("port") == "8080") ifTrue { "PASS: port" println } ifFalse { ("FAIL: port = " + parts get("port")) println }
(parts get("path") == "/path/to/resource") ifTrue { "PASS: path" println } ifFalse { ("FAIL: path = " + parts get("path")) println }
(parts get("query") == "key=val&x=1") ifTrue { "PASS: query" println } ifFalse { ("FAIL: query = " + parts get("query")) println }
(parts get("fragment") == "section") ifTrue { "PASS: fragment" println } ifFalse { ("FAIL: fragment = " + parts get("fragment")) println }

// Test build
rebuilt = Url build(parts)
(rebuilt == "https://example.com:8080/path/to/resource?key=val&x=1#section") ifTrue { "PASS: build" println } ifFalse { ("FAIL: build = " + rebuilt) println }

// Test simple URL (no port, query, fragment)
simple = Url parse("http://example.com/index.html")
(simple get("protocol") == "http") ifTrue { "PASS: simple protocol" println } ifFalse { "FAIL: simple protocol" println }
(simple get("host") == "example.com") ifTrue { "PASS: simple host" println } ifFalse { "FAIL: simple host" println }
(simple get("path") == "/index.html") ifTrue { "PASS: simple path" println } ifFalse { "FAIL: simple path" println }

// Test encodeComponent
encoded = Url encodeComponent("hello world&foo=bar")
(encoded == "hello%20world%26foo%3Dbar") ifTrue { "PASS: encodeComponent" println } ifFalse { ("FAIL: encodeComponent = " + encoded) println }

// Test decodeComponent
(Url decodeComponent("hello%20world") == "hello world") ifTrue { "PASS: decodeComponent" println } ifFalse { "FAIL: decodeComponent" println }

// Test parseQuery
params = Url parseQuery("name=Clay&version=1&lang=en")
(params get("name") == "Clay") ifTrue { "PASS: parseQuery name" println } ifFalse { "FAIL: parseQuery name" println }
(params get("version") == "1") ifTrue { "PASS: parseQuery version" println } ifFalse { "FAIL: parseQuery version" println }
(params get("lang") == "en") ifTrue { "PASS: parseQuery lang" println } ifFalse { "FAIL: parseQuery lang" println }

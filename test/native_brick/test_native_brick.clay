// A native brick (bricks/stats: C sources built into a plugin on first use)
import("stats")

check = { |what, got, want|
    (got == want) ifFalse { raise("FAIL: " + what + ": " + got toString + " != " + want toString) }
}

check value("plugin API version", StatsNative apiVersion, 6)
check value("cflags for this platform only", StatsNative os, ((System platform) == "macos") ifTrue { 1 } ifFalse { ((System platform) == "linux") ifTrue { 2 } ifFalse { 3 } })
check value("-I@/ is a directory in the brick", StatsNative extra, 7)
check value("sum", Stats sum([1, 2, 3.5]), 6.5)
check value("nested arrays flatten", Stats sum([[1, 2], [3, 4]]), 10)
check value("mean", Stats mean([2, 4]), 3)
check value("from_floats flat", Stats doubled([1, 2, 3]), [2, 4, 6])
check value("from_floats rows", Stats doubled([1, 2, 3, 4], 2), [[2, 4], [6, 8]])
a = Stats accumulator
a add(1) add(2, 6)
check value("native data", a mean, 3)
b = Stats accumulator
check value("separate instances", b mean, 0)
check value("TypeError on a non-number", (try { Stats sum([1, "x"]) } catch { |e| e type }), "TypeError")
check value("ArgumentError", (try { StatsNative sum(5) } catch { |e| e type }), "ArgumentError")
// API version 4: binary strings cross with their length
zeros = (String chr(0)) + "ab" + (String chr(0))
check value("to_bytes counts NUL bytes", StatsNative byteCount(zeros), 4)
check value("make_bytes keeps NUL bytes", StatsNative reverseBytes(zeros), (String chr(0)) + "ba" + (String chr(0)))
check value("every byte value crosses", (StatsNative counting(256)) bytes, (0..255) toArray)
check value("an empty string crosses", StatsNative byteCount(""), 0)
check value("to_bytes refuses a non-string", (try { StatsNative byteCount(5) } catch { |e| e type }), "ArgumentError")
// API version 5: dicts
sm = StatsNative summary([1, 2, 3])
check value("dict_new makes a Dict", sm type, "Dict")
check value("dict_set values", [sm get("count"), sm get("sum"), sm get("name")], [30, 6, "stats"])
check value("dict_set replacing keeps the order", sm keys, ["count", "sum", "name"])
d = Dict new
d set("b", 2)
d set("a", nil)
d set("c", [1, 2])
check value("dict_next walks in order", StatsNative dictKeys(d), ["b", "a", "c"])
check value("dict_size, dict_has, dict_get", StatsNative dictLookup(d, "c"), [3, true, [1, 2]])
check value("a key can hold nil", StatsNative dictLookup(d, "a"), [4, true, nil])
check value("dict_set writes the caller's Dict", d get("seen"), true)
check value("a missing key", StatsNative dictLookup(d, "zz"), [4, false, nil])
check value("a non-Dict", StatsNative dictLookup([1], "a"), [0, false, nil])
check value("dictKeys refuses a non-Dict", (try { StatsNative dictKeys(5) } catch { |e| e type }), "ArgumentError")

check value("to_int: integers, floats truncated, others 0", [StatsNative toInt(-7), StatsNative toInt(2.9), StatsNative toInt(-2.9), StatsNative toInt("12"), StatsNative toInt(nil)], [-7, 2, -2, 0, 0])
check value("to_int: a float out of range", (try { StatsNative toInt(1e30) } catch { |e| e type }), "OverflowError")
// API version 6: data_size buffers
bx = StatsBox new("box")
bx hit hit
check value("data_size: a zeroed buffer per clone", bx info, ["box", 2])
check value("data_size: separate buffers", StatsBox new("other") info, ["other", 0])
freedBefore = StatsBox freed
bx = nil
check value("data_size: free_fn runs, then Clay frees the buffer", StatsBox freed, freedBefore + 1)
check value("data_size: Clay's clone has no buffer", (try { (StatsBox clone) hit } catch { |e| e message }), "use StatsBox new")
check value("data_size: an older plugin's set_data replaces the buffer", (StatsAcc new add(2, 4)) mean, 3)
// API version 6: try_send / raise_value / is_error
check value("try_send: a result", StatsNative guarded([1, 2, 3], "size"), [true, 3])
check value("try_send: an error", StatsNative guarded(5, "noSuchThing") first, false)
check value("try_send: a raised error's message", StatsNative guarded({ raise("boom") }, "value"), [false, "boom"])
g0 = StatsNative guardFreed
check value("raise_value: the error goes on", (try { StatsNative rethrow({ raise("again") }) } catch { |e| e message }), "again")
check value("raise_value: after cleanup", StatsNative guardFreed, g0 + 1)
NonLocal = Object clone { run() { StatsNative rethrow({ return 5 }); 99 } }
check value("a non-local return passes through try_send", NonLocal run, 5)
check value("a break passes through (not is_error)", StatsNative guarded({ break }, "value"), nil)
check value("cleanup ran for both", StatsNative guardFreed, g0 + 3)

// type: a plugin object is named after its prototype, or the wrapper cloned from it
check value("plugin prototype type", StatsAcc type, "StatsAcc")
check value("plugin object type", Stats accumulator type, "StatsAcc")
check value("plain plugin prototype type", StatsNative type, "StatsNative")
check value("wrapper prototype type", Tally type, "Tally")
check value("wrapper object type", Tally new type, "Tally")
check value("wrapper keeps the C methods", Tally meanOf(4), 4)
"native brick ok" println

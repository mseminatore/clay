{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Clay",
  "scopeName": "source.clay",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#block-params" },
    { "include": "#method-definition" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.clay",
          "match": "//.*$"
        },
        {
          "name": "comment.block.clay",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.clay",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.clay",
              "match": "\\\\[nrt\\\\\"0]"
            },
            {
              "name": "meta.embedded.expression.clay",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.clay" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.clay" }
              },
              "patterns": [
                { "include": "source.clay" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.clay",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.clay",
          "match": "\\b(try|catch|raise|import)\\b"
        },
        {
          "name": "variable.language.self.clay",
          "match": "\\bself\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.clay",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.clay",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.nil.clay",
          "match": "\\bnil\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.class.clay",
          "match": "\\b(Object|Number|String|Array|Block|Boolean|Error|Dict|Nil)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.clay",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.clay",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.clay",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.clay",
          "match": "(?<![=!<>])=(?!=)"
        }
      ]
    },
    "block-params": {
      "patterns": [
        {
          "name": "meta.block.parameters.clay",
          "begin": "\\{\\s*(\\|)",
          "end": "(\\|)",
          "beginCaptures": {
            "1": { "name": "punctuation.separator.parameters.clay" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.separator.parameters.clay" }
          },
          "patterns": [
            {
              "name": "variable.parameter.clay",
              "match": "[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "name": "punctuation.separator.comma.clay",
              "match": ","
            }
          ]
        }
      ]
    },
    "method-definition": {
      "patterns": [
        {
          "name": "meta.method.clay",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.clay" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "meta.function-call.clay",
          "match": "(?<=\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.clay" }
          }
        },
        {
          "name": "meta.message-send.clay",
          "match": "(?<=\\s)([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.clay" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.type.clay",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.clay",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}

{
  "name": "clay-lang",
  "displayName": "Clay Language",
  "description": "Syntax highlighting, snippets, debugging, and language support for the Clay programming language",
  "version": "0.2.0",
  "publisher": "clay-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Debuggers"
  ],
  "contributes": {
    "languages": [
      {
        "id": "clay",
        "aliases": [
          "Clay",
          "clay"
        ],
        "extensions": [
          ".clay"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "clay",
        "scopeName": "source.clay",
        "path": "./syntaxes/clay.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "clay",
        "path": "./snippets/clay.json"
      }
    ],
    "breakpoints": [
      {
        "language": "clay"
      }
    ],
    "debuggers": [
      {
        "type": "clay",
        "label": "Clay Debug",
        "languages": ["clay"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .clay file to debug",
                "default": "${file}"
              },
              "clayPath": {
                "type": "string",
                "description": "Path to the clay executable",
                "default": "clay"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop on the first line",
                "default": false
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Clay: Launch",
            "description": "Launch and debug a Clay program",
            "body": {
              "type": "clay",
              "request": "launch",
              "name": "Debug Clay Program",
              "program": "^\"\\${file}\"",
              "clayPath": "clay"
            }
          }
        ],
        "initialConfigurations": [
          {
            "type": "clay",
            "request": "launch",
            "name": "Debug Clay Program",
            "program": "${file}",
            "clayPath": "clay"
          }
        ],
        "capabilities": {
          "supportsConditionalBreakpoints": true,
          "supportsHitConditionalBreakpoints": true,
          "supportsEvaluateForHovers": true
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}

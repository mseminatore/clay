//
// HTTP Server Demo
//
// Run with:  clay server_demo.clay
// Then visit: http://localhost:8080/
//

// Simple server using the low-level Http serve() API
// For routing, use the clay-http-server brick instead.

counter = 0

Http serve(8080, { |req|
    method = req method()
    path = req path()
    (method + " " + path) println()

    (path == "/") ifTrue {
        counter = counter + 1
        body = "<html><body>"
        body = body + "<h1>Hello from Clay!</h1>"
        body = body + "<p>You are visitor #" + counter toString() + "</p>"
        body = body + "<p><a href='/about'>About</a> | <a href='/api/time'>API</a></p>"
        body = body + "</body></html>"
        Http response(200, body)
    } ifFalse {
        (path == "/about") ifTrue {
            Http response(200, "<html><body><h1>About</h1><p>A Clay HTTP server.</p></body></html>")
        } ifFalse {
            (path == "/api/time") ifTrue {
                Http jsonResponse(200, "{\"time\": \"" + Date now() toString() + "\"}")
            } ifFalse {
                Http response(404, "Not Found: " + path)
            }
        }
    }
})

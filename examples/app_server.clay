import("stdlib/http-server")
import("stdlib/template")
import("stdlib/orm")

// -- A simple todo list web app built with Clay, demonstrating URL routing, template rendering,
// SQLite persistence, and the POST-Redirect-GET pattern. --

// -- Config --
port = 8080

// -- Database setup --
db = Db open("todos.db")
db exec("CREATE TABLE IF NOT EXISTS todos (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, done INTEGER DEFAULT 0)")
Todo = Model define(db, "todos", ["title", "done"])

// -- Layout template --
layout = "<!DOCTYPE html>" +
    "<html><head><meta charset='utf-8'>" +
    "<meta name='viewport' content='width=device-width, initial-scale=1'>" +
    "<title>{{page_title}} - Clay Todo App</title>" +
    "<link rel='stylesheet' href='https://www.w3schools.com/w3css/4/w3.css'>" +
    "<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css'>" +
    "</head><body>" +
    "<div class='w3-bar w3-dark-grey'>" +
    "<a href='/' class='w3-bar-item w3-button'><i class='fa fa-home'></i> Home</a>" +
    "<a href='/todos' class='w3-bar-item w3-button'><i class='fa fa-list'></i> Todos</a>" +
    "<a href='/todos/new' class='w3-bar-item w3-button'><i class='fa fa-plus'></i> Add Todo</a>" +
    "</div>" +
    "<div class='w3-container' style='max-width:800px;margin:auto;padding-top:20px'>" +
    "{{content}}" +
    "</div></body></html>"

// -- Helper to render a page --
renderPage = { |title, content|
    d = Dict clone
    d set("page_title", title)
    d set("content", content)
    Template render(layout, d)
}

// -- Item templates --
todoItem = "<li class='w3-display-container' style='{{style}}'>" +
    "<form method='POST' action='/todos/{{id}}/toggle' style='display:inline'>" +
    "<button type='submit' class='w3-button w3-small' style='border:none;background:none'>" +
    "<i class='fa-regular {{icon}} w3-text-blue'></i></button></form> " +
    "{{title}}" +
    "<form method='POST' action='/todos/{{id}}/delete' style='display:inline'>" +
    "<button type='submit' class='w3-button w3-display-right w3-text-red' style='border:none;background:none'>" +
    "<i class='fa fa-trash'></i></button></form></li>"

jsonItem = "{\"id\":{{id}},\"title\":\"{{title}}\",\"done\":{{done}}}"

// -- Server setup --
server = HttpServer new(port)
server logging(true)

// Home page
server get("/", { |req|
    content = "<h1><i class='fa fa-cube'></i> Clay Todo App</h1>" +
        "<p class='w3-large'>A simple todo list built with " +
        "<strong>Clay</strong>, demonstrating:</p>" +
        "<ul class='w3-ul w3-border w3-card-4' style='max-width:500px'>" +
        "<li><i class='fa fa-route'></i> URL routing with :params</li>" +
        "<li><i class='fa fa-file-code'></i> Template rendering</li>" +
        "<li><i class='fa fa-database'></i> SQLite + ORM persistence</li>" +
        "<li><i class='fa fa-arrows-rotate'></i> POST-Redirect-GET pattern</li>" +
        "<li><i class='fa fa-palette'></i> W3.CSS + Font Awesome styling</li>" +
        "</ul>" +
        "<br><a href='/todos' class='w3-button w3-blue w3-round-large'>" +
        "<i class='fa fa-arrow-right'></i> View Todos</a>"
    server html(200, renderPage value("Home", content))
})

// Todo list
server get("/todos", { |req|
    todos = Todo all

    content = "<h2><i class='fa fa-list-check'></i> Todo List</h2>"

    (todos size == 0) ifTrue {
        content = content +
            "<p class='w3-panel w3-pale-yellow w3-border w3-border-yellow'>" +
            "<i class='fa fa-info-circle'></i> No todos yet. " +
            "<a href='/todos/new'>Add one!</a></p>"
    }

    (todos size > 0) ifTrue {
        items = todos map { |todo|
            d = Dict clone
            d set("id", todo _data get("id") toString)
            d set("title", todo _data get("title"))
            (todo _data get("done") == 1) ifTrue {
                d set("style", "text-decoration:line-through;color:#999")
                d set("icon", "fa-square-check")
            } ifFalse {
                d set("style", "")
                d set("icon", "fa-square")
            }
            d
        }
        content = content + "<ul class='w3-ul w3-border w3-card-4'>" +
            Template renderEach(todoItem, items) + "</ul>"
    }

    content = content +
        "<br><a href='/todos/new' class='w3-button w3-green w3-round-large'>" +
        "<i class='fa fa-plus'></i> Add Todo</a>"

    server html(200, renderPage value("Todos", content))
})

// Add todo form
server get("/todos/new", { |req|
    content = "<h2><i class='fa fa-plus-circle'></i> Add Todo</h2>" +
        "<form method='POST' action='/todos/add' class='w3-card-4 w3-padding' style='max-width:500px'>" +
        "<label class='w3-text-grey'><b>What needs to be done?</b></label>" +
        "<input type='text' name='title' class='w3-input w3-border w3-round' " +
        "placeholder='Buy groceries...' required autofocus>" +
        "<br><button type='submit' class='w3-button w3-blue w3-round-large'>" +
        "<i class='fa fa-save'></i> Add Todo</button> " +
        "<a href='/todos' class='w3-button w3-light-grey w3-round-large'>Cancel</a>" +
        "</form>"
    server html(200, renderPage value("Add Todo", content))
})

// POST: add todo
server post("/todos/add", { |req|
    form = server formData(req)
    title = form get("title")
    (title != nil) ifTrue {
        d = Dict clone
        d set("title", title)
        Todo create(d)
    }
    server redirect("/todos")
})

// POST: delete todo (with :id param)
server post("/todos/:id/delete", { |req|
    id = req params get("id")
    (id != nil) ifTrue {
        Todo delete(id)
    }
    server redirect("/todos")
})

// POST: toggle done (with :id param)
server post("/todos/:id/toggle", { |req|
    id = req params get("id")
    (id != nil) ifTrue {
        todo = Todo find(id)
        (todo != nil) ifTrue {
            d = Dict clone
            (todo _data get("done") == 1) ifTrue {
                d set("done", 0)
            } ifFalse {
                d set("done", 1)
            }
            Todo update(id, d)
        }
    }
    server redirect("/todos")
})

// JSON API
server get("/api/todos", { |req|
    todos = Todo all
    items = todos map { |todo|
        d = Dict clone
        d set("id", todo _data get("id") toString)
        d set("title", todo _data get("title"))
        d set("done", todo _data get("done") toString)
        d
    }
    server json(200, "[" + Template renderEach(jsonItem, items, ",") + "]")
})

"Starting Clay Todo App..." println
"Running on http://localhost:${port}" println

server start

// Full collections test
import("stdlib/collections")

"=== Set ===" println
s = Set new
s add(1)
s add(2)
s add(3)
s toString println
s2 = Set from([3, 4, 5])
s2 toString println
("union: " + s union(s2) toString) println
("intersection: " + s intersection(s2) toString) println
("difference: " + s difference(s2) toString) println

"=== Stack ===" println
stack = Stack new
stack push(10)
stack push(20)
("peek: " + stack peek toString) println
("pop: " + stack pop toString) println

"=== Queue ===" println
q = Queue new
q enqueue("a")
q enqueue("b")
("dequeue: " + q dequeue) println

"=== Range ===" println
(1..5) each { |i| (i toString + " ") print }
"" println
(1..5) map { |i| i * i } toString println
("contains 3: " + (1..5) contains(3) toString) println
("size: " + (1..5) size toString) println

"all done!" println

//
// A simple 2D vector class
//
Vector2d = Object clone {
    x = 0 // Default value for x
    y = 0 // Default value for y

    init (x, y) {
        self x = x
        self y = y
    }

    add (v) {
        Vector2d new  (x + v x, y + v y)
    }

    toString () {
        "Vector2d(" + x + ", " + y + ")"
    }

    scale (factor) {
        Vector2d new (x * factor, y * factor)
    }

    magnitude () {
        Math sqrt((x * x) + (y * y))
    }
}

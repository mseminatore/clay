//
// A simple 2D vector class
//
Vector2d = Object clone {
    x = 0 // Default value for x
    y = 0 // Default value for y

    init (x, y) {
        self x = x
        self y = y
    }

    add (v) {
        Vector2d new  (x + v x, y + v y)
    }

    toString () {
        "Vector2d(" + x + ", " + y + ")"
    }

    scale (factor) {
        Vector2d new (x * factor, y * factor)
    }

    magnitude () {
        Math sqrt((x * x) + (y * y))
    }
}

// Example usage
v1 = Vector2d new (3, 4)
v1 println
v2 = Vector2d new (1, 2)
v2 println
v3 = v1 add(v2)
v3 println
v3 magnitude println // Output: 10

{ true } whileTrue {
    // This loop will run indefinitely, demonstrating the use of whileTrue
}
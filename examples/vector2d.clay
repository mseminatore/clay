//
// A simple 2D vector class
//
Vector2d = Object clone {
    x = 0 // Default value for x
    y = 0 // Default value for y

    init (x, y) {
        self x = x
        self y = y
    }

    add (other) {
        Vector2d new  (x + other x, y + other y)
    }

    toString () {
        "Vector2d(" + x + ", " + y + ")"
    }

    scale (factor) {
        Vector2d new (x * factor, y * factor)
    }

    magnitude () {
        Math sqrt((x * x) + (y * y))
    }
}

// Example usage
v1 = Vector2d new (3, 4)
v1 toString println // Output: Vector2d(3, 4)
v2 = Vector2d new (1, 2)
v2 toString println // Output: Vector2d(1, 2)
v3 = v1 add(v2)
v3 toString println // Output: Vector2d(4, 6)
v4 = v1 scale(2)
v4 toString println // Output: Vector2d(6, 8)
v4 magnitude println // Output: 10
// clay-test — A simple testing framework for Clay
//
// Usage:
//   import("clay-test")
//
//   Test describe("Math", {
//       Test it("adds numbers", {
//           Test assertEqual(1 + 1, 2)
//       })
//   })
//
//   Test run()

Test = Object clone({
    _passed = 0
    _failed = 0
    _errors = ""
    _suite = ""
    _green = "\x1b[32m"
    _red = "\x1b[91m"
    _bold = "\x1b[1m"
    _cyan = "\x1b[36m"
    _dim = "\x1b[2m"
    _reset = "\x1b[0m"

    describe(name, block) {
        self _suite = name
        (self _bold + self _cyan + "  " + name + self _reset) println()
        block value()
        self _suite = ""
        self
    }

    it(name, block) {
        result = try({
            block value()
            "pass"
        }) catch({ |e|
            self _failed += 1
            self _errors = self _errors + "    " + self _red + "FAIL: " + self _suite + " > " + name + " — " + e message() + self _reset + "\n"
            "fail"
        })
        (result == "pass") ifTrue({
            self _passed += 1
            ("    " + self _green + "✓" + self _reset + self _dim + " " + name + self _reset) println()
        })
        (result == "fail") ifTrue({
            ("    " + self _red + "✗ " + name + self _reset) println()
        })
        self
    }

    assertEqual(actual, expected) {
        (actual == expected) ifFalse({
            raise("expected " + expected + " but got " + actual)
        })
        self
    }

    assertNotEqual(actual, expected) {
        (actual == expected) ifTrue({
            raise("expected values to differ but both are " + actual)
        })
        self
    }

    assertTrue(value) {
        (value == false) ifTrue({
            raise("expected true but got false")
        })
        self
    }

    assertFalse(value) {
        (value == true) ifTrue({
            raise("expected false but got true")
        })
        self
    }

    assertRaises(block) {
        caught = try({
            block value()
            "no error"
        }) catch({ |e|
            "caught"
        })
        (caught == "no error") ifTrue({
            raise("expected an error but none was raised")
        })
        self
    }

    run() {
        "" println()
        total = self _passed + self _failed
        color = self _green
        (self _failed > 0) ifTrue({ color = self _red })
        (color + "" + total + " tests, " + self _passed + " passed, " + self _failed + " failed" + self _reset) println()
        (self _failed > 0) ifTrue({
            "" println()
            (self _red + "Failures:" + self _reset) println()
            self _errors print()
        })
        self
    }
})

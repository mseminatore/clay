import("clay-iter")

pass = 0
fail = 0
check = { |name, a, b|
    (a == b) ifTrue({ pass = pass + 1 })
    (!(a == b)) ifTrue({
        fail = fail + 1
        ("FAIL: " + name + " got " + a toString() + " expected " + b toString()) println()
    })
}

// from + toArray
r1 = Iter from([1, 2, 3]) toArray()
check value("from", r1 toString(), "[1, 2, 3]")

// range
r2 = Iter range(1, 5) toArray()
check value("range", r2 toString(), "[1, 2, 3, 4]")

// map
r3 = Iter from([1, 2, 3]) map({ |x| x * 2 }) toArray()
check value("map", r3 toString(), "[2, 4, 6]")

// filter
r4 = Iter from([1, 2, 3, 4, 5]) filter({ |x| x > 3 }) toArray()
check value("filter", r4 toString(), "[4, 5]")

// take
r5 = Iter from([1, 2, 3, 4, 5]) take(3) toArray()
check value("take", r5 toString(), "[1, 2, 3]")

// skip
r6 = Iter from([1, 2, 3, 4, 5]) skip(2) toArray()
check value("skip", r6 toString(), "[3, 4, 5]")

// chained
r7 = Iter from([1, 2, 3, 4, 5]) map({ |x| x * 2 }) filter({ |x| x > 4 }) toArray()
check value("chain", r7 toString(), "[6, 8, 10]")

// reduce
r8 = Iter from([1, 2, 3]) reduce(0, { |acc, x| acc + x })
check value("reduce", r8, 6)

// first
r9 = Iter from([10, 20, 30]) first()
check value("first", r9, 10)

// count
r10 = Iter from([1, 2, 3, 4]) filter({ |x| x > 2 }) count()
check value("count", r10, 2)

(pass toString() + " passed, " + fail toString() + " failed") println()

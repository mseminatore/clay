// test_example.clay -- Demonstrates the clay-test testing framework
//
// To run:
//   cd examples/bricks
//   clay bricks init
//   (manually copy clay-test into bricks/ or add it)
//   clay test_example.clay

import("clay-test")

"Running Clay Test Suite" println()
"========================" println()

Test describe("Number", {
    Test it("adds integers", {
        Test assertEqual(2 + 3, 5)
    })

    Test it("subtracts", {
        Test assertEqual(10 - 4, 6)
    })

    Test it("multiplies", {
        Test assertEqual(6 * 7, 42)
    })

    Test it("divides", {
        Test assertEqual(20 / 5, 4)
    })

    Test it("computes modulo", {
        Test assertEqual(17 % 5, 2)
    })
})

Test describe("String", {
    Test it("concatenates", {
        Test assertEqual("hello" + " " + "world", "hello world")
    })

    Test it("reports length", {
        Test assertEqual("Clay" length(), 4)
    })

    Test it("converts to uppercase", {
        Test assertEqual("hello" upper(), "HELLO")
    })

    Test it("contains substring", {
        Test assertTrue("hello world" contains("world"))
    })

    Test it("does not contain missing substring", {
        Test assertFalse("hello" contains("xyz"))
    })
})

Test describe("Array", {
    Test it("reports size", {
        Test assertEqual([1, 2, 3] size(), 3)
    })

    Test it("accesses first and last", {
        a = [10, 20, 30]
        Test assertEqual(a first(), 10)
        Test assertEqual(a last(), 30)
    })

    Test it("maps values", {
        a = [1, 2, 3]
        doubled = a map({ |x| x * 2 })
        Test assertEqual(doubled at(0), 2)
        Test assertEqual(doubled at(1), 4)
        Test assertEqual(doubled at(2), 6)
    })

    Test it("filters values", {
        a = [1, 2, 3, 4, 5, 6]
        evens = a filter({ |x| x % 2 == 0 })
        Test assertEqual(evens size(), 3)
        Test assertEqual(evens first(), 2)
    })
})

Test describe("Error handling", {
    Test it("catches raised errors", {
        Test assertRaises({ raise("boom") })
    })

    Test it("catches division by zero", {
        Test assertRaises({ 1 / 0 })
    })
})

Test run()

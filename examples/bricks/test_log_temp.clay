import("clay-log")

// Test basic logging
"-- default (info level) --" println()
Log debug("should not show")
Log info("hello info")
Log warn("hello warn")
Log error("hello error")

"-- debug level --" println()
Log level("debug")
Log debug("now shows")
Log info("still shows")

"-- error level --" println()
Log level("error")
Log info("hidden")
Log warn("hidden")
Log error("only errors")

"-- with prefix --" println()
Log level("info")
Log prefix("[app]")
Log info("with prefix")
Log warn("warning with prefix")

"DONE" println()

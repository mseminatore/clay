import("clay-json")

pass = 0
fail = 0

check = { |name, a, b|
    (a == b) ifTrue({ pass = pass + 1 })
    (!(a == b)) ifTrue({
        fail = fail + 1
        ("FAIL: " + name + " got " + a toString() + " expected " + b toString()) println()
    })
}

// Parse primitives
check value("parse int", Json parse("42"), 42)
check value("parse neg", Json parse("-7"), -7)
check value("parse true", Json parse("true"), true)
check value("parse false", Json parse("false"), false)
check value("parse null", Json parse("null"), nil)

// Parse string
check value("parse string", Json parse("\"hello\""), "hello")

// Parse array
arr = Json parse("[1, 2, 3]")
check value("array size", arr size(), 3)
check value("array[0]", arr at(0), 1)
check value("array[2]", arr at(2), 3)

// Parse object
obj = Json parse("{\"a\": 1, \"b\": \"hi\"}")
check value("object.a", obj get("a"), 1)
check value("object.b", obj get("b"), "hi")

// Parse nested
nested = Json parse("{\"arr\": [10, 20], \"obj\": {\"x\": true}}")
check value("nested arr", nested get("arr") at(1), 20)
check value("nested obj", nested get("obj") get("x"), true)

// Stringify
d = Dict new()
d set("name", "Clay")
s = Json stringify(d)
check value("stringify contains", s contains("Clay"), true)

// Roundtrip
d2 = Dict new()
d2 set("x", 42)
json = Json stringify(d2)
p = Json parse(json)
check value("roundtrip", p get("x"), 42)

// Summary
(pass toString() + " passed, " + fail toString() + " failed") println()

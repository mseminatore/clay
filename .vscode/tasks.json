{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build All",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build"],
            "dependsOn": "CMake: Configure",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "${workspaceFolder}/build/test_runner",
            "windows": {
                "command": "${workspaceFolder}/build/Debug/test_runner.exe"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Build All"
        },
        {
            "label": "Run Current .clay File",
            "type": "shell",
            "command": "${workspaceFolder}/build/clay",
            "windows": {
                "command": "${workspaceFolder}/build/Debug/clay.exe"
            },
            "args": ["${file}"],
            "group": "build",
            "problemMatcher": {
                "owner": "clay",
                "fileLocation": ["relative", "${fileDirname}"],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+): error: (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            },
            "presentation": {
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "Compile Current .clay to Native",
            "type": "shell",
            "command": "${workspaceFolder}/build/clay",
            "windows": {
                "command": "${workspaceFolder}/build/Debug/clay.exe"
            },
            "args": ["-c", "${file}"],
            "group": "build",
            "problemMatcher": {
                "owner": "clay",
                "fileLocation": ["relative", "${fileDirname}"],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+): error: (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Compile .clay to C Only",
            "type": "shell",
            "command": "${workspaceFolder}/build/clay",
            "windows": {
                "command": "${workspaceFolder}/build/Debug/clay.exe"
            },
            "args": ["-c", "-o", "${fileDirname}/${fileBasenameNoExtension}.c", "${file}"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Launch VM REPL",
            "type": "shell",
            "command": "${workspaceFolder}/build/clay",
            "windows": {
                "command": "${workspaceFolder}/build/Debug/clay.exe"
            },
            "args": ["--vm-repl"],
            "group": "none",
            "isBackground": false,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        }
    ]
}

{
    "configurations": [
        {
            "name": "MSVC",
            "includePath": [
                "${workspaceFolder}/src/runtime",
                "${workspaceFolder}/src/compiler",
                "${workspaceFolder}/src/vm/generated",
                "${workspaceFolder}/deps/hash",
                "${workspaceFolder}/deps/testy"

// expressions: operators, literals, interpolation, ranges, dicts
a = 7
b = 2.5
c = nil
s = "q\"uote\\ \t tab ??' trigraph \x01x"
d = #{ plain: 1, "with \"quotes\"": 2, "back\\slash": 3, "??=": 4 }
r = [a + 1, a - 1, a * 2, a / 2, a % 3, a == 7, a != 7, a < 8, a > 8, a <= 7, a >= 7,
     b + 1, b * b, b / 0.5, a && b, c || a, c ?? "dflt", a ?? 0, -a, !true, (1..3) size]
f = [0.1, 1.0, 1e10, 1.5e-7, 3.0, -0.0, 123456.789]
t = "${a} and ${b + 1} and ${s length}"
[r, f, t, d size, s length] println

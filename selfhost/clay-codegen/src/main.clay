// clay-codegen -- the Clay-to-C code generator, written in Clay
//
// Usage:
//   import("../clay-codegen/src/main.clay")
//
//   p = Parser new(source, "prog.clay")
//   program = p parseProgram
//   cg = CodeGen new("prog.clay", pluginExePath)   // path: as given to the compiler
//   cSource = cg generate(program)                 // the C program, as a string
//
// A port of src/compiler/codegen.c that produces the same C, byte for byte
// (CTest clay_selfhost_codegen compares it with `clay -c` on every .clay
// file in the repository). The generated C is compiled and linked against
// the Clay runtime exactly like the output of `clay --compile`.
//
// pluginExePath: the clay executable whose plugins/ folder native programs
// load at startup (nil: none). Plugin prototype names come from
// `System pluginGlobals` (the plugins loaded into the compiler).

import("../../clay-parser/src/main.clay")

// --- C names ---

CNames = Object clone {
    reserved = nil

    setup() {
        (reserved != nil) ifTrue { return nil }
        r = #{}
        [
            // C keywords
            "auto", "break", "case", "char", "const", "continue", "default", "do",
            "double", "else", "enum", "extern", "float", "for", "goto", "if", "int",
            "long", "register", "return", "short", "signed", "sizeof", "static",
            "struct", "switch", "typedef", "union", "unsigned", "void", "volatile",
            "while", "inline", "restrict", "_Bool", "_Complex", "_Imaginary",
            "bool", "true", "false", "asm", "near", "far", "min", "max",
            // generated code
            "self", "argc", "argv", "main",
            // stdio.h
            "printf", "fprintf", "sprintf", "snprintf", "vprintf", "vfprintf",
            "vsprintf", "vsnprintf", "scanf", "fscanf", "sscanf", "fopen", "fclose",
            "freopen", "fread", "fwrite", "fgets", "fputs", "fgetc", "fputc", "getc",
            "putc", "getchar", "putchar", "gets", "puts", "ungetc", "fflush", "fseek",
            "ftell", "rewind", "fgetpos", "fsetpos", "remove", "rename", "tmpfile",
            "tmpnam", "feof", "ferror", "clearerr", "perror", "setbuf", "setvbuf",
            "stdin", "stdout", "stderr", "EOF", "FILE", "BUFSIZ", "fpos_t",
            // stdlib.h
            "malloc", "calloc", "realloc", "free", "abort", "exit", "atexit",
            "_Exit", "getenv", "system", "atoi", "atol", "atoll", "atof", "strtol",
            "strtoll", "strtoul", "strtoull", "strtod", "strtof", "strtold", "rand",
            "srand", "qsort", "bsearch", "abs", "labs", "llabs", "div", "ldiv",
            "lldiv", "mblen", "mbtowc", "wctomb", "mbstowcs", "wcstombs", "RAND_MAX",
            "EXIT_SUCCESS", "EXIT_FAILURE", "NULL", "size_t", "wchar_t", "environ",
            // string.h
            "memcpy", "memmove", "memset", "memcmp", "memchr", "strcpy", "strncpy",
            "strcat", "strncat", "strcmp", "strncmp", "strcoll", "strxfrm", "strchr",
            "strrchr", "strstr", "strspn", "strcspn", "strpbrk", "strtok", "strlen",
            "strerror", "strdup", "index", "rindex",
            // math.h
            "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "sinh", "cosh",
            "tanh", "exp", "exp2", "log", "log10", "log2", "pow", "sqrt", "ceil",
            "floor", "fabs", "fmod", "frexp", "ldexp", "modf", "round", "trunc",
            "fmin", "fmax", "hypot", "cbrt", "expm1", "log1p", "erf", "erfc",
            "lgamma", "tgamma", "gamma", "nan", "isnan", "isinf", "isfinite",
            "signbit", "copysign", "remainder", "INFINITY", "NAN", "HUGE_VAL", "j0",
            "j1", "jn", "y0", "y1", "yn",
            // setjmp.h, stdint.h, stddef.h
            "setjmp", "longjmp", "jmp_buf", "offsetof", "ptrdiff_t", "intptr_t",
            "uintptr_t", "int8_t", "int16_t", "int32_t", "int64_t", "uint8_t",
            "uint16_t", "uint32_t", "uint64_t",
            // ctype.h, time.h, errno.h, assert.h, signal.h, POSIX
            "isalpha", "isdigit", "isalnum", "isspace", "isupper", "islower",
            "ispunct", "isprint", "toupper", "tolower", "time", "clock", "difftime",
            "mktime", "localtime", "gmtime", "strftime", "asctime", "ctime", "errno",
            "assert", "signal", "raise", "read", "write", "open", "close", "select",
            "sleep", "usleep", "fork", "kill", "pipe", "dup", "link", "unlink", "stat",
            "access", "getpid", "optarg"
        ] each { |w| r set(w, true) }
        reserved = r
        nil
    }

    isReserved(name) {
        (name == "_method_self" || name == "__ret_id" || (name startsWith("__isslot_"))) ifTrue {
            return false
        }
        (reserved has(name)) ifTrue { return true }
        ((name startsWith("clay_")) || (name startsWith("CLAY_")) ||
         (name startsWith("_cv_")) || (name startsWith("_clay_"))) ifTrue { return true }
        c1 = name byteAt(1)
        c2 = name byteAt(2)
        ((name byteAt(0)) == 95 && c1 == 116 && c2 != nil && c2 >= 48 && c2 <= 57) ifTrue { return true }
        (name endsWith("_cell")) ifTrue { return true }
        ((name byteAt(0)) == 95 && c1 != nil && (c1 == 95 || (c1 >= 65 && c1 <= 90))) ifTrue { return true }
        false
    }

    // The C name of a Clay identifier: itself, or _cv_<name> if reserved
    safe(name) {
        self setup
        (self isReserved(name)) ifTrue { return "_cv_" + name }
        name
    }

    hex = "0123456789abcdef"

    // Clay name → C identifier chars: alnum and _ kept, others _xHH
    // (at most 58 characters, like the C buffer)
    mangle(s) {
        parts = []
        len = 0
        n = s length
        i = 0
        { i < n && len + 5 < 64 } whileTrue {
            c = s byteAt(i)
            ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) ifTrue {
                parts push(s slice(i, i + 1))
                len = len + 1
            } ifFalse {
                parts push("_x" + (hex at(c / 16)) + (hex at(c % 16)))
                len = len + 4
            }
            i = i + 1
        }
        parts join("")
    }

    octal(c) { "\\" + (c / 64) toString + ((c / 8) % 8) toString + (c % 8) toString }

    // The length of the valid UTF-8 sequence of 2-4 bytes at i, or 0
    // (codegen.c utf8_seq_len)
    utf8Len(s, i) {
        c = s byteAt(i)
        len = 0
        lo = 128
        hi = 191
        ((c >= 194) && (c <= 223)) ifTrue { len = 2 }
        ((c >= 224) && (c <= 239)) ifTrue {
            len = 3
            (c == 224) ifTrue { lo = 160 }
            (c == 237) ifTrue { hi = 159 }
        }
        ((c >= 240) && (c <= 244)) ifTrue {
            len = 4
            (c == 240) ifTrue { lo = 144 }
            (c == 244) ifTrue { hi = 143 }
        }
        (len == 0) ifTrue { return 0 }
        b = s byteAt(i + 1)
        ((b == nil) || (b < lo) || (b > hi)) ifTrue { return 0 }
        j = 2
        { j < len } whileTrue {
            b = s byteAt(i + j)
            ((b == nil) || (b < 128) || (b > 191)) ifTrue { return 0 }
            j = j + 1
        }
        len
    }

    // A C string literal (the value ends at a NUL, like a C string)
    cString(s) {
        parts = ["\""]
        start = 0
        n = s length
        i = 0
        { i < n } whileTrue {
            c = s byteAt(i)
            esc = nil
            (c == 34) ifTrue { esc = "\\\"" }
            (c == 92) ifTrue { esc = "\\\\" }
            (c == 10) ifTrue { esc = "\\n" }
            (c == 9) ifTrue { esc = "\\t" }
            (c == 13) ifTrue { esc = "\\r" }
            (c == 63) ifTrue { esc = "\\?" }
            skip = 1
            (c >= 128) ifTrue {
                skip = self utf8Len(s, i)
                (skip == 0) ifTrue { skip = 1; esc = self octal(c) }
            }
            (esc == nil && (c < 32 || c == 127)) ifTrue { esc = self octal(c) }
            (esc != nil) ifTrue {
                parts push(s slice(start, i))
                parts push(esc)
                start = i + 1
            }
            i = i + skip
        }
        parts push(s slice(start, n))
        parts push("\"")
        parts join("")
    }

    // The source path inside a C string: \ → /, " escaped
    pathBody(s) { (s replace("\\", "/")) replace("\"", "\\\"") }

    // Whether path is a file inside dir ('/' and '\\' alike; clay_path_under)
    isUnder(dir, path) {
        ((dir == nil) || dir == "" || path == nil) ifTrue { return false }
        d = dir replace("\\", "/")
        { (d length > 1) && (d endsWith("/")) } whileTrue { d = d slice(0, d length - 1) }
        p = path replace("\\", "/")
        (p startsWith(d + "/")) ifFalse { return false }
        rest = p slice(d length, p length)
        { rest startsWith("/") } whileTrue { rest = rest slice(1, rest length) }
        rest length > 0
    }
}

// A function to emit: a method, or a block (with the variables it captures)
FnDef = Object clone {
    funcName = ""
    objContext = nil
    node = nil
    captures = nil
    cloneSlots = nil
    cloneMembers = nil      // its clone body's slot and method names
    inMethodCtx = false
    loopOwner = false       // a block literal passed to a message (fnLoopOwner)

    make(fname, ctx, n, caps, inCtx) {
        d = self clone
        d funcName = fname
        d objContext = ctx
        d node = n
        d captures = caps
        d inMethodCtx = inCtx
        d
    }
}

// An inlined ifTrue/ifFalse body being emitted (codegen.c InlineScope)
InlineScope = Object clone {
    outer = nil
    dest = nil              // receives the body's value (owned), or nil
    vars = nil              // owned C variables declared for the body
    cells = nil             // cells made for the body
    label = ""              // end of the body (a top-level block's `return`)
    labelUsed = false
}

// An inlined whileTrue/whileFalse whose body is being emitted (InlineLoop)
InlineLoop = Object clone {
    scope = nil             // the inlined body outside the loop
    tempMark = 0            // owned temps from here are the body's statements'
    id = 0
    contUsed = false
}

// --- the code generator ---

CodeGen = Object clone {
    out = nil              // chunks of C text being written
    sourceFile = ""
    pluginExePath = nil
    pluginGlobals = nil
    nativePlugins = nil     // native bricks linked in (codegen.c native_plugins)
    indent = 1
    tempCounter = 0
    inMethod = false
    locals = nil
    methodLocalBase = 0
    toplevelCount = 0
    toplevelFiles = nil     // top-level variable name -> the files that assign it
    sourceFiles = nil       // the program's source files (codegen.c files)
    boxed = nil
    knownSlots = nil
    knownMembers = nil      // slot and method names of the enclosing clone body
    ownedTemps = nil
    tempBase = 0            // statement cleanup releases owned temps from here
    inlineScope = nil       // innermost inlined ifTrue/ifFalse body
    inlineLoop = nil        // inlined loop whose body is being emitted
    prewalkDepth = 0        // prewalk inside a method or block body
    inFunction = false
    useSlotRecv = false
    fnIsBlock = false
    fnHasRetFrame = false
    fnLoopOwner = false     // ... of a block passed to a message: break ends that call,
                            // continue this run (isLoopArg)
    nextLoopOwner = false   // the block about to be emitted is passed to a message
    fnVars = nil
    fnCells = nil
    superProto = nil
    collected = nil
    methodCtx = false      // emitting a method, or a block created inside one
    nameOrder = nil        // pre-assigned function names, in registration order
    nameCounter = 0

    builtins = #{
        "Object": "CLAY_VAL(clay_Object)", "Number": "CLAY_VAL(clay_Number)",
        "String": "CLAY_VAL(clay_String)", "Array": "CLAY_VAL(clay_Array)",
        "Block": "CLAY_VAL(clay_Block)", "Nil": "CLAY_VAL(clay_Nil)",
        "Boolean": "CLAY_VAL(clay_Boolean)", "Error": "CLAY_VAL(clay_Error)",
        "Dict": "CLAY_VAL(clay_Dict)", "Math": "CLAY_VAL(clay_Math)",
        "Console": "CLAY_VAL(clay_Console)", "File": "CLAY_VAL(clay_File)",
        "System": "CLAY_VAL(clay_System)", "FFI": "CLAY_VAL(clay_FFI)",
        "Date": "CLAY_VAL(clay_Date)", "Http": "CLAY_VAL(clay_Http)",
        "Regex": "CLAY_VAL(clay_Regex)", "Fiber": "CLAY_VAL(clay_Fiber)",
        "Db": "CLAY_VAL(clay_Db)", "Graphics": "CLAY_VAL(clay_Graphics)",
        "Range": "CLAY_VAL(clay_Range)", "Vec3": "CLAY_VAL(clay_Vec3)",
        "Thread": "CLAY_VAL(clay_Thread)", "Socket": "CLAY_VAL(clay_Socket)", "VM": "CLAY_VAL(clay_VM)",
        "Crypto": "CLAY_VAL(clay_Crypto)", "Process": "CLAY_VAL(clay_Process)",
        "true": "CLAY_TRUE", "false": "CLAY_FALSE", "nil": "CLAY_NIL"
    }

    init(source, pluginExe = nil, plugins = nil) {
        out = []
        sourceFile = source
        sourceFiles = []
        pluginExePath = pluginExe
        pluginGlobals = plugins ?? (System pluginGlobals)
        indent = 1
        tempCounter = 0
        inMethod = false
        locals = []
        methodLocalBase = 0
        toplevelCount = 0
        toplevelFiles = #{}
        boxed = []
        knownSlots = nil
        knownMembers = nil
        ownedTemps = []
        tempBase = 0
        inlineScope = nil
        inlineLoop = nil
        prewalkDepth = 0
        inFunction = false
        useSlotRecv = false
        fnIsBlock = false
        fnHasRetFrame = false
        fnLoopOwner = false
        nextLoopOwner = false
        fnVars = []
        fnCells = []
        superProto = nil
        collected = []
        methodCtx = false
        nameOrder = []
        nameCounter = 0
    }

    // --- output ---

    w(s) { out push(s) }
    ind() { out push("    " repeat(indent)) }
    line(s) {
        self ind
        out push(s + "\n")
    }
    safe(n) { CNames safe(n) }

    // codegen.c emit_line: in a program of several files, also set
    // clay_source_file from the clay_files[] table
    emitLine(n) {
        f = n file ?? sourceFile
        out push("#line " + n line toString + " \"" + (CNames pathBody(f)) + "\"\n")
        at = "clay_source_line = " + n line toString + ";"
        fi = (sourceFiles size > 1) ifTrue { sourceFiles indexOf(f) } ifFalse { -1 }
        (fi >= 0) ifTrue { at = at + " clay_source_file = clay_files[" + fi toString + "];" }
        self line(at)
    }

    tempName() {
        t = "_t" + tempCounter toString
        tempCounter = tempCounter + 1
        t
    }

    // (an error or non-local return unwinding past the statement releases it)
    pushOwnedTemp(t) {
        ownedTemps push(t)
        self line("clay_uw_temp(&" + t + ");")
    }
    isOwnedTemp(t) { ownedTemps contains(t) }

    // release owned temps [from, end) except resultTemp, and drop them
    tempCleanupFrom(from, resultTemp) {
        i = from
        { i < ownedTemps size } whileTrue {
            t = ownedTemps at(i)
            (t != resultTemp) ifTrue { self line("clay_release_val(" + t + ");") }
            i = i + 1
        }
        (ownedTemps size > from) ifTrue { self line("clay_uw_drop(" + (ownedTemps size - from) toString + ");") }
        ownedTemps = ownedTemps slice(0, from)
    }
    tempCleanup(resultTemp) { self tempCleanupFrom(tempBase, resultTemp) }

    // a line with at least one level of indent (declarations at a function's
    // start are written before its body's indent is set)
    fnLine(s) {
        (indent < 1) ifTrue { out push("    " + s + "\n") } ifFalse { self line(s) }
    }

    // fn_track_var / fn_track_cell: released on return, and registered for
    // unwinding (an error, break or non-local return passing through)
    trackVar(n) {
        inFunction ifTrue {
            fnVars push(n)
            self fnLine("clay_uw_var(&" + (self safe(n)) + ");")
        }
    }
    trackCell(n) {
        (inFunction && indent <= 1) ifTrue {
            fnCells push(n)
            self fnLine("clay_uw_cell(&" + (self safe(n)) + "_cell);")
        }
    }

    retains(v, n) {
        i = 0
        { i < n } whileTrue {
            self line("clay_retain_val(" + v + ");")
            i = i + 1
        }
    }
    rvSet(v) { self line("clay_release_val(__rv); __rv = " + v + ";") }

    functionReleases() {
        self line("clay_uw_reset(__uw);")
        fnVars each { |v| self line("clay_release_val(" + (self safe(v)) + ");") }
        fnCells each { |c| self line("clay_cell_release(" + (self safe(c)) + "_cell);") }
    }

    functionExit() {
        self functionReleases
        fnHasRetFrame ifTrue { self line("clay_try_pop();") }
        fnIsBlock ifTrue {
            self line("return clay_return_value(__rv, CLAY_VAL(self), 0, NULL);")
        } ifFalse {
            self line("return clay_return_value(__rv, CLAY_VAL(self), argc, argv);")
        }
    }

    // --- scopes ---

    isLocal(n) { locals contains(n) }

    isToplevelVar(n) {
        found = false
        i = 0
        { i < locals size } whileTrue {
            (locals at(i) == n) ifTrue {
                (i >= toplevelCount) ifTrue { return false }
                found = true
            }
            i = i + 1
        }
        found
    }

    // assigned at the top level of `file`: a top-level block's assignment
    // writes a top-level variable only when its own file has it
    toplevelInFile(n, file) {
        files = toplevelFiles get(n)
        files != nil && (files contains(file))
    }

    isFnLocal(n) { (self isLocal(n)) && ((methodCtx && (self isToplevelVar(n))) == false) }

    isMethodLocal(n) {
        i = methodLocalBase
        { i < locals size } whileTrue {
            (locals at(i) == n) ifTrue { return true }
            i = i + 1
        }
        false
    }

    isBoxed(n) { boxed contains(n) }
    isKnownSlot(n) { knownSlots != nil && (knownSlots contains(n)) }
    isKnownMember(n) { knownMembers != nil && (knownMembers contains(n)) }

    // foo(args): does foo resolve to a slot or method of self (ident's
    // clay_get_slot cases)? Then it's `self foo(args)`, else `foo value(args)`
    // (call_targets_self in codegen.c)
    callTargetsSelf(nm) {
        (self hasSlotFlag(nm)) ifTrue { return false }
        (inMethod && methodCtx && (self isKnownMember(nm)) && (self isFnLocal(nm)) == false &&
         (self isBoxed(nm)) == false) ifTrue { return true }
        ((self isBoxed(nm)) || (self isLocal(nm)) || (self isBuiltinGlobal(nm))) ifTrue { return false }
        inMethod
    }

    isBuiltinGlobal(n) { (builtins has(n)) || (pluginGlobals contains(n)) }
    builtinExpr(n) {
        e = builtins get(n)
        (e != nil) ifTrue { return e }
        (pluginGlobals contains(n)) ifTrue { return "CLAY_VAL(clay_plugin_get_global(\"" + n + "\"))" }
        n
    }

    // implicit-slot flags
    flagName(n) { "__isslot_" + n }
    hasSlotFlag(n) { self isLocal(self flagName(n)) }
    flagExpr(n) {
        f = self flagName(n)
        (self isBoxed(f)) ifTrue { return f + "_cell->value" }
        f
    }
    methodSelfExpr() {
        (self isBoxed("_method_self")) ifTrue { return "CLAY_OBJ(_method_self_cell->value)" }
        useSlotRecv ifTrue { return "__recv" }
        "self"
    }
    localReadExpr(n) {
        (self isBoxed(n)) ifTrue { return (self safe(n)) + "_cell->value" }
        self safe(n)
    }

    // --- non-local return analysis (ast.c) ---

    returnWalkList(list, inBlock, wantInBlock) {
        list each { |n| (self returnWalk(n, inBlock, wantInBlock)) ifTrue { return true } }
        false
    }

    returnWalk(n, inBlock, wantInBlock) {
        (n == nil) ifTrue { return false }
        k = n kind
        (k == "Return") ifTrue {
            (wantInBlock == false || inBlock) ifTrue { return true }
            return self returnWalk(n expr, inBlock, wantInBlock)
        }
        (k == "Block") ifTrue { return self returnWalkList(n body, true, wantInBlock) }
        (k == "Assign") ifTrue { return self returnWalk(n value, inBlock, wantInBlock) }
        (k == "Send") ifTrue {
            // an inlined block's statements are the method's
            (self isInlineIf(n)) ifTrue {
                return (self returnWalk(n recv, inBlock, wantInBlock)) ||
                       (self returnWalkList((n items at(0)) body, inBlock, wantInBlock))
            }
            (self isInlineWhile(n)) ifTrue {
                return (self returnWalkList(n recv body, inBlock, wantInBlock)) ||
                       (self returnWalkList((n items at(0)) body, inBlock, wantInBlock))
            }
            return (self returnWalk(n recv, inBlock, wantInBlock)) ||
                   (self returnWalkList(n items, inBlock, wantInBlock))
        }
        (k == "Binary") ifTrue {
            return (self returnWalk(n left, inBlock, wantInBlock)) ||
                   (self returnWalk(n right, inBlock, wantInBlock))
        }
        (k == "Array") ifTrue { return self returnWalkList(n items, inBlock, wantInBlock) }
        (k == "DictLit") ifTrue { return self returnWalkList(n vals, inBlock, wantInBlock) }
        (k == "TryCatch") ifTrue {
            return (self returnWalk(n tryBlock, inBlock, wantInBlock)) ||
                   (self returnWalk(n catchBlock, inBlock, wantInBlock)) ||
                   (self returnWalk(n finallyBlock, inBlock, wantInBlock))
        }
        (k == "Raise") ifTrue { return self returnWalk(n expr, inBlock, wantInBlock) }
        (k == "SlotAssign") ifTrue {
            return (self returnWalk(n recv, inBlock, wantInBlock)) ||
                   (self returnWalk(n value, inBlock, wantInBlock))
        }
        (k == "Clone") ifTrue { return self returnWalk(n recv, inBlock, wantInBlock) }
        false
    }

    hasBlockReturn(body) { self returnWalkList(body, false, true) }

    // --- function names (assigned before emitting) ---

    register(n, fname) {
        n fnName = fname
        nameOrder push(fname)
    }

    prewalk(n, parentName) {
        (n == nil) ifTrue { return nil }
        k = n kind
        (k == "Block") ifTrue {
            fname = "_clay_block_" + nameCounter toString
            nameCounter = nameCounter + 1
            self register(n, fname)
            prewalkDepth = prewalkDepth + 1
            n body each { |s| self prewalk(s, fname) }
            prewalkDepth = prewalkDepth - 1
            return nil
        }
        (k == "MethodDef") ifTrue {
            fname = "_clay_method_" + (CNames mangle(parentName ?? "anon")) + "_" +
                    (CNames mangle(n name)) + "_" + nameCounter toString
            nameCounter = nameCounter + 1
            self register(n, fname)
            prewalkDepth = prewalkDepth + 1
            n body each { |s| self prewalk(s, fname) }
            prewalkDepth = prewalkDepth - 1
            return nil
        }
        (k == "Clone") ifTrue {
            self prewalk(n recv, parentName)
            n items each { |m| self prewalk(m, parentName) }
            return nil
        }
        (k == "Assign") ifTrue { return self prewalk(n value, n name) }
        (k == "Send") ifTrue {
            // an inlined loop's blocks get no functions
            (prewalkDepth > 0 && (self isInlineWhile(n))) ifTrue {
                n recv body each { |s| self prewalk(s, parentName) }
                (n items at(0)) body each { |s| self prewalk(s, parentName) }
                return nil
            }
            self prewalk(n recv, parentName)
            // an inlined block gets no function
            (prewalkDepth > 0 && (self isInlineIf(n))) ifTrue {
                (n items at(0)) body each { |s| self prewalk(s, parentName) }
                return nil
            }
            n items each { |a| self prewalk(a, parentName) }
            return nil
        }
        (k == "Binary") ifTrue {
            self prewalk(n left, parentName)
            self prewalk(n right, parentName)
            return nil
        }
        (k == "Array") ifTrue {
            n items each { |e| self prewalk(e, parentName) }
            return nil
        }
        (k == "Program") ifTrue {
            n items each { |s| self prewalk(s, nil) }
            return nil
        }
        (k == "SlotDef") ifTrue { return self prewalk(n value, parentName) }
        (k == "TryCatch") ifTrue {
            self prewalk(n tryBlock, parentName)
            self prewalk(n catchBlock, parentName)
            self prewalk(n finallyBlock, parentName)
            return nil
        }
        (k == "Raise") ifTrue { return self prewalk(n expr, parentName) }
        (k == "SlotAssign") ifTrue {
            self prewalk(n recv, parentName)
            self prewalk(n value, parentName)
            return nil
        }
        (k == "Return") ifTrue { return self prewalk(n expr, parentName) }
        (k == "DictLit") ifTrue {
            n vals each { |v| self prewalk(v, parentName) }
            return nil
        }
        nil
    }

    // --- closure captures ---

    captureSlotFlag(caps, n) {
        (self hasSlotFlag(n)) ifFalse { return nil }
        f = self flagName(n)
        (caps contains(f)) ifFalse { caps push(f) }
        ((self isLocal("_method_self")) && (caps contains("_method_self")) == false) ifTrue {
            caps push("_method_self")
        }
    }

    captureMethodSelf(caps) {
        ((self isLocal("_method_self")) && (caps contains("_method_self")) == false) ifTrue {
            caps push("_method_self")
        }
    }

    scanList(list, params, caps) { list each { |n| self scan(n, params, caps) } }

    scan(n, params, caps) {
        (n == nil) ifTrue { return nil }
        k = n kind
        (k == "Ident") ifTrue {
            nm = n name
            (self isBuiltinGlobal(nm)) ifTrue { return nil }
            (params contains(nm)) ifTrue { return nil }
            (caps contains(nm)) ifTrue { return nil }
            // a slot of the clone body is read from the method's self, even
            // when a top-level variable has the same name
            ((self isKnownMember(nm)) && (self isLocal("_method_self")) &&
             ((self isLocal(nm)) == false || (self isToplevelVar(nm)))) ifTrue {
                self captureMethodSelf(caps)
                return nil
            }
            (self isToplevelVar(nm)) ifTrue { return nil }    // uses the static
            (self isLocal(nm)) ifTrue {
                caps push(nm)
                self captureSlotFlag(caps, nm)
                return nil
            }
            self captureMethodSelf(caps)
            return nil
        }
        (k == "Block") ifTrue {
            combined = params slice(0, params size)
            n params each { |p| combined push(p name) }
            return self scanList(n body, combined, caps)
        }
        (k == "Self") ifTrue { return self captureMethodSelf(caps) }
        (k == "Send") ifTrue {
            self scan(n recv, params, caps)
            return self scanList(n items, params, caps)
        }
        (k == "Binary") ifTrue {
            self scan(n left, params, caps)
            return self scan(n right, params, caps)
        }
        (k == "Assign") ifTrue {
            self scan(n value, params, caps)
            an = n name
            ((self isBuiltinGlobal(an)) == false && (params contains(an)) == false &&
             (caps contains(an)) == false && (self isLocal(an)) && (self isToplevelVar(an)) == false) ifTrue {
                caps push(an)
                self captureSlotFlag(caps, an)
            }
            ((self isBuiltinGlobal(an)) == false && (self isLocal(an)) == false &&
             (params contains(an)) == false) ifTrue {
                self captureMethodSelf(caps)
            }
            (self isKnownSlot(an)) ifTrue { self captureMethodSelf(caps) }
            return nil
        }
        (k == "Clone") ifTrue {
            self scan(n recv, params, caps)
            return self scanList(n items, params, caps)
        }
        (k == "MethodDef") ifTrue { return self scanList(n body, params, caps) }
        (k == "SlotDef") ifTrue { return self scan(n value, params, caps) }
        (k == "Array") ifTrue { return self scanList(n items, params, caps) }
        (k == "TryCatch") ifTrue {
            self scan(n tryBlock, params, caps)
            self scan(n catchBlock, params, caps)
            return self scan(n finallyBlock, params, caps)
        }
        (k == "Raise") ifTrue { return self scan(n expr, params, caps) }
        (k == "SlotAssign") ifTrue {
            self scan(n recv, params, caps)
            return self scan(n value, params, caps)
        }
        (k == "Return") ifTrue {
            ((self isLocal("__ret_id")) && (caps contains("__ret_id")) == false) ifTrue {
                caps push("__ret_id")
            }
            return self scan(n expr, params, caps)
        }
        (k == "DictLit") ifTrue { return self scanList(n vals, params, caps) }
        nil
    }

    // --- expressions: each returns the temp holding its value (or nil) ---

    expr(n) {
        (n == nil) ifTrue { return nil }
        k = n kind
        (k == "Int") ifTrue {
            t = self tempName
            self line("ClayValue " + t + " = clay_int((intptr_t)" + n value toString + "LL);")
            return t
        }
        (k == "Float") ifTrue {
            t = self tempName
            s = n value toString
            ((s contains(".")) || (s contains("e")) || (s contains("E"))) ifFalse { s = s + ".0" }
            self line("ClayValue " + t + " = clay_float_tag(" + s + "f);")
            return t
        }
        (k == "String") ifTrue {
            t = self tempName
            self line("ClayValue " + t + " = CLAY_VAL(clay_string_new(" + (CNames cString(n value)) + "));")
            self pushOwnedTemp(t)
            return t
        }
        (k == "Ident") ifTrue { return self ident(n) }
        (k == "Self") ifTrue { return self selfExpr(n) }
        (k == "Send") ifTrue {
            (inFunction && (self isInlineIf(n))) ifTrue { return self inlineIf(n, true) }
            (inFunction && (self isInlineWhile(n))) ifTrue { return self inlineWhile(n, true) }
            return self send(n)
        }
        (k == "Binary") ifTrue { return self binary(n) }
        (k == "Block") ifTrue { return self block(n) }
        (k == "Array") ifTrue {
            t = self tempName
            self line("ClayObject *" + t + "_obj = clay_array_new();")
            n items each { |e|
                v = self expr(e)
                self line("clay_array_append(" + t + "_obj, " + (v ?? "(null)") + ");")
            }
            self line("ClayValue " + t + " = CLAY_VAL(" + t + "_obj);")
            self pushOwnedTemp(t)
            return t
        }
        (k == "DictLit") ifTrue {
            t = self tempName
            self line("ClayObject *" + t + "_obj = clay_dict_new();")
            i = 0
            { i < n keys size } whileTrue {
                v = self expr(n vals at(i))
                self line("clay_dict_set(" + t + "_obj, " + (CNames cString((n keys at(i)) value)) + ", " + (v ?? "(null)") + ");")
                i = i + 1
            }
            self line("ClayValue " + t + " = CLAY_VAL(" + t + "_obj);")
            self pushOwnedTemp(t)
            return t
        }
        (k == "TryCatch") ifTrue { return self tryCatch(n) }
        (k == "Raise") ifTrue { return self raiseExpr(n) }
        (k == "Clone") ifTrue { return self cloneExpr(n) }
        Console print("codegen: unhandled node type " + k + "\n")
        nil
    }

    // a bare name that resolves to self: `self nm`, a send (a method runs, a
    // slot is read), as the VM does (emit_self_send in codegen.c)
    selfSend(t, nm) {
        (self isBoxed("_method_self")) ifTrue {
            self line("ClayValue " + t + " = clay_self_get(_method_self_cell->value, \"" + nm + "\");")
        } ifFalse {
            self line("ClayValue " + t + " = clay_self_get(CLAY_VAL(" + (self methodSelfExpr) + "), \"" + nm + "\");")
        }
        self pushOwnedTemp(t)
        t
    }

    ident(n) {
        nm = n name
        t = self tempName
        (self hasSlotFlag(nm)) ifTrue {
            self line("ClayValue " + t + " = CLAY_IS_TRUTHY(" + (self flagExpr(nm)) + ") ? clay_get_slot(" +
                      (self methodSelfExpr) + ", \"" + nm + "\") : " + (self localReadExpr(nm)) + ";")
            return t
        }
        // a slot or method declared in the clone body wins over a top-level variable
        (inMethod && methodCtx && (self isKnownMember(nm)) && (self isFnLocal(nm)) == false &&
         (self isBoxed(nm)) == false) ifTrue {
            return self selfSend(t, nm)
        }
        (self isBoxed(nm)) ifTrue {
            self line("ClayValue " + t + " = " + (self safe(nm)) + "_cell->value;")
            return t
        }
        (self isLocal(nm)) ifTrue {
            self line("ClayValue " + t + " = " + (self safe(nm)) + ";")
            return t
        }
        (self isBuiltinGlobal(nm)) ifTrue {
            self line("ClayValue " + t + " = " + (self builtinExpr(nm)) + ";")
            return t
        }
        inMethod ifTrue {
            return self selfSend(t, nm)
        }
        self line("ClayValue " + t + " = " + (self safe(nm)) + ";")
        t
    }

    selfExpr(n) {
        inMethod ifFalse {
            Console print("codegen: 'self' used outside of method or block (line " + n line toString + ")\n")
            return nil
        }
        t = self tempName
        (self isBoxed("_method_self")) ifTrue {
            self line("ClayValue " + t + " = _method_self_cell->value;")
        } ifFalse {
            useSlotRecv ifTrue {
                self line("ClayValue " + t + " = __recv ? CLAY_VAL(__recv) : CLAY_NIL;")
            } ifFalse {
                self line("ClayValue " + t + " = CLAY_VAL(self);")
            }
        }
        t
    }

    send(n) {
        (n isCall && (self callTargetsSelf(n recv name))) ifTrue {
            me = n recv clone
            me kind = "Self"
            c = n clone
            c recv = me
            c name = n recv name
            c isCall = false
            return self send(c)
        }
        recv = self expr(n recv)
        (recv == nil) ifTrue { return nil }
        // a block literal passed here owns its break and continue
        args = []
        n items each { |a|
            nextLoopOwner = self isLoopArg(n, a)
            args push(self expr(a))
            nextLoopOwner = false
        }
        // a break in one of its blocks ends the call (nil)
        brk = (self sendCatchesBreak(n)) ifTrue { "_catch_break" } ifFalse { "" }
        t = self tempName
        self emitLine(n)
        argc = args size
        list = "{" + (args map { |a| a ?? "(null)" } join(", ")) + "}"
        (n isSuper && superProto != nil) ifTrue {
            (argc == 0) ifTrue {
                self line("ClayValue " + t + " = clay_send_super_owned" + brk + "(" + recv + ", CLAY_OBJ(" +
                          superProto + "), \"" + n name + "\", 0, NULL);")
            } ifFalse {
                self line("ClayValue " + t + " = clay_send_super_owned" + brk + "(" + recv + ", CLAY_OBJ(" +
                          superProto + "), \"" + n name + "\", " + argc toString + ", (ClayValue[])" + list + ");")
            }
        } ifFalse {
            (argc == 0) ifTrue {
                self line("ClayValue " + t + " = clay_send_owned(" + recv + ", \"" + n name + "\", 0, NULL);")
            } ifFalse {
                self line("ClayValue " + t + " = clay_send_owned" + brk + "(" + recv + ", \"" + n name + "\", " +
                          argc toString + ", (ClayValue[])" + list + ");")
            }
        }
        self pushOwnedTemp(t)
        t
    }

    // Box a local in a cell here, unless it already is: from now on the
    // function reads and writes it through `<name>_cell`
    boxLocal(nm) {
        (self isBoxed(nm)) ifTrue { return nil }
        (nm == "_method_self") ifTrue {
            self line("ClayCell *" + nm + "_cell = clay_cell_new(CLAY_VAL(self));")
        } ifFalse {
            self line("ClayCell *" + (self safe(nm)) + "_cell = clay_cell_new(" + (self safe(nm)) + ");")
        }
        boxed push(nm)
        self trackCell(nm)
    }

    // Box now the locals that blocks inside n capture. Cells are otherwise
    // made where a block is created and stay in use for the rest of the
    // function; inside a C branch (the right side of &&, || or ??) the cell
    // would go out of scope while the function still uses it.
    preboxCaptures(n) {
        (n == nil) ifTrue { return nil }
        k = n kind
        (k == "Block") ifTrue {
            caps = []
            params = n params map { |p| p name }
            n body each { |s| self scan(s, params, caps) }
            caps each { |nm| self boxLocal(nm) }
            return nil
        }
        (k == "Send") ifTrue {
            (inFunction && (self isInlineWhile(n))) ifTrue {
                n recv body each { |s| self preboxCaptures(s) }
                (n items at(0)) body each { |s| self preboxCaptures(s) }
                return nil
            }
            self preboxCaptures(n recv)
            // an inlined block's statements run in this function
            (inFunction && (self isInlineIf(n))) ifTrue {
                (n items at(0)) body each { |s| self preboxCaptures(s) }
                return nil
            }
            n items each { |a| self preboxCaptures(a) }
            return nil
        }
        (k == "Binary") ifTrue {
            self preboxCaptures(n left)
            return self preboxCaptures(n right)
        }
        (k == "Assign") ifTrue { return self preboxCaptures(n value) }
        (k == "SlotAssign") ifTrue {
            self preboxCaptures(n recv)
            return self preboxCaptures(n value)
        }
        (k == "Array") ifTrue { n items each { |a| self preboxCaptures(a) }; return nil }
        (k == "DictLit") ifTrue { n vals each { |a| self preboxCaptures(a) }; return nil }
        (k == "Clone") ifTrue {
            self preboxCaptures(n recv)
            n items each { |m| (m kind == "SlotDef") ifTrue { self preboxCaptures(m value) } }
            return nil
        }
        (k == "TryCatch") ifTrue {
            self preboxCaptures(n tryBlock)
            self preboxCaptures(n catchBlock)
            return self preboxCaptures(n finallyBlock)
        }
        (k == "Raise") ifTrue { return self preboxCaptures(n expr) }
        (k == "Return") ifTrue { return self preboxCaptures(n expr) }
        (k == "Destructure") ifTrue { return self preboxCaptures(n value) }
        nil
    }

    // a ? b : c for the three short-circuit operators
    shortCircuit(n, op) {
        self preboxCaptures(n right)
        left = self expr(n left)
        (left == nil) ifTrue { return nil }
        t = self tempName
        self emitLine(n)
        self line("ClayValue " + t + ";")
        (op == "??") ifTrue {
            self line("if (" + left + " != CLAY_NIL) {")
        } ifFalse {
            self line("if (CLAY_IS_TRUTHY(" + left + ")) {")
        }
        indent = indent + 1
        (op == "&&") ifTrue { self rightSide(n, t, false) }
        (op == "||") ifTrue { self line(t + " = CLAY_TRUE;") }
        (op == "??") ifTrue { self line(t + " = " + left + "; clay_retain_val(" + t + ");") }
        indent = indent - 1
        self line("} else {")
        indent = indent + 1
        (op == "&&") ifTrue { self line(t + " = CLAY_FALSE;") }
        (op == "||") ifTrue { self rightSide(n, t, false) }
        (op == "??") ifTrue { self rightSide(n, t, true) }
        indent = indent - 1
        self line("}")
        (op == "??") ifTrue { self pushOwnedTemp(t) }
        t
    }

    rightSide(n, t, coalesce) {
        mark = ownedTemps size
        right = self expr(n right)
        coalesce ifTrue {
            self line(t + " = " + right + "; clay_retain_val(" + t + ");")
        } ifFalse {
            self line(t + " = CLAY_BOOL(CLAY_IS_TRUTHY(" + right + "));")
        }
        self tempCleanupFrom(mark, nil)
    }

    intOps = #{
        "+": "clay_int(clay_to_int(@1) + clay_to_int(@2))",
        "-": "clay_int(clay_to_int(@1) - clay_to_int(@2))",
        "*": "clay_int(clay_int_mul(clay_to_int(@1), clay_to_int(@2)))",
        "==": "CLAY_BOOL(clay_to_int(@1) == clay_to_int(@2))",
        "!=": "CLAY_BOOL(clay_to_int(@1) != clay_to_int(@2))",
        "<": "CLAY_BOOL(clay_to_int(@1) < clay_to_int(@2))",
        ">": "CLAY_BOOL(clay_to_int(@1) > clay_to_int(@2))",
        "<=": "CLAY_BOOL(clay_to_int(@1) <= clay_to_int(@2))",
        ">=": "CLAY_BOOL(clay_to_int(@1) >= clay_to_int(@2))"
    }

    floatOps = #{
        "+": "clay_float_tag(clay_to_float(@1) + clay_to_float(@2))",
        "-": "clay_float_tag(clay_to_float(@1) - clay_to_float(@2))",
        "*": "clay_float_tag(clay_to_float(@1) * clay_to_float(@2))",
        "/": "clay_float_tag(clay_to_float(@1) / clay_to_float(@2))",
        "==": "CLAY_BOOL(clay_to_float(@1) == clay_to_float(@2))",
        "!=": "CLAY_BOOL(clay_to_float(@1) != clay_to_float(@2))",
        "<": "CLAY_BOOL(clay_to_float(@1) < clay_to_float(@2))",
        ">": "CLAY_BOOL(clay_to_float(@1) > clay_to_float(@2))",
        "<=": "CLAY_BOOL(clay_to_float(@1) <= clay_to_float(@2))",
        ">=": "CLAY_BOOL(clay_to_float(@1) >= clay_to_float(@2))"
    }

    fill(template, l, r) { (template replace("@1", l)) replace("@2", r) }

    binary(n) {
        op = n name
        (op == "&&" || op == "||" || op == "??") ifTrue { return self shortCircuit(n, op) }
        (op == "..") ifTrue {
            left = self expr(n left)
            (left == nil) ifTrue { return nil }
            right = self expr(n right)
            (right == nil) ifTrue { return nil }
            t = self tempName
            self emitLine(n)
            self line("ClayValue " + t + " = CLAY_VAL(clay_range_new(clay_to_int(" + left + "), clay_to_int(" +
                      right + "), 1));")
            self pushOwnedTemp(t)
            return t
        }
        left = self expr(n left)
        right = self expr(n right)
        (left == nil || right == nil) ifTrue { return nil }
        t = self tempName
        dispatch = t + " = clay_send_owned(" + left + ", \"" + op + "\", 1, (ClayValue[]){" + right + "});"
        self emitLine(n)
        self line("ClayValue " + t + ";")
        self line("if (CLAY_IS_INT(" + left + ") && CLAY_IS_INT(" + right + ")) {")
        indent = indent + 1
        iop = intOps get(op)
        (iop != nil) ifTrue {
            self line(t + " = " + (self fill(iop, left, right)) + ";")
        } ifFalse {
            (op == "/" || op == "%") ifTrue {
                what = (op == "/") ifTrue { "division" } ifFalse { "modulo" }
                self line("if (clay_to_int(" + right + ") == 0) clay_raise(CLAY_VAL(clay_error_new(\"" + what +
                          " by zero\", \"DivisionByZero\")));")
                self line(t + " = clay_int(clay_to_int(" + left + ") " + op + " clay_to_int(" + right + "));")
            } ifFalse {
                self line(dispatch)
            }
        }
        indent = indent - 1
        self line("} else if ((CLAY_IS_TAGGED_FLOAT(" + left + ") || CLAY_IS_INT(" + left + ")) && " +
                  "(CLAY_IS_TAGGED_FLOAT(" + right + ") || CLAY_IS_INT(" + right + "))) {")
        indent = indent + 1
        fop = floatOps get(op)
        (fop != nil) ifTrue {
            self line(t + " = " + (self fill(fop, left, right)) + ";")
        } ifFalse {
            self line(dispatch)
        }
        indent = indent - 1
        self line("} else {")
        indent = indent + 1
        self line(dispatch)
        indent = indent - 1
        self line("}")
        self pushOwnedTemp(t)
        t
    }

    block(n) {
        owner = nextLoopOwner
        nextLoopOwner = false
        fname = n fnName
        (fname == nil) ifTrue {
            Console print("codegen: block has no pre-assigned name\n")
            return nil
        }
        params = n params map { |p| p name }
        caps = []
        n body each { |s| self scan(s, params, caps) }
        md = FnDef make(fname, nil, n, caps, methodCtx)
        md loopOwner = owner
        collected push(md)
        (inMethod && knownMembers != nil) ifTrue {
            md cloneSlots = knownSlots
            md cloneMembers = knownMembers
        }

        t = self tempName
        (caps size > 0) ifTrue {
            caps each { |nm| self boxLocal(nm) }
            env = caps map { |nm| "(ClayValue)(uintptr_t)" + (self safe(nm)) + "_cell" }
            self line("ClayValue " + t + "_env[] = {" + (env join(", ")) + "};")
            self line("ClayValue " + t + " = CLAY_VAL(clay_block_new_cells(" + fname + ", " + t + "_env, " +
                      caps size toString + "));")
        } ifFalse {
            self line("ClayValue " + t + " = CLAY_VAL(clay_block_new(" + fname + ", NULL, 0));")
        }
        self pushOwnedTemp(t)
        t
    }

    tryCatch(n) {
        // the try's own line: calling the try block records it in the trace
        self emitLine(n)
        t = self tempName
        tryTmp = self tempName
        errTmp = self tempName
        self line("ClayValue " + t + ";")
        tryBlock = self expr(n tryBlock)
        catchBlock = (n catchBlock == nil) ifTrue { nil } ifFalse { self expr(n catchBlock) }
        finallyBlock = (n finallyBlock == nil) ifTrue { nil } ifFalse { self expr(n finallyBlock) }
        self line("ClayTryFrame _try_" + t + ";")
        self line("if (clay_try_push(&_try_" + t + ") == 0) {")
        indent = indent + 1
        self line("ClayValue " + tryTmp + " = clay_send_val(" + (tryBlock ?? "(null)") + ", \"value\", 0, NULL);")
        self line("clay_try_pop();")
        self line(t + " = " + tryTmp + ";")
        indent = indent - 1
        self line("} else {")
        indent = indent + 1
        self line("ClayValue " + errTmp + " = clay_error_stack.current_error; /* owned */")
        // released by an unwind if the catch or finally block raises
        self line("clay_uw_temp(&" + errTmp + ");")
        fin = (finallyBlock == nil) ifTrue { "" } ifFalse {
            " clay_release_val(clay_send_val(" + finallyBlock + ", \"value\", 0, NULL));"
        }
        self line("if (clay_is_control_signal(" + errTmp + ")) {" + fin + " clay_uw_drop(1); clay_raise(" + errTmp + "); }")
        (catchBlock == nil) ifTrue {
            // no catch: the error isn't handled — run finally, then re-raise
            (finallyBlock != nil) ifTrue {
                self line("clay_release_val(clay_send_val(" + finallyBlock + ", \"value\", 0, NULL));")
            } ifFalse {
                self line(t + " = CLAY_NIL;")
            }
            self line("clay_uw_drop(1);")
            self line("clay_raise(" + errTmp + ");")
        } ifFalse {
            (finallyBlock != nil) ifTrue {
                // finally must also run if the catch block raises
                self line("ClayTryFrame _catch_" + t + ";")
                self line("if (clay_try_push(&_catch_" + t + ") == 0) {")
                indent = indent + 1
                self line(t + " = clay_send_val(" + catchBlock + ", \"value\", 1, (ClayValue[]){ " + errTmp + " });")
                self line("clay_try_pop();")
                indent = indent - 1
                self line("} else {")
                indent = indent + 1
                self line("ClayValue " + t + "_raised = clay_error_stack.current_error;")
                self line("clay_uw_drop(1);")
                self line("clay_release_val(" + errTmp + ");")
                self line("clay_uw_temp(&" + t + "_raised);")
                self line("clay_release_val(clay_send_val(" + finallyBlock + ", \"value\", 0, NULL));")
                self line("clay_uw_drop(1);")
                self line("clay_raise(" + t + "_raised);")
                indent = indent - 1
                self line("}")
                self line("clay_uw_drop(1);")
                self line("clay_release_val(" + errTmp + ");")
            } ifFalse {
                self line(t + " = clay_send_val(" + catchBlock + ", \"value\", 1, (ClayValue[]){ " + errTmp + " });")
                self line("clay_uw_drop(1);")
                self line("clay_release_val(" + errTmp + ");")
            }
        }
        indent = indent - 1
        self line("}")
        // finally: the result is released if it raises
        (finallyBlock != nil) ifTrue {
            self line("clay_uw_temp(&" + t + ");")
            self line("clay_release_val(clay_send_val(" + finallyBlock + ", \"value\", 0, NULL));")
            self line("clay_uw_drop(1);")
        }
        self pushOwnedTemp(t)
        t
    }

    raiseExpr(n) {
        v = self expr(n expr)
        t = self tempName
        moved = self isOwnedTemp(v)
        self retains(v, moved ifTrue { 0 } ifFalse { 1 })
        self line("ClayValue " + t + " = " + (v ?? "(null)") + ";")
        // the temp's reference is the error's now: not the unwinder's to release
        moved ifTrue { self line(v + " = CLAY_NIL;") }
        self line("if (CLAY_IS_PTR(" + t + ") && !CLAY_IS_NIL(" + t + ") && CLAY_OBJ(" + t + ")->type == CLAY_TYPE_STRING) {")
        indent = indent + 1
        self line("ClayValue " + t + "_s = " + t + ";")
        self line(t + " = CLAY_VAL(clay_error_new(clay_string_data(CLAY_OBJ(" + t + "_s)), \"RuntimeError\"));")
        self line("clay_release_val(" + t + "_s);")
        indent = indent - 1
        self line("}")
        self line("clay_raise(" + t + ");")
        t
    }

    // inline clone expression (e.g. Object clone { } inside a method)
    cloneExpr(n) {
        proto = self expr(n recv)
        (proto == nil) ifTrue { return nil }
        t = self tempName
        self line("ClayValue " + t + " = CLAY_VAL(clay_clone(CLAY_OBJ(" + proto + ")));")
        n items each { |m|
            (m kind == "SlotDef") ifTrue {
                v = self expr(m value)
                (v != nil) ifTrue { self line("clay_set_slot(CLAY_OBJ(" + t + "), \"" + m name + "\", " + v + ");") }
            }
            (m kind == "MethodDef" && m fnName != nil) ifTrue {
                collected push(FnDef make(m fnName, nil, m, [], true))
                self line("clay_set_method(CLAY_OBJ(" + t + "), \"" + m name + "\", " + m fnName + ");")
            }
        }
        self pushOwnedTemp(t)
        t
    }

    // --- statements ---

    // locals created by top-level bare assignments, with implicit-slot flags
    slotFallbackDecls(body) {
        body each { |s|
            (s != nil && s kind == "Assign") ifTrue {
                nm = s name
                ((self isFnLocal(nm)) || (self isKnownSlot(nm)) || (self isBuiltinGlobal(nm))) ifFalse {
                    w = self flagName(nm)
                    out push("    ClayValue " + (self safe(nm)) + " = CLAY_NIL;\n")
                    out push("    ClayValue " + w + " = clay_has_slot(" + (self methodSelfExpr) + ", \"" + nm +
                             "\") ? CLAY_TRUE : CLAY_FALSE;\n")
                    locals push(nm)
                    locals push(w)
                    self trackVar(nm)
                }
            }
        }
    }

    // at entry to a top-level block: an assignment to a name that is only
    // another file's top-level variable makes a local, hiding the static
    shadowDecls(body) {
        body each { |s|
            (s != nil && s kind == "Assign") ifTrue {
                nm = s name
                ((self isToplevelVar(nm)) && (self isBuiltinGlobal(nm)) == false &&
                 (self toplevelInFile(nm, s file)) == false) ifTrue {
                    out push("    ClayValue " + (self safe(nm)) + " = CLAY_NIL;\n")
                    locals push(nm)
                    self trackVar(nm)
                }
            }
        }
    }

    varStore(nm, v, extra) {
        self retains(v, extra)
        (self isBoxed(nm)) ifTrue {
            s = self safe(nm)
            self line("clay_release_val(" + s + "_cell->value); " + s + "_cell->value = " + v + ";")
        } ifFalse {
            s = self safe(nm)
            self line("clay_release_val(" + s + "); " + s + " = " + v + ";")
        }
    }

    flaggedWrite(nm, v, own) {
        self line("if (CLAY_IS_TRUTHY(" + (self flagExpr(nm)) + ")) {")
        indent = indent + 1
        self retains(v, 1 - own)
        self line("clay_set_slot(" + (self methodSelfExpr) + ", \"" + nm + "\", " + v + ");")
        indent = indent - 1
        self line("} else {")
        indent = indent + 1
        self varStore(nm, v, 2 - own)
        indent = indent - 1
        self line("}")
    }

    own(v) { (self isOwnedTemp(v)) ifTrue { 1 } ifFalse { 0 } }

    fnAssign(s, isMethod) {
        nm = s name
        self emitLine(s)
        v = self expr(s value)
        (v == nil) ifTrue { return nil }
        o = self own(v)
        ((self hasSlotFlag(nm)) && (self isKnownSlot(nm)) == false) ifTrue {
            self flaggedWrite(nm, v, o)
        } ifFalse {
            // a known slot beats a top-level variable; a parameter or local wins
            ((self isKnownSlot(nm)) && (isMethod == false || (self isFnLocal(nm)) == false)) ifTrue {
                self retains(v, 1 - o)
                self line("clay_set_slot(" + (self methodSelfExpr) + ", \"" + nm + "\", " + v + ");")
            } ifFalse {
                isVar = (self isBoxed(nm)) ||
                        (isMethod ifTrue { self isMethodLocal(nm) } ifFalse { self isFnLocal(nm) })
                isVar ifTrue {
                    self varStore(nm, v, 2 - o)
                } ifFalse {
                    self retains(v, 2 - o)
                    self line("ClayValue " + (self safe(nm)) + " = " + v + ";")
                    locals push(nm)
                    self trackVar(nm)
                }
            }
        }
        self rvSet(v)
        self tempCleanup(v)
    }

    fnExprStmt(s) {
        self emitLine(s)
        v = self expr(s)
        (v == nil) ifTrue { return nil }
        self retains(v, 1 - (self own(v)))
        self rvSet(v)
        self tempCleanup(v)
    }

    paramDecl(pname, i, defaultExpr) {
        c = self safe(pname)
        is = i toString
        (defaultExpr == nil) ifTrue {
            out push("    ClayValue " + c + " = (argc > " + is + ") ? argv[" + is + "] : CLAY_NIL;\n")
            out push("    clay_retain_val(" + c + ");\n")
        } ifFalse {
            out push("    ClayValue " + c + " = CLAY_NIL;\n")
            out push("    if (argc > " + is + ") { " + c + " = argv[" + is + "]; clay_retain_val(" + c + "); } else {\n")
            saved = indent
            indent = 2
            mark = ownedTemps size
            d = self expr(defaultExpr)
            (d != nil) ifTrue {
                self retains(d, 1 - (self own(d)))
                self line(c + " = " + d + ";")
                self tempCleanupFrom(mark, d)
            }
            indent = saved
            out push("    }\n")
        }
        locals push(pname)
        self trackVar(pname)
    }

    stmt(n) {
        (n == nil) ifTrue { return nil }
        k = n kind
        (k == "Assign") ifTrue {
            self emitLine(n)
            v = self expr(n value)
            (v == nil) ifTrue { return nil }
            self varStore(n name, v, 1 - (self own(v)))
            (n value != nil && n value kind == "Send" && n value name == "clone") ifTrue {
                (self isBoxed(n name)) ifTrue {
                    self line("clay_set_slot_take(CLAY_OBJ(" + (self safe(n name)) + "_cell->value), \"_name\", CLAY_VAL(clay_string_new(\"" + n name + "\")));")
                } ifFalse {
                    self line("clay_set_slot_take(CLAY_OBJ(" + (self safe(n name)) + "), \"_name\", CLAY_VAL(clay_string_new(\"" + n name + "\")));")
                }
            }
            self tempCleanup(v)
            return nil
        }
        (k == "Return") ifTrue {
            self emitLine(n)
            (fnIsBlock && (self isBoxed("__ret_id"))) ifTrue {
                v = (n expr == nil) ifTrue { nil } ifFalse { self expr(n expr) }
                (v != nil) ifTrue { self retains(v, 1 - (self own(v))) }
                self line("{ ClayValue __ret_v = " + (v ?? "CLAY_NIL") + ";")
                indent = indent + 1
                self tempCleanup(v)
                self inlineExitReleases
                self functionReleases
                self line("clay_release_val(__rv);")
                self line("clay_raise_return(__ret_v, __ret_id_cell->value); }")
                indent = indent - 1
                return nil
            }
            (inlineScope != nil && fnIsBlock) ifTrue {
                // in a top-level block `return` ends just the inlined block
                sc = inlineScope
                v = (n expr == nil) ifTrue { nil } ifFalse { self expr(n expr) }
                (v != nil && sc dest != nil) ifTrue {
                    self retains(v, 1 - (self own(v)))
                    self line(sc dest + " = " + v + ";")
                }
                self tempCleanup((sc dest != nil) ifTrue { v } ifFalse { nil })
                self line("goto " + sc label + ";")
                sc labelUsed = true
                return nil
            }
            (n expr != nil) ifTrue {
                v = self expr(n expr)
                (v != nil) ifTrue {
                    self retains(v, 1 - (self own(v)))
                    self rvSet(v)
                    self tempCleanup(v)
                }
            } ifFalse {
                // a bare `return` gives nil
                inFunction ifTrue { self rvSet("CLAY_NIL") }
            }
            inFunction ifTrue {
                self inlineExitReleases
                self functionExit
            } ifFalse { self line("return __rv;") }
            return nil
        }
        // in an inlined loop's body, break and continue jump
        ((k == "Break" || k == "Continue") && inlineLoop != nil) ifTrue {
            self emitLine(n)
            return self loopJump(inlineLoop, k == "Break")
        }
        // in a block passed to a message, break ends that call and continue
        // ends this run (nil)
        (k == "Break" && fnLoopOwner) ifTrue {
            self emitLine(n)
            self line("clay_raise_break((int)self->as.block.break_id);")
            return nil
        }
        (k == "Continue" && fnLoopOwner) ifTrue {
            self emitLine(n)
            self rvSet("CLAY_NIL")
            self inlineExitReleases
            self functionExit
            return nil
        }
        (k == "Break") ifTrue {
            self emitLine(n)
            self line("clay_raise(CLAY_VAL(clay_BreakSignal));")
            return nil
        }
        (k == "Continue") ifTrue {
            self emitLine(n)
            self line("clay_raise(CLAY_VAL(clay_ContinueSignal));")
            return nil
        }
        (k == "SlotAssign") ifTrue {
            self emitLine(n)
            recv = self expr(n recv)
            v = self expr(n value)
            (recv != nil && v != nil) ifTrue {
                self line("clay_set_slot(CLAY_OBJ(" + recv + "), \"" + n name + "\", " + v + ");")
                inFunction ifTrue {
                    self retains(v, 1)
                    self rvSet(v)
                }
            }
            self tempCleanup(nil)
            return nil
        }
        self expr(n)
        self tempCleanup(nil)
        out push("\n")
    }

    // top-level `Name = Proto clone { ... }`
    topClone(n, varName) {
        proto = self expr(n recv)
        (proto == nil) ifTrue { return nil }
        // the variable's C name (_Foo is reserved in C: _cv__Foo)
        cv = CNames safe(varName)
        self emitLine(n)
        self line("/* " + varName + " = ... clone({ ... }) */")
        self line(cv + " = CLAY_VAL(clay_clone(CLAY_OBJ(" + proto + ")));")
        slotNames = []
        n items each { |m| (m kind == "SlotDef") ifTrue { slotNames push(m name) } }
        memberNames = slotNames slice(0, slotNames size)
        n items each { |m| (m kind == "MethodDef") ifTrue { memberNames push(m name) } }
        n items each { |m|
            (m kind == "SlotDef") ifTrue {
                v = self expr(m value)
                (v != nil) ifTrue {
                    self line("clay_set_slot(CLAY_OBJ(" + cv + "), \"" + m name + "\", " + v + ");")
                }
            }
            (m kind == "MethodDef") ifTrue {
                (m fnName == nil) ifTrue {
                    Console print("codegen: method has no pre-assigned name\n")
                } ifFalse {
                    md = FnDef make(m fnName, cv, m, [], true)
                    md cloneSlots = (slotNames size > 0) ifTrue { slotNames } ifFalse { nil }
                    md cloneMembers = memberNames
                    collected push(md)
                    self line("clay_set_method(CLAY_OBJ(" + cv + "), \"" + m name + "\", " + m fnName + ");")
                }
            }
        }
        self line("clay_set_slot_take(CLAY_OBJ(" + cv + "), \"_name\", CLAY_VAL(clay_string_new(\"" + varName + "\")));")
        self tempCleanup(nil)
    }

    // a statement of a method or block body, or of an inlined body (as a
    // block's); without wantValue an inlined ifTrue/ifFalse gives no value
    bodyStmt(s, isMethod, wantValue) {
        k = s kind
        (k == "Assign") ifTrue { return self fnAssign(s, isMethod) }
        (k == "SlotAssign" || k == "Return" || k == "Break" || k == "Continue") ifTrue { return self stmt(s) }
        (wantValue == false && (self isInlineIf(s))) ifTrue {
            self emitLine(s)
            self inlineIf(s, false)
            return self tempCleanup(nil)
        }
        (wantValue == false && (self isInlineWhile(s))) ifTrue {
            self emitLine(s)
            self inlineWhile(s, false)
            return self tempCleanup(nil)
        }
        self fnExprStmt(s)
    }

    // --- inlined ifTrue/ifFalse (codegen.c emit_inline_if) ---

    isInlineIf(n) {
        (n == nil || n kind != "Send" || n isSuper || n isCall) ifTrue { return false }
        (n items size != 1 || (n name != "ifTrue" && n name != "ifFalse")) ifTrue { return false }
        b = n items at(0)
        b != nil && b kind == "Block" && b params size == 0
    }

    // --- inlined whileTrue/whileFalse (codegen.c emit_inline_while) ---

    // x whileTrue { ... } / whileFalse with a block literal argument
    isLoopSend(n) {
        (n == nil || n kind != "Send" || n isSuper || n isCall) ifTrue { return false }
        (n items size != 1 || (n name != "whileTrue" && n name != "whileFalse")) ifTrue { return false }
        b = n items at(0)
        b != nil && b kind == "Block"
    }

    // is there a break or continue in n whose signal could leave it?
    loopCtlEscapes(n) {
        (n == nil) ifTrue { return false }
        k = n kind
        (k == "Break" || k == "Continue") ifTrue { return true }
        (k == "Block") ifTrue { return self loopCtlEscapesList(n body) }
        (k == "Send") ifTrue {
            // a block literal passed to a message keeps its own: the send
            // ends on its break, its run ends on its continue
            (self loopCtlEscapes(n recv)) ifTrue { return true }
            cond = self isCondMessage(n name)
            hit = n items find { |a| ((a != nil && a kind == "Block" && cond == false) == false) &&
                                     (self loopCtlEscapes(a)) }
            return hit != nil
        }
        (k == "Binary") ifTrue { return (self loopCtlEscapes(n left)) || (self loopCtlEscapes(n right)) }
        (k == "Assign") ifTrue { return self loopCtlEscapes(n value) }
        (k == "Return") ifTrue { return self loopCtlEscapes(n expr) }
        (k == "Array") ifTrue { return self loopCtlEscapesList(n items) }
        (k == "DictLit") ifTrue { return self loopCtlEscapesList(n vals) }
        (k == "TryCatch") ifTrue {
            return (self loopCtlEscapes(n tryBlock)) || (self loopCtlEscapes(n catchBlock)) ||
                   (self loopCtlEscapes(n finallyBlock))
        }
        (k == "Raise") ifTrue { return self loopCtlEscapes(n expr) }
        (k == "SlotAssign") ifTrue { return (self loopCtlEscapes(n recv)) || (self loopCtlEscapes(n value)) }
        (k == "Destructure") ifTrue { return self loopCtlEscapes(n value) }
        (k == "Clone") ifTrue {
            (self loopCtlEscapes(n recv)) ifTrue { return true }
            return (n items find { |m| m kind == "SlotDef" && (self loopCtlEscapes(m value)) }) != nil
        }
        false
    }

    loopCtlEscapesList(list) {
        (list == nil) ifTrue { return false }
        (list find { |n| self loopCtlEscapes(n) }) != nil
    }

    // can every break/continue in these loop-body statements be a jump?
    loopJumpsList(list) { (list find { |n| (self loopJumps(n)) == false }) == nil }

    loopJumps(n) {
        (n == nil || n kind == "Break" || n kind == "Continue") ifTrue { return true }
        (self isInlineIf(n)) ifTrue {
            r = n recv
            (self isInlineIf(r)) ifTrue {
                ((self loopCtlEscapes(r recv)) || (self loopJumpsList((r items at(0)) body)) == false) ifTrue {
                    return false
                }
            } ifFalse {
                (self loopCtlEscapes(r)) ifTrue { return false }
            }
            return self loopJumpsList((n items at(0)) body)
        }
        (self loopCtlEscapes(n)) == false
    }

    // `{ c } whileTrue { ... }` / whileFalse with parameterless block
    // literals whose breaks and continues can all be jumps (ast_is_inline_while)
    isInlineWhile(n) {
        (self isLoopSend(n)) ifFalse { return false }
        c = n recv
        b = n items at(0)
        c != nil && c kind == "Block" && c params size == 0 && b params size == 0 &&
            (self loopJumpsList(b body))
    }

    // --- break / continue in a block passed to a message (ast.c owned_ctl) ---
    // Each belongs to the innermost loop around it: an inlined loop (a jump)
    // or a block literal passed to a message other than ifTrue/ifFalse and a
    // whileTrue/whileFalse body (isLoopArg). A break ends that call (nil): such
    // a send (sendCatchesBreak) tags its blocks and catches it. A continue ends
    // that run of the block (nil). Raised in a block run inside it (try,
    // `{ ... } value`), either is caught by the block (blockSubRaises).

    isCondMessage(m) { m == "ifTrue" || m == "ifFalse" }

    isLoopArg(send, arg) {
        arg != nil && arg kind == "Block" && (self isCondMessage(send name)) == false &&
            (self isLoopSend(send)) == false
    }

    sendCatchesBreak(n) {
        (n == nil || n kind != "Send") ifTrue { return false }
        (n items find { |a| (self isLoopArg(n, a)) && (self ownedCtlList(a body, "Break", false, false)) }) != nil
    }

    blockSubRaises(b, kind) {
        b != nil && b kind == "Block" && (self ownedCtlList(b body, kind, true, false))
    }

    ownedCtlList(list, kind, subOnly, inSub) {
        (list == nil) ifTrue { return false }
        (list find { |n| self ownedCtl(n, kind, subOnly, inSub) }) != nil
    }

    // a block run where it is written: its statements, in a sub-block
    ownedCtlSub(b, kind, subOnly) {
        (b == nil) ifTrue { return false }
        (b kind != "Block") ifTrue { return self ownedCtl(b, kind, subOnly, true) }
        self ownedCtlList(b body, kind, subOnly, true)
    }

    ownedCtl(n, kind, subOnly, inSub) {
        (n == nil) ifTrue { return false }
        k = n kind
        (k == "Break" || k == "Continue") ifTrue { return k == kind && (inSub || (subOnly == false)) }
        (k == "Send") ifTrue {
            r = n recv
            (self isInlineIf(n)) ifTrue {
                return (self ownedCtl(r, kind, subOnly, inSub)) ||
                       (self ownedCtlList((n items at(0)) body, kind, subOnly, inSub))
            }
            // an inlined loop's body is its own
            (self isInlineWhile(n)) ifTrue { return self ownedCtlList(r body, kind, subOnly, inSub) }
            (r != nil && r kind == "Block") ifTrue {
                (self ownedCtlSub(r, kind, subOnly)) ifTrue { return true }
            } ifFalse {
                (self ownedCtl(r, kind, subOnly, inSub)) ifTrue { return true }
            }
            cond = self isCondMessage(n name)
            hit = n items find { |a|
                isBlock = a != nil && a kind == "Block"
                (isBlock && cond && (self ownedCtlSub(a, kind, subOnly))) ||
                    (isBlock == false && (self ownedCtl(a, kind, subOnly, inSub)))
            }
            return hit != nil
        }
        (k == "TryCatch") ifTrue {
            return (self ownedCtlSub(n tryBlock, kind, subOnly)) ||
                   (self ownedCtlSub(n catchBlock, kind, subOnly)) ||
                   (self ownedCtlSub(n finallyBlock, kind, subOnly))
        }
        (k == "Assign") ifTrue { return self ownedCtl(n value, kind, subOnly, inSub) }
        (k == "Binary") ifTrue {
            return (self ownedCtl(n left, kind, subOnly, inSub)) || (self ownedCtl(n right, kind, subOnly, inSub))
        }
        (k == "Return" || k == "Raise") ifTrue { return self ownedCtl(n expr, kind, subOnly, inSub) }
        (k == "Array") ifTrue { return self ownedCtlList(n items, kind, subOnly, inSub) }
        (k == "DictLit") ifTrue { return self ownedCtlList(n vals, kind, subOnly, inSub) }
        (k == "SlotAssign") ifTrue {
            return (self ownedCtl(n recv, kind, subOnly, inSub)) || (self ownedCtl(n value, kind, subOnly, inSub))
        }
        (k == "Destructure") ifTrue { return self ownedCtl(n value, kind, subOnly, inSub) }
        (k == "Clone") ifTrue { return self ownedCtl(n recv, kind, subOnly, inSub) }
        false
    }

    // break / continue of the inlined loop being emitted: release what the
    // inlined bodies inside it and their statements own, then jump
    loopJump(lp, isBreak) {
        sc = inlineScope
        { sc != nil && sc != lp scope } whileTrue {
            sc vars each { |v| self line("clay_release_val(" + (self safe(v)) + ");") }
            sc cells each { |c| self line("clay_cell_release(" + (self safe(c)) + "_cell);") }
            sc = sc outer
        }
        i = lp tempMark
        { i < tempBase } whileTrue {
            self line("clay_release_val(" + (ownedTemps at(i)) + ");")
            i = i + 1
        }
        id = lp id toString
        self line("clay_uw_reset(__lp_" + id + "); goto __" + (isBreak ifTrue { "brk" } ifFalse { "cont" }) +
                  "_" + id + ";")
        isBreak ifFalse { lp contUsed = true }
    }

    inlineWhile(n, wantValue) {
        cond = n recv body
        body = (n items at(0)) body
        // cells for what blocks inside capture outlive the loop
        self preboxCaptures(n)
        t = nil
        wantValue ifTrue {
            t = self tempName
            self line("ClayValue " + t + " = CLAY_NIL;")
            self pushOwnedTemp(t)
        }
        lp = InlineLoop clone
        lp scope = inlineScope
        lp tempMark = ownedTemps size
        lp id = tempCounter
        tempCounter = tempCounter + 1
        id = lp id toString
        c = "__c_" + id
        b = "__b_" + id

        self line("for (;;) {")
        indent = indent + 1
        self line("int __lp_" + id + " = clay_uw_mark();")
        self line("ClayValue " + c + " = CLAY_NIL; clay_uw_temp(&" + c + ");")
        outer = inlineLoop
        // a break in the condition is raised
        inlineLoop = nil
        self inlineBody(cond, c)
        self line("if (" + ((n name == "whileTrue") ifTrue { "!" } ifFalse { "" }) + "CLAY_IS_TRUTHY(" + c +
                  ")) { clay_uw_reset(__lp_" + id + "); clay_release_val(" + c + "); goto __brk_" + id + "; }")
        self line("clay_uw_reset(__lp_" + id + "); clay_release_val(" + c + ");")
        wantValue ifTrue { self line("ClayValue " + b + " = CLAY_NIL; clay_uw_temp(&" + b + ");") }
        inlineLoop = lp
        self inlineBody(body, wantValue ifTrue { b } ifFalse { nil })
        inlineLoop = outer
        wantValue ifTrue {
            self line("clay_uw_reset(__lp_" + id + "); clay_release_val(" + t + "); " + t + " = " + b + ";")
        }
        lp contUsed ifTrue { self line("__cont_" + id + ": ;") }
        indent = indent - 1
        self line("}")
        self line("__brk_" + id + ": ;")
        t
    }

    isCompareOp(n) {
        (n == nil || n kind != "Binary") ifTrue { return false }
        op = n name
        op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">="
    }

    // what the inlined bodies around a `return` leaving the function own:
    // their variables and cells, and the enclosing statements' temps
    inlineExitReleases() {
        sc = inlineScope
        { sc != nil } whileTrue {
            sc vars each { |v| self line("clay_release_val(" + (self safe(v)) + ");") }
            sc cells each { |c| self line("clay_cell_release(" + (self safe(c)) + "_cell);") }
            sc = sc outer
        }
        i = 0
        { i < tempBase } whileTrue {
            self line("clay_release_val(" + (ownedTemps at(i)) + ");")
            i = i + 1
        }
    }

    // would `name = v` in a block function make a new local of the block?
    inlineNewLocal(s) {
        nm = s name
        ((self hasSlotFlag(nm)) || (self isKnownSlot(nm)) || (self isBoxed(nm))) ifTrue { return false }
        (self isFnLocal(nm)) ifFalse { return true }
        methodCtx == false && (self isToplevelVar(nm)) && (self isBuiltinGlobal(nm)) == false &&
            (self toplevelInFile(nm, s file)) == false
    }

    inlineBody(body, dest) {
        sc = InlineScope clone
        sc outer = inlineScope
        sc dest = dest
        sc vars = []
        sc cells = []
        sc label = "__inl_end_" + tempCounter toString
        tempCounter = tempCounter + 1
        savedBase = tempBase
        savedLocals = locals size
        savedBoxed = boxed size
        mark = "__uw_inl_" + tempCounter toString   // the unwind list before them
        tempCounter = tempCounter + 1
        marked = false

        // the block's variables, nil (and their flags set) each time it runs
        body each { |s|
            (s != nil && s kind == "Assign" && (self inlineNewLocal(s)) &&
             ((locals slice(savedLocals, locals size)) contains(s name)) == false) ifTrue {
                nm = s name
                marked ifFalse {
                    self line("int " + mark + " = clay_uw_mark();")
                    marked = true
                }
                c = self safe(nm)
                self line("ClayValue " + c + " = CLAY_NIL; clay_uw_var(&" + c + ");")
                locals push(nm)
                sc vars push(nm)
                ((self isLocal("_method_self")) && (self isBuiltinGlobal(nm)) == false) ifTrue {
                    f = self flagName(nm)
                    self line("ClayValue " + f + " = clay_has_slot(" + (self methodSelfExpr) + ", \"" + nm +
                              "\") ? CLAY_TRUE : CLAY_FALSE;")
                    locals push(f)
                }
            }
        }
        // the ones blocks made here capture: a fresh cell each run
        boxedFrom = boxed size
        body each { |s| self preboxCaptures(s) }
        (marked == false && boxed size > boxedFrom) ifTrue {
            self line("int " + mark + " = clay_uw_mark();")
            marked = true
        }
        (boxed slice(boxedFrom, boxed size)) each { |b|
            self line("clay_uw_cell(&" + (self safe(b)) + "_cell);")
            sc cells push(b)
        }

        inlineScope = sc
        tempBase = ownedTemps size
        i = 0
        body each { |s|
            self bodyStmt(s, false, dest != nil && i == body size - 1)
            i = i + 1
        }
        last = (body size > 0) ifTrue { body at(body size - 1) } ifFalse { nil }
        (dest != nil && last != nil && last kind != "Return" && last kind != "Break" &&
         last kind != "Continue" && last kind != "Destructure") ifTrue {
            self line(dest + " = __rv; clay_retain_val(" + dest + ");")
        }
        sc labelUsed ifTrue { self line(sc label + ": ;") }
        // (clay_uw_drop only drops temporaries)
        marked ifTrue { self line("clay_uw_reset(" + mark + ");") }
        sc vars each { |v| self line("clay_release_val(" + (self safe(v)) + ");") }
        sc cells each { |c| self line("clay_cell_release(" + (self safe(c)) + "_cell);") }
        tempBase = savedBase
        inlineScope = sc outer
        locals = locals slice(0, savedLocals)
        boxed = boxed slice(0, savedBoxed)
    }

    // open `if (<cond sel matches>) {`: a comparison directly, anything else
    // through clay_cond_test; the receiver's temp (nil for a comparison)
    ifOpen(send, cond, wantTrue, chain) {
        r = nil
        (self isCompareOp(cond)) ifTrue {
            b = self binary(cond)
            self line("if (" + (wantTrue ifTrue { "" } ifFalse { "!" }) + "CLAY_IS_TRUTHY(" + b + ")) {")
        } ifFalse {
            r = self expr(cond)
            self emitLine(send)
            self line("if (clay_cond_test(" + r + ", " + (wantTrue ifTrue { "1" } ifFalse { "0" }) + ", " +
                      (chain ifTrue { "1" } ifFalse { "0" }) + ")) {")
        }
        indent = indent + 1
        r
    }

    ifElse() {
        indent = indent - 1
        self line("} else {")
        indent = indent + 1
    }

    ifClose() {
        indent = indent - 1
        self line("}")
    }

    inlineIf(n, wantValue) {
        cond = n recv
        body = (n items at(0)) body
        // cells for what blocks inside capture outlive the branches
        self preboxCaptures(n)
        t = nil
        wantValue ifTrue {
            t = self tempName
            self line("ClayValue " + t + " = CLAY_NIL;")
            self pushOwnedTemp(t)
        }
        (self isInlineIf(cond)) ifTrue {
            // c s1 { a } s2 { b }: a when s1 matches c, else b
            self ifOpen(cond, cond recv, cond name == "ifTrue", true)
            self inlineBody((cond items at(0)) body, t)
            self ifElse
            self inlineBody(body, t)
            self ifClose
            return t
        }
        r = self ifOpen(n, cond, n name == "ifTrue", false)
        self inlineBody(body, t)
        wantValue ifTrue {
            // a lone ifTrue/ifFalse gives a condition result; `true` stands
            // in for a comparison's receiver
            rv = r ?? "CLAY_TRUE"
            self line("{ ClayValue __v = " + t + "; " + t + " = clay_cond_ran(" + rv + ", __v); clay_release_val(__v); }")
            self ifElse
            self line(t + " = clay_cond_skipped(" + rv + ");")
        }
        self ifClose
        t
    }

    // --- function bodies ---

    methodBodies() {
        { collected size > 0 } whileTrue {
            batch = collected
            collected = []
            batch each { |d| self functionBody(d) }
        }
    }

    functionBody(d) {
        n = d node
        out push("\nstatic ClayValue " + d funcName + "(ClayObject *self, int argc, ClayValue *argv) {\n")
        out push("    (void)self; (void)argc; (void)argv;\n")

        savedInMethod = inMethod
        savedLocalCount = locals size
        savedBoxedCount = boxed size
        savedBase = methodLocalBase
        savedSuper = superProto
        savedKnown = knownSlots
        savedMembers = knownMembers
        savedCtx = methodCtx
        savedInFunction = inFunction
        methodLocalBase = locals size
        inMethod = true
        methodCtx = d inMethodCtx
        inFunction = true
        fnVars = []
        fnCells = []
        superProto = d objContext
        knownSlots = d cloneSlots
        knownMembers = d cloneMembers

        (n kind == "MethodDef") ifTrue {
            pc = n params size toString
            mname = (n name replace("\\", "\\\\")) replace("\"", "\\\"")
            out push("    CLAY_STACK_CHECK();\n")
            out push("    clay_trace_enter(CLAY_FRAME_METHOD);\n")
            out push("    int __uw = clay_uw_mark();\n")
            out push("    if (argc > " + pc + ") clay_raise_arity(\"" + mname + "\", " + pc + ", argc);\n")
            (self hasBlockReturn(n body)) ifTrue {
                out push("    ClayValue __ret_id = clay_return_id_next();\n" +
                         "    ClayTryFrame __ret_tf;\n" +
                         "    if (clay_try_push(&__ret_tf) != 0) {\n" +
                         "        ClayValue __ret_v, __ret_err = clay_error_stack.current_error;\n" +
                         "        if (clay_return_matches(__ret_err, __ret_id, &__ret_v))\n" +
                         "            return clay_return_value(__ret_v, CLAY_VAL(self), argc, argv);\n" +
                         "        clay_raise(__ret_err);\n" +
                         "    }\n" +
                         "    __ret_tf.return_id = __ret_id;\n")
                locals push("__ret_id")
                fnHasRetFrame = true
            }
            locals push("_method_self")
            i = 0
            n params each { |p|
                (p kind == "Assign") ifTrue {
                    self paramDecl(p name, i, p value)
                } ifFalse {
                    self paramDecl(p name, i, nil)
                }
                i = i + 1
            }
            out push("    ClayValue __rv = CLAY_NIL;\n")
            out push("    clay_uw_var(&__rv);\n")
            self slotFallbackDecls(n body)
            savedIndent = indent
            indent = 1
            i = 0
            n body each { |s|
                self bodyStmt(s, true, i == n body size - 1)
                i = i + 1
            }
            self functionExit
            indent = savedIndent
            fnHasRetFrame = false
        } ifFalse {
            savedRecv = useSlotRecv
            savedIsBlock = fnIsBlock
            savedLoopOwner = fnLoopOwner
            savedRetFrame = fnHasRetFrame
            fnIsBlock = true
            fnLoopOwner = d loopOwner
            fnHasRetFrame = false
            useSlotRecv = (d captures contains("_method_self")) == false
            out push("    CLAY_STACK_CHECK();\n")
            out push("    clay_trace_enter(CLAY_FRAME_BLOCK);\n")
            out push("    int __uw = clay_uw_mark();\n")
            // a block passed to a message: a continue raised in a block run
            // inside it ends this run with nil, a plain break there becomes
            // the one that ends its call (before any locals exist)
            fnLoopOwner ifTrue {
                subCont = self blockSubRaises(n, "Continue")
                subBrk = self blockSubRaises(n, "Break")
                (subCont || subBrk) ifTrue {
                    out push("    ClayTryFrame __sig_tf;\n")
                    out push("    if (clay_try_push(&__sig_tf) != 0) {\n")
                    out push("        ClayValue __sig = clay_error_stack.current_error;\n")
                    subCont ifTrue {
                        out push("        if (clay_take_signal(__sig, CLAY_SIGNAL_CONTINUE)) return CLAY_NIL;\n")
                    }
                    subBrk ifTrue {
                        out push("        if (clay_take_signal(__sig, CLAY_SIGNAL_BREAK)) " +
                                 "clay_raise_break((int)self->as.block.break_id);\n")
                    }
                    out push("        clay_raise(__sig);\n")
                    out push("    }\n")
                    fnHasRetFrame = true
                }
            }
            useSlotRecv ifTrue { out push("    ClayObject *__recv = clay_slot_method_self; (void)__recv;\n") }
            blockBoxed = boxed size
            i = 0
            d captures each { |c|
                out push("    ClayCell *" + (self safe(c)) + "_cell = (ClayCell *)(uintptr_t)self->as.block.env[" +
                         i toString + "];\n")
                locals push(c)
                boxed push(c)
                i = i + 1
            }
            i = 0
            n params each { |p|
                self paramDecl(p name, i, nil)
                i = i + 1
            }
            out push("    ClayValue __rv = CLAY_NIL;\n")
            out push("    clay_uw_var(&__rv);\n")
            (inMethod && (self isBoxed("_method_self"))) ifTrue { self slotFallbackDecls(n body) }
            methodCtx ifFalse { self shadowDecls(n body) }
            savedIndent = indent
            indent = 1
            i = 0
            n body each { |s|
                self bodyStmt(s, false, i == n body size - 1)
                i = i + 1
            }
            self functionExit
            indent = savedIndent
            useSlotRecv = savedRecv
            fnIsBlock = savedIsBlock
            fnLoopOwner = savedLoopOwner
            fnHasRetFrame = savedRetFrame
            boxed = boxed slice(0, blockBoxed)
        }

        fnVars = []
        fnCells = []
        inFunction = savedInFunction
        inMethod = savedInMethod
        methodCtx = savedCtx
        superProto = savedSuper
        methodLocalBase = savedBase
        knownSlots = savedKnown
        knownMembers = savedMembers
        locals = locals slice(0, savedLocalCount)
        boxed = boxed slice(0, savedBoxedCount)
        out push("}\n")
    }

    // --- the program ---

    generate(program) {
        self prewalk(program, nil)
        program items each { |s|
            ((s kind == "Assign") && (self isLocal(s name)) == false) ifTrue { locals push(s name) }
            (s kind == "Assign") ifTrue {
                files = toplevelFiles get(s name)
                (files == nil) ifTrue {
                    files = []
                    toplevelFiles set(s name, files)
                }
                files push(s file)
            }
        }
        toplevelCount = locals size
        sourceFiles = []
        program items each { |s|
            (s file != nil && (sourceFiles indexOf(s file)) < 0) ifTrue { sourceFiles push(s file) }
        }

        header = "/* Generated by Clay compiler */\n#include \"clay.h\"\n#include \"range.h\"\n\n"
        ((nativePlugins ?? []) size > 0) ifTrue {
            // native bricks: their C is linked in, registered from main()
            header = header + "#include \"clay_plugin.h\"\n"
            nativePlugins each { |p| header = header + "void " + p + "_plugin_init(const ClayPluginAPI *api);\n" }
            header = header + "\n"
        }
        (sourceFiles size > 1) ifTrue {
            header = header + "static const char *const clay_files[] = {\n"
            sourceFiles each { |f| header = header + "    \"" + (CNames pathBody(f)) + "\",\n" }
            header = header + "};\n\n"
        }

        // main's statements first (they collect the functions to emit)
        file = out
        out = []
        program items each { |s|
            (s kind == "Assign" && s value != nil && s value kind == "Clone") ifTrue {
                self topClone(s value, s name)
            } ifFalse {
                self stmt(s)
            }
        }
        mainBody = out
        out = file

        out push(header)
        (nameOrder reverse) each { |f| out push("static ClayValue " + f + "(ClayObject *self, int argc, ClayValue *argv);\n") }
        out push("\n")
        declared = #{}
        program items each { |s|
            (s kind == "Assign" && (declared has(s name)) == false) ifTrue {
                declared set(s name, true)
                out push("static ClayValue " + (self safe(s name)) + " = CLAY_NIL;\n")
            }
        }
        out push("\n")
        boxed = []

        self methodBodies

        out push("\nstatic int clay_program_main(int argc, char **argv) {\n")
        out push("    clay_bootstrap();\n")
        out push("    clay_set_args(argc - 1, argv + 1);\n")
        out push("    clay_source_file = \"" + (CNames pathBody(sourceFile)) + "\";\n")
        lib = Parser libDir
        ((sourceFiles find { |f| CNames isUnder(lib, f) }) != nil) ifTrue {
            // tracebacks show bundled-brick files relative to lib/
            out push("    clay_set_lib_dir(\"" + (CNames pathBody(lib)) + "\");\n")
        }
        (pluginExePath != nil && pluginExePath != "") ifTrue {
            out push("    clay_plugin_auto_load(\"" + (CNames pathBody(pluginExePath)) + "\");\n")
        }
        (nativePlugins ?? []) each { |p| out push("    clay_plugin_register_static(" + p + "_plugin_init);\n") }
        out push("\n")
        mainBody each { |c| out push(c) }
        out push("\n    clay_shutdown();\n")
        out push("    return 0;\n")
        out push("}\n")
        // the program runs on a thread with a big stack (CLAY_STACK_MB)
        out push("\nint main(int argc, char **argv) {\n")
        out push("    return clay_run_with_stack(clay_program_main, argc, argv);\n")
        out push("}\n")
        out join("")
    }
}

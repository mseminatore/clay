// more than 16 parameters (the VM binds 16), empty bodies, statements after return,
// destructuring
many = Object clone {
    f(a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18) { a1 + a18 }
    empty() { }
    early(x) {
        return x
        x + 1
    }
}
many empty println
(many early(3)) println
{ } value println
[a, b] = [1, 2]
(a + b) println

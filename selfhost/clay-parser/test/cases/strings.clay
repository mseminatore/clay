a = "tab\tnew\nret\rbs\\q\"end"
b = "hex \x41\x7a \x 9 \x+4 \x-1 bad \xZZ \x4G short \x4"
c = "nul\0gone"
d = "hexnul\x00gone"
e = "unknown \q \w"
f = "trailing \\"
g = "${1 + 2}"
h = "a ${b} c ${d e} f"
j = "nested ${ { |q| q } value(1) } and ${#{ k: 1 } get(kk)}"
k = """triple ${x}
line two"""
m = "${a}${b}"
n = "\x41${x}\n"
o = "caf\xc3\xa9"

// A clone body's `{` may start the next line (blank lines and comments too)
A = Object clone
{
    x = 1
    f(a)
    {
        a + x
    }
}

B = A clone

    // a comment before the body
{
    y = 2
}

C = A clone
c = C clone; d = 3
{ 4 } value

// ...but only a `{` alone on its line: one with more on the line starts the
// next statement (a block), so these stay two statements each
p = A clone
{ x < 3 } whileTrue { x = x + 1 }
q = A clone
{ n = n + 1 } value
r = A clone
{ |k| k * 2 } value(4)
